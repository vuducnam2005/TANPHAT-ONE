[options]
; Copy this file to odoo.conf and set credentials for your local PostgreSQL role.
db_host = localhost
db_port = 5433
db_user = odoo
db_password = REPLACE_WITH_LOCAL_PASSWORD
; On Windows PostgreSQL, template1 keeps LC_COLLATE and LC_CTYPE compatible.
db_template = template1

; start.bat runs from the project root, so these relative paths resolve there.
addons_path = odoo/odoo/addons,odoo/addons,custom_addons
http_port = 8069
http_interface = 127.0.0.1
admin_passwd = REPLACE_WITH_LOCAL_MASTER_PASSWORD
list_db = True
log_level = info
