<templates xml:space="preserve">
 <t t-name="tp_reporting.TableTools"><div class="tp_reporting_tools"><button t-if="this.props.controller.props.resModel === 'tp.report.document'" class="btn btn-secondary" t-att-disabled="this.state.busy" t-on-click="()=>this.exportXlsx()" title="Xuất toàn bộ báo cáo theo bộ lọc đã áp dụng">Xuất Excel</button><button t-if="this.props.controller.props.resModel === 'tp.report.document'" class="btn btn-light" t-on-click="()=>this.inbox()">Chờ tôi rà soát</button><button t-if="this.props.controller.props.resModel === 'tp.report.document'" class="btn btn-light" t-on-click="()=>this.obligations()">Nghĩa vụ / Lập báo cáo</button><label>Hiển thị <select aria-label="Số dòng mỗi trang" t-on-change="(ev)=>this.changeSize(ev)" t-att-disabled="this.state.busy || this.props.controller.editedRecord"><option t-foreach="this.sizes" t-as="n" t-key="n" t-att-value="n" t-att-selected="n === this.props.controller.model.root.limit" t-out="n"/></select> <t t-out="this.props.controller.model.root.isGrouped ? 'nhóm / trang' : 'dòng / trang'"/></label><span t-if="this.state.error" role="alert" t-out="this.state.error"/></div></t>
 <t t-name="tp_reporting.ListView" t-inherit="web.ListView" t-inherit-mode="primary">
  <xpath expr="//t[@t-set-slot='control-panel-navigation-additional']" position="inside"><ReportTableTools t-if="!this.hasSelectedRecords" controller="this"/></xpath>
  <xpath expr="//t[@t-set-slot='control-panel-actions']" position="inside"><TpTableFilterBar controller="this" blocked="!!this.editedRecord" onAdvanced="()=>this.advancedReportFilters()" onClearAll="()=>this.clearReportFilters()"/></xpath>
 </t>
</templates>
