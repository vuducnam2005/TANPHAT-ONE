<odoo>
    <record id="department_form" model="ir.ui.view">
        <field name="name">tp.hr.department.form</field><field name="model">hr.department</field>
        <field name="inherit_id" eval="False"/><field name="mode">primary</field><field name="priority">5</field>
        <field name="arch" type="xml">
            <form string="Phòng ban và đơn vị" class="o_tp_hr_catalog_form" js_class="tp_hr_catalog">
                <sheet>
                    <div class="oe_button_box" name="button_box"><button name="action_tp_employees" type="object" class="oe_stat_button" icon="group"><field name="tp_visible_employee_count" widget="statinfo" string="Nhân viên đang sử dụng"/></button></div>
                    <widget name="web_ribbon" title="Lưu trữ" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title"><span class="o_tp_hr_form_kind"><i class="oi" data-icon="account_tree" aria-hidden="true"/>Phòng ban và đơn vị</span><h1><field name="name" placeholder="Tên phòng ban / đơn vị"/></h1></div>
                    <group><group string="Tổ chức và quản lý"><field name="manager_id" string="Người quản lý" widget="many2one_avatar_employee" placeholder="Chưa khai báo" context="{'form_view_ref': 'tp_hr_workspace.employee_form'}"/><field name="parent_id" string="Phòng ban cấp trên" context="{'form_view_ref': 'tp_hr_workspace.department_form'}"/><field name="active" string="Đang sử dụng"/><field name="company_id" groups="base.group_multi_company"/></group><group string="Nhận diện"><field name="color" string="Màu phòng ban" widget="color_picker"/><p colspan="2" class="o_tp_hr_context_note">Màu nhận diện tổ chức khác với màu trạng thái tài khoản. Người quản lý chỉ lấy từ quan hệ đã khai báo.</p></group></group>
                    <notebook><page name="members" string="Nhân viên"><p class="o_tp_hr_context_note">Hồ sơ đang sử dụng trong phạm vi công ty và quyền được xem.</p><p class="o_tp_hr_context_note" invisible="member_ids">Chưa có nhân viên đang sử dụng hồ sơ trong phòng ban này.</p><field name="member_ids" widget="tp_kd_relation" invisible="not member_ids" readonly="1" domain="[('active', '=', True), ('company_id', 'in', allowed_company_ids)]" context="{'form_view_ref': 'tp_hr_workspace.employee_form', 'tp_hr_relation': True}"><list create="false" delete="false" limit="20"><field name="tp_employee_code" string="Mã nhân viên"/><field name="name" string="Nhân viên"/><field name="job_id" string="Chức vụ" context="{'form_view_ref': 'tp_hr_workspace.job_form'}"/><field name="work_phone" string="Điện thoại công việc"/><field name="tp_account_status" string="Tài khoản" widget="badge" decoration-success="tp_account_status == 'active'" decoration-danger="tp_account_status == 'disabled'" decoration-muted="tp_account_status == 'unlinked'"/></list></field></page><page name="organization" string="Cấp trên và cấp dưới"><field name="parent_id" string="Phòng ban cấp trên" readonly="1" context="{'form_view_ref': 'tp_hr_workspace.department_form'}"/><p class="o_tp_hr_context_note" invisible="child_ids">Chưa khai báo đơn vị cấp dưới.</p><field name="child_ids" widget="tp_kd_relation" invisible="not child_ids" readonly="1" context="{'form_view_ref': 'tp_hr_workspace.department_form', 'tp_hr_relation': True}"><list create="false" delete="false"><field name="name" string="Đơn vị cấp dưới"/><field name="tp_manager_label" string="Người quản lý"/><field name="tp_visible_employee_count" string="Số nhân viên" widget="tp_hr_count"/></list></field><widget name="hr_department_chart"/></page></notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="location_form" model="ir.ui.view">
        <field name="name">tp.hr.location.form</field><field name="model">hr.work.location</field>
        <field name="inherit_id" eval="False"/><field name="mode">primary</field><field name="priority">5</field>
        <field name="arch" type="xml"><form string="Nơi làm việc" class="o_tp_hr_catalog_form o_tp_hr_compact_form" js_class="tp_hr_catalog"><sheet><div class="oe_title"><span class="o_tp_hr_form_kind"><i class="oi" data-icon="location_on" aria-hidden="true"/>Nơi làm việc</span><h1><field name="name" placeholder="Tên nơi làm việc"/></h1></div><group><group string="Thông tin địa điểm"><field name="location_type" string="Loại địa điểm"/><field name="address_id" string="Địa chỉ" invisible="location_type == 'home'" required="location_type != 'home'" context="{'show_address': 1}" options="{'no_open': True, 'no_create': True}"/><field name="location_number" string="Số hiệu địa điểm"/></group><group string="Phạm vi sử dụng"><field name="company_id" groups="base.group_multi_company"/><field name="active" string="Đang sử dụng"/><p colspan="2" class="o_tp_hr_context_note">Chọn địa điểm này trong thông tin công việc của nhân viên. Không tự suy ra thông tin liên hệ hoặc người phụ trách.</p></group></group></sheet></form></field>
    </record>
    <record id="category_form" model="ir.ui.view">
        <field name="name">tp.hr.category.form</field><field name="model">hr.employee.category</field>
        <field name="inherit_id" eval="False"/><field name="mode">primary</field><field name="priority">5</field>
        <field name="arch" type="xml"><form string="Nhãn nhân viên" class="o_tp_hr_catalog_form" js_class="tp_hr_catalog"><sheet><div class="oe_button_box" name="button_box"><button name="action_tp_employees" type="object" class="oe_stat_button" icon="group"><field name="tp_visible_employee_count" string="Nhân viên đang sử dụng" widget="statinfo"/></button></div><div class="oe_title"><span class="o_tp_hr_form_kind"><i class="oi" data-icon="label" aria-hidden="true"/>Nhãn nhân viên</span><h1><field name="name" placeholder="Tên nhãn phân loại"/></h1></div><group><field name="color" string="Màu nhãn" widget="color_picker"/></group><p class="o_tp_hr_context_note">Nhãn dùng để phân loại hồ sơ; không phải thẻ ra vào hoặc thẻ chấm công. Gắn nhãn không cấp quyền và không đổi phòng ban.</p><separator string="Nhân viên thuộc nhãn"/><p class="o_tp_hr_context_note" invisible="employee_ids">Chưa có nhân viên đang sử dụng nhãn này.</p><field name="employee_ids" widget="tp_kd_relation" invisible="not employee_ids" readonly="1" domain="[('active', '=', True), ('company_id', 'in', allowed_company_ids)]" context="{'form_view_ref': 'tp_hr_workspace.employee_form', 'tp_hr_relation': True}"><list create="false" delete="false" limit="20"><field name="tp_employee_code" string="Mã nhân viên"/><field name="name" string="Nhân viên"/><field name="department_id" string="Phòng ban" context="{'form_view_ref': 'tp_hr_workspace.department_form'}"/><field name="job_id" string="Chức vụ" context="{'form_view_ref': 'tp_hr_workspace.job_form'}"/></list></field></sheet></form></field>
    </record>
    <record id="employee_hierarchy" model="ir.ui.view">
        <field name="name">tp.hr.employee.hierarchy</field><field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <hierarchy child_field="child_ids" js_class="tp_hr_hierarchy" avatar_field="image_128" draggable="0" create="0" label="cấp dưới" class="o_tp_hr_hierarchy">
                <field name="name"/><field name="parent_id"/><field name="department_id"/><field name="job_id"/><field name="child_ids"/>
                <templates><t t-name="hierarchy-box"><div class="o_tp_hr_hierarchy_identity"><field name="image_128" widget="image" options="{'size': [44, 44]}"/><div><field name="name" class="fw-bold"/><field name="job_id" class="text-muted"/></div></div><div class="o_tp_hr_hierarchy_unit"><field name="department_id"/></div><p t-if="!record.parent_id.raw_value" class="o_tp_hr_manager_missing">Chưa khai báo quản lý trực tiếp</p><p t-else="" class="o_tp_hr_manager_known">Quản lý: <field name="parent_id"/></p><button name="action_tp_profile" type="object" class="btn btn-link btn-sm" string="Xem hồ sơ"/></t></templates>
            </hierarchy>
        </field>
    </record>
    <record id="hierarchy_search" model="ir.ui.view"><field name="name">tp.hr.hierarchy.search</field><field name="model">hr.employee</field><field name="arch" type="xml"><search><field name="name" string="Nhân viên"/><field name="department_id" string="Phòng ban"/><filter name="no_manager" string="Chưa khai báo quản lý trực tiếp" domain="[('parent_id', '=', False)]"/></search></field></record>
    <record id="department_search" model="ir.ui.view"><field name="name">tp.hr.department.search</field><field name="model">hr.department</field><field name="arch" type="xml"><search><field name="name" string="Phòng ban"/><field name="manager_id" string="Người quản lý"/><field name="parent_id" string="Phòng ban cấp trên"/><filter name="missing_manager" string="Chưa khai báo quản lý" domain="[('manager_id', '=', False)]"/><filter name="archived" string="Lưu trữ" domain="[('active', '=', False)]"/><group><filter name="parent" string="Phòng ban cấp trên" context="{'group_by': 'parent_id'}"/></group></search></field></record>
    <record id="job_search" model="ir.ui.view"><field name="name">tp.hr.job.search</field><field name="model">hr.job</field><field name="arch" type="xml"><search><field name="name" string="Chức vụ"/><field name="department_id" string="Phòng ban áp dụng"/><filter name="archived" string="Ngừng sử dụng" domain="[('active', '=', False)]"/><group><filter name="department" string="Phòng ban" context="{'group_by': 'department_id'}"/></group></search></field></record>
    <record id="import_search" model="ir.ui.view"><field name="name">tp.hr.import.search</field><field name="model">tp.hr.import.batch</field><field name="arch" type="xml"><search><field name="name" string="Tên lô"/><field name="file_name" string="Tệp nguồn"/><field name="create_uid" string="Người tạo"/><filter name="draft" string="Chọn tệp" domain="[('state', '=', 'draft')]"/><filter name="preview" string="Cần đối chiếu" domain="[('state', '=', 'preview')]"/><filter name="applied" string="Đã áp dụng" domain="[('state', '=', 'applied')]"/><group><filter name="state" string="Trạng thái" context="{'group_by':'state'}"/></group></search></field></record>
    <record id="action_departments" model="ir.actions.act_window"><field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('department_list')}), (0, 0, {'view_mode': 'form', 'view_id': ref('department_form')})]"/><field name="search_view_id" ref="department_search"/></record>
    <record id="action_jobs" model="ir.actions.act_window"><field name="search_view_id" ref="job_search"/></record>
    <record id="action_locations" model="ir.actions.act_window"><field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('location_list')}), (0, 0, {'view_mode': 'form', 'view_id': ref('location_form')})]"/></record>
    <record id="action_categories" model="ir.actions.act_window"><field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('categories_list')}), (0, 0, {'view_mode': 'form', 'view_id': ref('category_form')})]"/></record>
    <record id="action_import" model="ir.actions.act_window"><field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('import_list')}), (0, 0, {'view_mode': 'form', 'view_id': ref('import_form')})]"/><field name="search_view_id" ref="import_search"/></record>
    <record id="action_hierarchy" model="ir.actions.act_window"><field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'hierarchy', 'view_id': ref('employee_hierarchy')}), (0, 0, {'view_mode': 'list', 'view_id': ref('employee_list')}), (0, 0, {'view_mode': 'form', 'view_id': ref('employee_form')})]"/><field name="search_view_id" ref="hierarchy_search"/></record>
</odoo>
