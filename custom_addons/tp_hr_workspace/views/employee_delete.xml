<odoo>
    <!-- HR-DELETE-010 (DEC-042): permanent deletion with admin password re-verification on every request.
         The dialog is the tp_hr_workspace.employee_delete client action; "Lưu trữ" stays a separate native action. -->
    <record id="action_server_delete_mistaken" model="ir.actions.server">
        <field name="name">Xóa vĩnh viễn nhân viên</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_view_types">list,form</field>
        <field name="group_ids" eval="[Command.set([ref('base.group_system')])]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_tp_permanent_delete()</field>
    </record>

    <!-- The generic hr_timesheet "Delete" entry would bypass the TP explanation; keep one guarded entry. -->
    <record id="hr_timesheet.unlink_employee_action" model="ir.actions.server">
        <field name="binding_model_id" eval="False"/>
    </record>

    <record id="employee_audit_list" model="ir.ui.view">
        <field name="name">tp.hr.employee.audit.list</field>
        <field name="model">tp.hr.employee.audit</field>
        <field name="arch" type="xml">
            <list string="Nhật ký xóa hồ sơ và sửa mã" create="false" edit="false" delete="false" js_class="tp_hr_table">
                <field name="create_date" string="Thời điểm"/>
                <field name="action" widget="badge" decoration-danger="action in ('delete', 'permanent_delete')" decoration-info="action == 'code_correction'"/>
                <field name="employee_code"/>
                <field name="new_code" optional="show"/>
                <field name="employee_name"/>
                <field name="source_code" optional="show"/>
                <field name="employee_ref" optional="hide"/>
                <field name="account_action" optional="show"/>
                <field name="reason_display"/>
                <field name="actor_name"/>
                <field name="request_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="employee_audit_form" model="ir.ui.view">
        <field name="name">tp.hr.employee.audit.form</field>
        <field name="model">tp.hr.employee.audit</field>
        <field name="arch" type="xml">
            <form string="Nhật ký hồ sơ nhân viên" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group><field name="action"/><field name="employee_name"/><field name="employee_code"/><field name="source_code" invisible="not source_code"/><field name="new_code" invisible="not new_code"/><field name="employee_ref"/></group>
                        <group><field name="create_date" string="Thời điểm"/><field name="actor_name"/><field name="verification" invisible="not verification"/><field name="account_action" invisible="not account_action"/><field name="account_login" invisible="not account_login"/><field name="request_id" invisible="not request_id"/><field name="company_id" groups="base.group_multi_company"/></group>
                    </group>
                    <group><field name="reason_display"/></group>
                    <button name="action_hide_from_list" type="object" string="Xóa khỏi danh sách" class="btn-outline-danger" groups="base.group_system"/>
                    <details><summary>Dữ liệu tại thời điểm thực hiện</summary><field name="snapshot" nolabel="1"/></details>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_employee_audit" model="ir.actions.act_window">
        <field name="name">Nhật ký xóa hồ sơ và sửa mã</field>
        <field name="res_model">tp.hr.employee.audit</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="employee_audit_list"/>
        <field name="help" type="html"><p>Chưa có thao tác xóa vĩnh viễn, xóa hồ sơ nhập nhầm hoặc sửa mã nhân viên.</p></field>
    </record>
    <menuitem id="menu_employee_audit" name="Nhật ký xóa hồ sơ và sửa mã" parent="menu_group_employees" action="action_employee_audit" sequence="50" groups="base.group_system"/>
    <record id="action_cleanup_employee_audit" model="ir.actions.server">
        <field name="name">Xóa nhật ký khỏi danh sách</field>
        <field name="model_id" ref="tp_organization.model_tp_hr_employee_audit"/>
        <field name="binding_model_id" ref="tp_organization.model_tp_hr_employee_audit"/>
        <field name="binding_view_types">list,form</field>
        <field name="group_ids" eval="[Command.set([ref('base.group_system')])]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_hide_from_list()</field>
    </record>
    <record id="audit_cleanup_form" model="ir.ui.view">
        <field name="name">tp.hr.audit.cleanup.form</field>
        <field name="model">tp.hr.audit.cleanup</field>
        <field name="arch" type="xml">
            <form string="Xóa nhật ký khỏi danh sách" class="o_tp_identity_check">
                <h3>Xác nhận dọn nhật ký</h3>
                <p>Chỉ các dòng bạn đã chọn được gỡ khỏi danh sách. Nhân viên, tài khoản, thiết bị và dữ liệu nghiệp vụ không bị xóa. Dấu vết kỹ thuật được giữ để tránh cấp lại mã hoặc nhập lại nhân viên đã xóa.</p>
                <group><field name="count"/><field name="audit_ids" invisible="1"/><field name="password" password="True" required="1" placeholder="Nhập mật khẩu của tài khoản đang đăng nhập"/></group>
                <footer><button name="action_confirm" type="object" string="Xóa khỏi danh sách" class="btn-danger" context="{'password': password}"/><button special="cancel" string="Hủy" class="btn-secondary"/></footer>
            </form>
        </field>
    </record>
</odoo>
