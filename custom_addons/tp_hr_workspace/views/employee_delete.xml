<odoo>
    <!-- HR-CORRECTION-008: guarded deletion of mistaken manual entries; everything else is archived. -->
    <record id="employee_delete_wizard_form" model="ir.ui.view">
        <field name="name">tp.hr.employee.delete.wizard.form</field>
        <field name="model">tp.hr.employee.delete.wizard</field>
        <field name="arch" type="xml">
            <form string="Xóa hồ sơ nhập nhầm" class="o_tp_hr_delete_wizard">
                <field name="eligible" invisible="1"/>
                <field name="can_archive" invisible="1"/>
                <div class="alert alert-danger mb-2" role="alert" invisible="not eligible">
                    <strong>Xóa vĩnh viễn, không thể khôi phục.</strong>
                    Chỉ dùng cho hồ sơ tạo nhầm, chưa có tài khoản, vai trò, nghiệp vụ hay lịch sử công tác. Tài khoản, liên hệ dùng chung và dữ liệu nghiệp vụ không bị xóa. Nhật ký xóa được lưu riêng.
                </div>
                <div class="alert alert-warning mb-2" role="alert" invisible="eligible">
                    <strong>Không xóa được.</strong>
                    Có hồ sơ đã được sử dụng nên không hồ sơ nào bị xóa. Hãy lưu trữ để ẩn hồ sơ và giữ lịch sử.
                </div>
                <field name="summary" nolabel="1" readonly="1"/>
                <group invisible="not eligible" class="mt-2">
                    <field name="reason" required="eligible" placeholder="Ví dụ: tạo trùng hồ sơ khi nhập tay, đã đối chiếu với danh sách nhân sự" rows="2"/>
                </group>
                <footer>
                    <button name="action_confirm_delete" type="object" string="Xác nhận xóa" class="btn btn-danger" invisible="not eligible" data-hotkey="q"/>
                    <button name="action_archive_instead" type="object" string="Lưu trữ nhân viên" class="btn btn-primary" invisible="eligible or not can_archive" data-hotkey="w"/>
                    <button special="cancel" string="Hủy" class="btn btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_server_delete_mistaken" model="ir.actions.server">
        <field name="name">Xóa hồ sơ nhập nhầm</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_view_types">list,form</field>
        <field name="group_ids" eval="[Command.set([ref('base.group_system')])]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_tp_delete_mistaken()</field>
    </record>

    <!-- The generic hr_timesheet "Delete" entry would bypass the TP explanation; keep one guarded entry. -->
    <record id="hr_timesheet.unlink_employee_action" model="ir.actions.server">
        <field name="binding_model_id" eval="False"/>
    </record>

    <record id="employee_audit_list" model="ir.ui.view">
        <field name="name">tp.hr.employee.audit.list</field>
        <field name="model">tp.hr.employee.audit</field>
        <field name="arch" type="xml">
            <list string="Nhật ký xóa hồ sơ và sửa mã" create="false" edit="false" delete="false" js_class="tp_hr_table">
                <field name="create_date" string="Thời điểm"/>
                <field name="action" widget="badge" decoration-danger="action == 'delete'" decoration-info="action == 'code_correction'"/>
                <field name="employee_code"/>
                <field name="new_code" optional="show"/>
                <field name="employee_name"/>
                <field name="employee_ref" optional="hide"/>
                <field name="reason"/>
                <field name="actor_name"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="employee_audit_form" model="ir.ui.view">
        <field name="name">tp.hr.employee.audit.form</field>
        <field name="model">tp.hr.employee.audit</field>
        <field name="arch" type="xml">
            <form string="Nhật ký hồ sơ nhân viên" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group><field name="action"/><field name="employee_name"/><field name="employee_code"/><field name="new_code" invisible="not new_code"/><field name="employee_ref"/></group>
                        <group><field name="create_date" string="Thời điểm"/><field name="actor_name"/><field name="company_id" groups="base.group_multi_company"/></group>
                    </group>
                    <group><field name="reason"/></group>
                    <details><summary>Dữ liệu tại thời điểm thực hiện</summary><field name="snapshot" nolabel="1"/></details>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_employee_audit" model="ir.actions.act_window">
        <field name="name">Nhật ký xóa hồ sơ và sửa mã</field>
        <field name="res_model">tp.hr.employee.audit</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="employee_audit_list"/>
        <field name="help" type="html"><p>Chưa có thao tác xóa hồ sơ nhập nhầm hoặc sửa mã nhân viên.</p></field>
    </record>
    <menuitem id="menu_employee_audit" name="Nhật ký xóa hồ sơ và sửa mã" parent="menu_group_employees" action="action_employee_audit" sequence="50" groups="base.group_system"/>
</odoo>
