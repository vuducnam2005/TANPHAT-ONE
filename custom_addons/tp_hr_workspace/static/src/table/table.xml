<templates xml:space="preserve">
<t t-name="tp_hr_workspace.TableTools"><div class="o_tp_hr_table_tools"><label class="o_tp_hr_page_size">Hiển thị<select aria-label="Số dòng mỗi trang" t-on-change="this.changeSize" t-att-disabled="this.props.controller.editedRecord or this.state.busy"><option t-foreach="this.pageSizes" t-as="n" t-key="n" t-att-value="n" t-att-selected="n === this.props.controller.model.root.limit" t-out="n"/></select><span t-out="this.props.controller.model.root.isGrouped ? 'nhóm mỗi trang' : 'dòng mỗi trang'"/></label><span t-if="this.state.busy" role="status">Đang tải…</span><span t-if="this.state.error" role="alert" class="text-danger" t-out="this.state.error"/></div></t>
<t t-name="tp_hr_workspace.ListView" t-inherit="web.ListView" t-inherit-mode="primary">
 <xpath expr="//t[@t-component='this.props.Renderer']" position="before"><section t-if="this.hrMissing" class="o_tp_hr_missing_note" role="note"><h2>Hồ sơ cần bổ sung</h2><p>Mục này tập hợp các hồ sơ thiếu thông tin cơ bản để bộ phận nhân sự rà soát và cập nhật. Đây vẫn là dữ liệu trong Danh sách nhân viên; sửa tại đây sẽ cập nhật cùng hồ sơ, không tạo bản sao.</p><p>Tiêu chí: thiếu mã nhân viên; chưa khai báo phòng ban; hoặc chưa có chức vụ và cũng không có chức vụ từ nguồn nhập.</p><strong t-if="this.model.isReady() and !this.model.root.count and !this.hrHasFilters">Các hồ sơ trong phạm vi đang xem đã đủ ba tiêu chí thông tin cơ bản.</strong></section></xpath>
 <xpath expr="//t[@t-set-slot='control-panel-navigation-additional']" position="inside"><span t-if="this.isReadonlyDirectory" class="o_tp_hr_readonly_badge o_tp_hr_list_readonly_badge" title="Chế độ chỉ xem: hiển thị thông tin công việc trong phạm vi được phép.">Chỉ xem</span><button t-if="this.showEmployeeExport and this.uiService.isSmall" type="button" class="btn btn-outline-primary o_tp_hr_export" t-on-click="this.openEmployeeExport" t-att-disabled="!this.model.isReady() or this.editedRecord"><i class="oi me-2" data-icon="download" aria-hidden="true"/>Xuất Excel</button><button t-if="this.hrHasFilters and !this.isEmployeeList" class="btn btn-outline-secondary o_tp_hr_clear" t-on-click="this.clearHrFilters">Xóa bộ lọc</button><HrTableTools t-if="!this.hasSelectedRecords" controller="this"/></xpath>
 <xpath expr="//t[@t-set-slot='control-panel-actions']" position="inside"><TpTableFilterBar controller="this"/></xpath>
 <xpath expr="//t[@t-component='this.props.Renderer']" position="before"><div class="o_tp_hr_list_heading" t-if="!this.isEmployeeList"><h1 t-out="this.hrContent[0]"/><p t-out="this.hrContent[1]"/><span class="o_tp_hr_result_count" t-if="this.model.isReady()"><t t-out="this.model.root.count"/> <t t-out="this.model.root.isGrouped ? 'nhóm kết quả · số bản ghi hiển thị trong từng nhóm' : 'kết quả'"/></span></div>
 <div class="o_tp_hr_empty" t-if="this.model.isReady() and !this.model.root.count and (!this.hrMissing or this.hrHasFilters)"><i class="oi" data-icon="folder_open" aria-hidden="true"/><h2 t-out="this.hrHasFilters ? 'Không có kết quả phù hợp' : this.hrContent[3]"/><p t-out="this.hrHasFilters ? 'Thay đổi hoặc xóa bộ lọc để tìm lại dữ liệu.' : this.hrContent[1]"/><button t-if="this.hrHasFilters" class="btn btn-outline-primary" t-on-click="this.clearHrFilters">Xóa bộ lọc</button><button t-elif="this.activeActions.create" class="btn btn-primary" t-on-click="this.onClickCreate" t-out="this.hrContent[2]"/></div></xpath>
</t>
<t t-name="tp_hr_workspace.ListButtons" t-inherit="web.ListView.Buttons" t-inherit-mode="primary"><xpath expr="//button[hasclass('o_list_button_add')]" position="replace"><button t-if="!this.env.inDialog and !this.editedRecord and this.activeActions.create" type="button" class="btn btn-primary o_list_button_add" data-hotkey="c" t-on-click="this.onClickCreate"><i class="oi" data-icon="add" aria-hidden="true"/><t t-out="this.hrContent[2]"/></button></xpath><xpath expr="//button[hasclass('o_list_button_add')]" position="after"><button t-if="this.showEmployeeExport and !this.uiService.isSmall" type="button" class="btn btn-outline-primary o_tp_hr_export" t-on-click="this.openEmployeeExport" t-att-disabled="!this.model.isReady() or this.editedRecord"><i class="oi me-2" data-icon="download" aria-hidden="true"/>Xuất Excel</button></xpath></t>
<t t-name="tp_hr_workspace.ListRenderer" t-inherit="web.ListRenderer" t-inherit-mode="primary"><xpath expr="//th[@t-else='']" position="inside"><span t-if="column.type === 'button_group'">Thao tác</span></xpath><xpath expr="//t[@t-if='this.showNoContentHelper']" position="attributes"><attribute name="t-if">false</attribute></xpath></t>
<t t-name="tp_hr_workspace.RecordRow" t-inherit="web.ListRenderer.RecordRow" t-inherit-mode="primary"><xpath expr="//td[@t-att-name='column.name']" position="attributes"><attribute name="t-att-title">this.getFormattedValue(column, record)</attribute></xpath></t>
<t t-name="tp_hr_workspace.GroupRow" t-inherit="web.ListRenderer.GroupRow" t-inherit-mode="primary"><xpath expr="//t[@t-out='this.odoomark(group.displayName)']" position="attributes"><attribute name="t-out">this.odoomark(this.hrGroupLabel(group))</attribute></xpath></t>
<t t-name="tp_hr_workspace.IdentityCell"><div class="o_tp_hr_identity_content"><img t-if="this.isEmployee" t-att-src="this.avatarUrl" alt="" loading="lazy"/><t t-else=""><i class="oi o_tp_hr_org_icon" data-icon="account_tree" aria-hidden="true"/><i t-att-class="'o_tag o_tp_hr_color_dot o_tag_color_' + this.props.record.data.color" aria-hidden="true"/></t><div t-out="this.props.record.data[this.props.name]"/></div></t>
<t t-name="tp_hr_workspace.CountCell"><button class="btn btn-link o_tp_hr_count" t-on-click.stop="this.open" title="Xem nhân viên đang sử dụng hồ sơ"><t t-out="this.props.record.data[this.props.name]"/> <span class="visually-hidden">nhân viên</span></button></t>
<t t-name="tp_hr_workspace.DateTimeCell"><span class="o_tp_hr_datetime" t-out="this.value"/></t>
<t t-name="tp_hr_workspace.ActiveCell"><span t-att-class="'badge ' + (this.props.record.data[this.props.name] ? 'text-bg-success' : 'text-bg-secondary')" t-out="this.props.record.data[this.props.name] ? 'Đang sử dụng' : 'Ngừng sử dụng'"/></t>
<t t-name="tp_hr_workspace.EmploymentCell"><span t-if="this.props.readonly" t-att-class="'o_tp_hr_employment badge o_tp_hr_employment_' + (this.value || 'unknown')" t-out="this.label"/><select t-else="" class="o_input" aria-label="Loại hình lao động" t-on-change="this.change"><option value="" t-att-selected="!this.value">Chưa khai báo</option><option value="short_term" t-att-selected="this.value === 'short_term'">Ngắn hạn</option><option value="long_term" t-att-selected="this.value === 'long_term'">Dài hạn</option><option value="outsourced" t-att-selected="this.value === 'outsourced'">Thuê khoán</option></select></t>
<t t-name="tp_hr_workspace.EmployeeReorderLayout" t-inherit="tp_hr_workspace.ListRenderer" t-inherit-mode="extension">
 <xpath expr="//tbody" position="replace">
  <t t-if="this.isDeptGroupedEmployeeList">
   <tbody t-foreach="this.props.list.groups" t-as="group" t-key="group.id" class="ui-sortable o_tp_hr_dept_tbody" t-att-data-dept-id="this.hrGroupDeptId(group)">
    <t t-call="{{ this.constructor.groupRowTemplate }}"/>
    <t t-if="!group.isFolded" t-call="{{ this.constructor.rowsTemplate }}" list="group.list" groupId="group.id"/>
   </tbody>
  </t>
  <tbody t-else="" class="ui-sortable"><t t-call="{{ this.constructor.rowsTemplate }}" list="this.props.list"/></tbody>
 </xpath>
</t>
<t t-name="tp_hr_workspace.EmployeeReorderRow" t-inherit="tp_hr_workspace.RecordRow" t-inherit-mode="extension">
 <xpath expr="//tr" position="attributes"><attribute name="t-att-data-res-id">record.resId</attribute></xpath>

</t>
<t t-name="tp_hr_workspace.EmployeeReorderGuidance" t-inherit="tp_hr_workspace.ListView" t-inherit-mode="extension">
 <xpath expr="//t[@t-component='this.props.Renderer']" position="before"><div t-if="this.showEmployeeReorderLockBanner" class="o_tp_hr_reorder_guidance" role="note"><button type="button" class="btn btn-link" t-on-click="this.resetToEmployeeCustomOrder" t-out="this.hrReorderGuidanceText"/></div></xpath>
</t>
<t t-name="tp_hr_workspace.EmployeeExportDialog">
 <Dialog title="'Xuất Excel danh sách nhân viên'" size="'md'">
  <div class="o_tp_hr_export_dialog">
   <p class="text-muted">Chọn phạm vi xuất. File giữ thứ tự phòng ban và nhân viên đã lưu.</p>
   <fieldset t-att-disabled="this.state.loading or this.state.busy">
    <legend class="visually-hidden">Phạm vi xuất nhân viên</legend>
    <label class="o_tp_hr_export_scope"><input type="radio" name="hr-export-scope" value="filtered" t-att-checked="this.state.scope === 'filtered'" t-on-change="this.changeScope"/><span><strong>Theo bộ lọc đang áp dụng</strong><small>Toàn bộ kết quả, kể cả nhóm thu gọn và các trang sau.</small></span><b t-out="this.state.counts.filtered ?? '…'"/></label>
    <label class="o_tp_hr_export_scope"><input type="radio" name="hr-export-scope" value="all" t-att-checked="this.state.scope === 'all'" t-on-change="this.changeScope"/><span><strong>Toàn bộ nhân viên trong quyền quản lý</strong><small>Bao gồm hồ sơ lưu trữ trong các công ty đang chọn.</small></span><b t-out="this.state.counts.all ?? '…'"/></label>
    <label class="o_tp_hr_export_scope"><input type="radio" name="hr-export-scope" value="selected" t-att-checked="this.state.scope === 'selected'" t-on-change="this.changeScope" t-att-disabled="!this.props.options.selection_all and !this.props.options.selected_ids.length"/><span><strong>Các nhân viên đã chọn</strong><small>Chỉ các dòng được chọn trong kết quả đang lọc.</small></span><b t-out="this.state.counts.selected ?? '…'"/></label>
   </fieldset>
   <p class="o_tp_hr_export_count" role="status" t-if="!this.state.loading and !this.state.error">Sẽ xuất <strong t-out="this.state.counts[this.state.scope]"/> nhân viên.</p>
   <p t-if="this.state.scope !== 'all'" class="text-muted text-break" t-out="this.props.options.filter_label"/>
   <p class="text-muted small">Hai sheet: Danh sách nhân viên và Dữ liệu chi tiết. Thông tin hợp đồng được tách riêng khi có dữ liệu và quyền đọc.</p>
   <p t-if="this.state.error" role="alert" class="text-danger" t-out="this.state.error"/>
  </div>
  <t t-set-slot="footer"><button class="btn btn-primary" t-on-click="this.exportFile" t-att-disabled="this.state.loading or this.state.busy or this.state.error or !this.state.counts[this.state.scope]"><i class="oi me-2" data-icon="download" aria-hidden="true"/><t t-out="this.state.busy ? 'Đang tạo file…' : 'Xuất Excel'"/></button><button class="btn btn-secondary" t-on-click="this.props.close" t-att-disabled="this.state.busy">Đóng</button><button t-if="this.state.error" class="btn btn-link" t-on-click="this.loadCounts">Thử lại</button></t>
 </Dialog>
</t>
</templates>

