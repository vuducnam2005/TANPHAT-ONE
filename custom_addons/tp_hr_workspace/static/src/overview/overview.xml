<templates xml:space="preserve">
<t t-name="tp_hr_workspace.Overview">
<div class="o_tp_hr_overview" aria-label="Tổng quan TP HR" t-att-aria-busy="this.state.loading" t-on-scroll="this.clearHighlight" t-on-keydown="this.onKeydown">
    <header>
        <div><h1>Tổng quan nhân sự</h1><small t-if="this.state.data">Cập nhật <t t-out="this.state.data.updated_at"/></small></div>
        <div class="o_tp_hr_actions">
            <button t-if="this.state.data?.can_create" class="btn btn-primary" t-on-click="this.createEmployee" t-att-disabled="!this.ready"><i class="fa fa-plus me-2"/>Thêm nhân viên</button>
            <button class="btn btn-outline-primary" t-on-click="this.exportFile" t-att-disabled="!this.ready"><i class="fa fa-download me-2"/>Xuất Excel nhân sự</button>
            <button class="btn btn-secondary" t-on-click="this.load" t-att-disabled="this.state.loading" aria-label="Làm mới" title="Làm mới">Làm mới</button>
        </div>
    </header>
    <div class="o_tp_hr_filters">
        <label>Đơn vị<select aria-label="Lọc đơn vị" t-on-change="(ev) => this.changeFilter(ev, 'department')"><option value="" t-att-selected="!this.state.department">Tất cả trong quyền</option><option t-foreach="this.state.catalog" t-as="row" t-key="row.id" t-att-value="row.id" t-att-selected="('' + row.id) === this.state.department" t-out="row.name"/></select></label>
        <label>Chức vụ<select aria-label="Lọc chức vụ" t-on-change="(ev) => this.changeFilter(ev, 'job')"><option value="" t-att-selected="!this.state.job">Tất cả chức vụ</option><option t-foreach="this.state.jobs" t-as="row" t-key="row.id" t-att-value="row.id" t-att-selected="('' + row.id) === this.state.job" t-out="row.name"/></select></label>
        <label>Loại hình lao động<select aria-label="Lọc loại hình lao động" t-on-change="ev => this.changeFilter(ev, 'employment')"><option value="" t-att-selected="!this.state.employment">Tất cả loại hình</option><option value="short_term" t-att-selected="this.state.employment === 'short_term'">Ngắn hạn</option><option value="long_term" t-att-selected="this.state.employment === 'long_term'">Dài hạn</option><option value="outsourced" t-att-selected="this.state.employment === 'outsourced'">Thuê khoán</option><option value="unknown" t-att-selected="this.state.employment === 'unknown'">Chưa khai báo</option></select></label>
        <label>Hồ sơ<select aria-label="Lọc hồ sơ" t-on-change="(ev) => this.changeFilter(ev, 'status')"><option value="active" t-att-selected="this.state.status === 'active'">Đang quản lý</option><option value="archived" t-att-selected="this.state.status === 'archived'">Lưu trữ</option><option value="all" t-att-selected="this.state.status === 'all'">Tất cả</option></select></label>
        <button class="btn btn-link" t-on-click="this.resetFilters">Xóa bộ lọc</button>
    </div>
    <div t-if="this.state.loading" role="status" class="o_tp_hr_message o_tp_hr_skeleton"><span class="fa fa-circle-o-notch fa-spin me-2"/>Đang tải tổng quan…<div/><div/></div>
    <div t-elif="this.state.error" role="alert" class="o_tp_hr_message"><h2>Chưa thể hiển thị dữ liệu</h2><p t-out="this.state.error"/><button class="btn btn-primary" t-on-click="this.load">Thử lại</button></div>
    <t t-elif="this.state.data">
        <div class="o_tp_hr_kpis">
            <button t-on-click="() => this.openEmployees()"><svg class="o_tp_hr_kpi_icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="7" r="3"/><path d="M3 21v-3a6 6 0 0 1 12 0v3M16 4a3 3 0 0 1 0 6m2 4a6 6 0 0 1 3 5v2"/></svg><strong t-out="this.state.data.total"/><span>Hồ sơ nhân viên</span><small>Trong phạm vi đang xem</small></button>
            <button t-on-click="this.openSummary" class="o_tp_hr_kpi_units" t-att-disabled="!this.state.data.units"><svg class="o_tp_hr_kpi_icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 21V5l8-3v19M12 9h8v12M2 21h20M7 7h2m-2 4h2m-2 4h2m7-2h2m-2 4h2"/></svg><strong t-out="this.state.data.units"/><span>Đơn vị có nhân viên</span><small>Xem tổng hợp bên dưới</small></button>
            <button t-on-click="() => this.openEmployees([['user_id', '!=', false]])"><svg class="o_tp_hr_kpi_icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m10 13 4-4m-6 6-2 2a4 4 0 0 1-6-6l4-4a4 4 0 0 1 6 0m0 10a4 4 0 0 0 6 0l4-4a4 4 0 0 0-6-6l-2 2"/></svg><strong t-out="this.state.data.linked"/><span>Có tài khoản</span><small>Hồ sơ có người dùng</small></button>
            <button t-on-click="() => this.openEmployees([['user_id', '=', false]])"><svg class="o_tp_hr_kpi_icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="7" r="4"/><path d="M3 21v-2a7 7 0 0 1 14 0v2m1-10h5"/></svg><strong t-out="this.state.data.pending"/><span>Chưa có tài khoản</span><small>Không bắt buộc tạo tài khoản</small></button>
            <button class="o_tp_hr_kpi_quality" t-on-click="this.openMissing"><svg class="o_tp_hr_kpi_icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4H4v18h16V4h-5M9 2h6v4H9Zm-2 9h10m-10 5h7"/></svg><strong t-out="this.state.data.missing_basic"/><span>Cần bổ sung cơ bản</span><small>Đếm mỗi hồ sơ một lần</small></button>
        </div>
        <div t-if="!this.state.data.total" role="status" class="o_tp_hr_message"><h2>Không có hồ sơ phù hợp</h2><p>Không có hồ sơ phù hợp bộ lọc trong phạm vi quyền của bạn.</p><button class="btn btn-outline-primary" t-on-click="this.resetFilters">Xóa bộ lọc</button></div>
        <div t-else="" class="o_tp_hr_charts">
            <section class="o_tp_hr_structure"><div class="o_tp_hr_section_heading"><h2>Cơ cấu nhân sự theo đơn vị</h2><span>Hồ sơ / tỷ lệ</span></div>
                <div class="o_tp_hr_structure_content"><div class="o_tp_hr_donut">
                    <svg viewBox="0 0 320 320" role="group" aria-label="Cơ cấu nhân viên theo đơn vị">
                        <path t-foreach="this.segments" t-as="row" t-key="row.id" t-att-d="row.path" t-att-fill="row.color" stroke="#fff" stroke-width="1.5" fill-rule="evenodd" role="button" tabindex="0"
                              t-att-class="{'is-highlighted': this.state.highlight === 'department-' + row.id, 'is-muted': this.state.highlight?.startsWith('department-') and this.state.highlight !== 'department-' + row.id}"
                              t-att-aria-label="row.name + ': ' + row.count + ' hồ sơ, ' + row.percent.toFixed(1) + '%'"
                              t-on-pointerenter="(ev) => this.highlight(ev,row,'department')" t-on-pointerleave="this.clearHighlight" t-on-focus="(ev) => this.highlight(ev,row,'department')" t-on-blur="this.clearHighlight"
                              t-on-click="() => this.openDepartment(row)" t-on-keydown="(ev) => this.onSliceKey(ev, row)"/>
                        <text class="o_tp_hr_donut_total" x="160" y="158" text-anchor="middle" t-out="this.state.data.total"/>
                        <text class="o_tp_hr_donut_label" x="160" y="184" text-anchor="middle">hồ sơ nhân viên</text>
                    </svg>
                </div><ul class="o_tp_hr_legend"><li t-foreach="this.segments" t-as="row" t-key="row.id"><button t-att-class="{'is-highlighted': this.state.highlight === 'department-' + row.id}" t-on-pointerenter="(ev) => this.highlight(ev,row,'department')" t-on-pointerleave="this.clearHighlight" t-on-focus="(ev) => this.highlight(ev,row,'department')" t-on-blur="this.clearHighlight" t-on-click="() => this.openDepartment(row)"><span class="o_tp_hr_dot" t-att-style="'background:' + row.color"/><span t-out="row.name"/><strong t-out="row.count"/><small><t t-out="row.percent.toFixed(1)"/>%</small></button></li></ul></div>
            </section>
            <section class="o_tp_hr_jobs"><div class="o_tp_hr_section_heading"><h2>Cơ cấu nhân sự theo chức vụ</h2><span>Số hồ sơ</span></div>
                <div class="o_tp_hr_bar_axis" aria-hidden="true"><span t-foreach="this.axisTicks" t-as="tick" t-key="tick" t-out="tick"/></div>
                <div class="o_tp_hr_job_bars" tabindex="0" aria-label="Tất cả chức vụ; cuộn để xem khi danh mục dài"><div t-foreach="this.jobs" t-as="row" t-key="row.id" class="o_tp_hr_bar"><button t-att-aria-label="row.name + ': ' + row.count + ' hồ sơ, ' + (row.count/this.state.data.total*100).toFixed(1) + '%'" t-on-pointerenter="(ev) => this.highlight(ev,row,'job')" t-on-pointerleave="this.clearHighlight" t-on-focus="(ev) => this.highlight(ev,row,'job')" t-on-blur="this.clearHighlight" t-on-click="() => this.openJob(row)"><span class="o_tp_hr_bar_name" t-out="row.name"/><span class="o_tp_hr_bar_track"><span t-att-style="'width:' + (row.count/this.axisMax*100) + '%'"/></span><strong t-out="row.count"/></button></div></div>
                <p class="o_tp_hr_chart_hint">Chọn biểu đồ để xem danh sách nhân viên.</p>
            </section>
            <section class="o_tp_hr_summary" id="hr-department-summary"><div class="o_tp_hr_section_heading"><h2>Tổng hợp theo đơn vị</h2><span>Cùng phạm vi bộ lọc</span></div>
                <div class="o_tp_hr_table_tools"><label class="o_tp_hr_table_search">Chỉ tìm trong bảng<input type="search" aria-label="Tìm đơn vị trong bảng" placeholder="Tìm tên đơn vị…" t-att-value="this.state.search" t-on-input="this.searchTable"/></label><label>Số dòng<select aria-label="Số dòng tổng hợp" t-on-change="this.changePageSize"><option t-foreach="[10,20,50,100]" t-as="size" t-key="size" t-att-value="size" t-att-selected="this.state.pageSize === size" t-out="size"/></select></label></div>
                <div class="o_tp_hr_table_scroll"><table><caption class="visually-hidden">Số hồ sơ theo đơn vị</caption><thead><tr><th>Đơn vị</th><th>Hồ sơ</th><th>Có tài khoản</th><th>Chưa có tài khoản</th><th>Thiếu cơ bản</th></tr></thead><tbody><tr t-foreach="this.visibleRows" t-as="row" t-key="row.id"><td><button class="btn btn-link" t-on-click="() => this.openDepartment(row)"><span class="o_tp_hr_dot" t-att-style="'background:' + row.color"/><t t-out="row.name"/></button></td><td t-out="row.count"/><td t-out="row.linked || 0"/><td t-out="row.pending || 0"/><td><span t-att-class="row.missing ? 'o_tp_hr_badge_warning' : ''" t-out="row.missing || 0"/></td></tr></tbody><tfoot><tr><th>Tổng trong bộ lọc</th><td t-out="this.state.data.total"/><td t-out="this.state.data.linked"/><td t-out="this.state.data.pending"/><td t-out="this.state.data.missing_basic"/></tr></tfoot></table></div>
                <p t-if="!this.tableRows.length" role="status">Không tìm thấy đơn vị trong bảng.</p>
                <div class="o_tp_hr_table_pager"><span>Trang <t t-out="this.state.page"/> / <t t-out="this.pageCount"/></span><button class="btn btn-sm btn-secondary" aria-label="Trang trước" t-att-disabled="this.state.page === 1" t-on-click="() => this.state.page--">‹</button><button class="btn btn-sm btn-secondary" aria-label="Trang sau" t-att-disabled="this.state.page >= this.pageCount" t-on-click="() => this.state.page++">›</button></div>
            </section>
            <section class="o_tp_hr_quality"><h2>Thông tin cần bổ sung</h2><ul><li t-foreach="this.checklist" t-as="item" t-key="item.key"><button t-on-click="() => this.openEmployees(item.domain)"><span><span t-out="item.label"/><small t-if="item.note" t-out="item.note"/></span><strong t-att-class="item.count ? 'o_tp_hr_badge_warning' : ''" t-out="item.count"/></button></li></ul><p class="o_tp_hr_note">Các mục có thể trùng hồ sơ; không cộng các dòng thành số người.</p></section>
            <section class="o_tp_hr_accounts"><div><h2>Tình trạng tài khoản</h2><p><strong><t t-out="this.state.data.linked"/> / <t t-out="this.state.data.total"/></strong> hồ sơ có tài khoản · <t t-out="this.linkPercent.toFixed(1)"/>%</p></div><div class="o_tp_hr_account_progress"><div class="o_tp_hr_bar_track" role="progressbar" aria-label="Tỷ lệ hồ sơ có tài khoản" aria-valuemin="0" aria-valuemax="100" t-att-aria-valuenow="this.linkPercent"><span t-att-style="'width:' + this.linkPercent + '%'"/></div><div class="o_tp_hr_account_actions"><button class="btn btn-link o_tp_hr_account_linked" t-on-click="() => this.openEmployees([['user_id', '!=', false]])">Có tài khoản: <t t-out="this.state.data.linked"/></button><button class="btn btn-link o_tp_hr_account_pending" t-on-click="() => this.openEmployees([['user_id', '=', false]])">Chưa có tài khoản: <t t-out="this.state.data.pending"/></button></div><div class="o_tp_hr_account_states"><button class="o_tp_hr_account_open" t-on-click="() => this.openEmployees([['tp_account_status', '=', 'active']])">Mở: <t t-out="this.state.data.linked - (this.state.data.locked || 0)"/></button><button class="o_tp_hr_account_locked" t-on-click="() => this.openEmployees([['tp_account_status', '=', 'disabled']])">Khóa: <t t-out="this.state.data.locked || 0"/></button><span>Trong số có tài khoản</span></div></div><p class="o_tp_hr_note">Chưa có tài khoản là bình thường nếu nhân viên chưa cần sử dụng hệ thống. Lưu trữ hồ sơ không tự khóa tài khoản.</p></section>
        </div>
        <p class="o_tp_hr_note o_tp_hr_footnote">Số liệu phản ánh hiện trạng hồ sơ; chưa xác nhận tình trạng lao động, lương hoặc chuyên cần.</p>
    </t>
    <div t-if="this.state.tooltip" class="o_tp_hr_chart_tooltip" role="tooltip" t-att-style="'left:' + this.state.tooltip.left + 'px;top:' + this.state.tooltip.top + 'px'"><strong t-out="this.state.tooltip.name"/><span><t t-out="this.state.tooltip.count"/> hồ sơ · <t t-out="this.state.tooltip.percent.toFixed(1)"/>%</span></div>
</div></t></templates>

