<templates xml:space="preserve">
    <t t-name="tp_hr_workspace.AccountCredentials">
        <Dialog title="this.props.reset ? 'Đặt lại mật khẩu' : 'Tạo tài khoản riêng'" size="'md'" contentClass="'o_tp_hr_credentials'">
            <div class="o_tp_hr_credential_identity"><div><strong t-out="this.props.employeeName"/><p><span t-out="this.props.employeeCode"/> · <span t-out="this.props.department"/></p></div></div>
            <p class="o_tp_hr_credential_intro" t-if="!this.props.reset">Tạo thông tin đăng nhập riêng cho nhân viên này. Quyền nghiệp vụ sẽ được giao sau trong hồ sơ.</p>
            <p class="o_tp_hr_credential_intro" t-else="">Nhập mật khẩu mới cho nhân viên. Tên đăng nhập được giữ nguyên.</p>
            <form id="tp_hr_credentials_form" t-on-submit="this.submit" autocomplete="off">
                <div class="o_tp_hr_credential_field"><label for="tp_account_login">Tên đăng nhập <span t-if="!this.props.reset" aria-label="bắt buộc">*</span></label><input id="tp_account_login" name="account_login" type="text" t-ref="this.loginInput" t-att-value="this.state.login" t-on-input="(ev) => this.state.login = ev.target.value" t-att-readonly="this.props.reset" t-att-disabled="this.state.busy" maxlength="254" autocomplete="username" spellcheck="false" autocapitalize="none" aria-describedby="tp_account_login_help"/><small id="tp_account_login_help">Dùng để đăng nhập TANPHAT ONE. Không chứa khoảng trắng.</small></div>
                <div class="o_tp_hr_credential_field"><label for="tp_account_password">Mật khẩu mới <span aria-label="bắt buộc">*</span></label><div class="o_tp_hr_password_row"><input id="tp_account_password" name="account_password" t-ref="this.passwordInput" t-att-type="this.state.visible ? 'text' : 'password'" t-att-value="this.state.password" t-on-input="(ev) => this.state.password = ev.target.value" t-att-disabled="this.state.busy" autocomplete="new-password" aria-describedby="tp_account_password_help"/><button type="button" class="o_tp_hr_password_toggle" t-on-click="() => this.state.visible = !this.state.visible" t-att-aria-pressed="this.state.visible" t-att-aria-label="this.state.visible ? 'Ẩn mật khẩu' : 'Hiện mật khẩu'" t-att-disabled="this.state.busy"><t t-out="this.state.visible ? 'Ẩn' : 'Hiện'"/></button></div><small id="tp_account_password_help"><t t-if="this.props.minLength">Tối thiểu <t t-out="this.props.minLength"/> ký tự. </t>Chọn mật khẩu khó đoán và chỉ bàn giao cho đúng nhân viên.</small></div>
                <div class="o_tp_hr_credential_field"><label for="tp_account_confirmation">Nhập lại mật khẩu <span aria-label="bắt buộc">*</span></label><input id="tp_account_confirmation" name="account_confirmation" t-att-type="this.state.visible ? 'text' : 'password'" t-att-value="this.state.confirmation" t-on-input="(ev) => this.state.confirmation = ev.target.value" t-att-disabled="this.state.busy" autocomplete="new-password" aria-describedby="tp_account_confirmation_help"/><small id="tp_account_confirmation_help">Nhập giống mật khẩu mới để tránh nhầm khi cấp tài khoản.</small></div>
                <div t-if="this.state.error" class="o_tp_hr_credential_error" role="alert" t-out="this.state.error"/>
                <p class="o_tp_hr_credential_notice">Danh tính quản trị viên đã được xác nhận. Mật khẩu mới không được lưu trong bản nháp hoặc ghi vào lịch sử.</p>
            </form>
            <t t-set-slot="footer"><button type="submit" form="tp_hr_credentials_form" class="btn btn-primary" t-att-disabled="this.state.busy"><t t-if="this.state.busy">Đang lưu…</t><t t-elif="this.props.reset">Lưu mật khẩu mới</t><t t-else="">Tạo tài khoản</t></button><button type="button" class="btn btn-outline-secondary" t-on-click="this.props.close" t-att-disabled="this.state.busy">Hủy</button></t>
        </Dialog>
    </t>
    <t t-name="tp_hr_workspace.ChangeLogin">
        <Dialog title="'Đổi tên đăng nhập'" size="'md'" contentClass="'o_tp_hr_credentials'">
            <div class="o_tp_hr_credential_identity"><div><span>Nhân viên</span><div><strong t-out="this.props.employeeName"/></div><p><span t-out="this.props.employeeCode"/> · <span t-out="this.props.department"/></p></div></div>
            <p class="o_tp_hr_credential_intro">Sau khi đổi, sử dụng tên mới cho lần đăng nhập tiếp theo. Mật khẩu giữ nguyên.</p>
            <form id="tp_hr_change_login_form" t-on-submit="this.submit" autocomplete="off">
                <div class="o_tp_hr_credential_field"><label for="tp_login_current">Tên đăng nhập hiện tại</label><input id="tp_login_current" type="text" t-att-value="this.props.currentLogin" readonly="readonly"/></div>
                <div class="o_tp_hr_credential_field"><label for="tp_login_new">Tên đăng nhập mới <span aria-label="bắt buộc">*</span></label><input id="tp_login_new" type="text" t-ref="this.loginInput" t-att-value="this.state.login" t-on-input="(ev) => { this.state.login = ev.target.value; this.state.error = ''; }" t-att-disabled="this.state.busy" t-att-aria-invalid="this.state.error ? 'true' : 'false'" aria-describedby="tp_login_help tp_login_error" autocomplete="off" autocapitalize="none" spellcheck="false"/><small id="tp_login_help">Không chứa khoảng trắng, tối đa 254 ký tự. Giữ đúng chữ hoa và chữ thường khi đăng nhập.</small><div id="tp_login_error" t-if="this.state.error" class="o_tp_hr_credential_error mt-2" role="alert" t-out="this.state.error"/></div>
                <p class="o_tp_hr_credential_notice">Phiên hiện tại của tài khoản được đổi sẽ cần đăng nhập lại bằng tên mới. Chính sách một thiết bị được giữ nguyên.</p>
            </form>
            <t t-set-slot="footer"><button type="submit" form="tp_hr_change_login_form" class="btn btn-primary" t-att-disabled="this.state.busy"><t t-if="this.state.busy">Đang lưu…</t><t t-else="">Lưu thay đổi</t></button><button type="button" class="btn btn-outline-secondary" t-on-click="this.props.close" t-att-disabled="this.state.busy">Hủy</button></t>
        </Dialog>
    </t>
</templates>


