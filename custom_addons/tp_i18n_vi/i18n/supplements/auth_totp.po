#. module: auth_totp
#. odoo-javascript
#: code:addons/auth_totp/static/src/services/check_identity/check_identity.xml:0
msgid "Authentication code"
msgstr "Mã xác thực"

#. module: auth_totp
#. odoo-javascript
#: code:addons/auth_totp/static/src/services/check_identity/check_identity.xml:0
msgid ""
"Open your two-factor authenticator (TOTP) app or browser extension to view "
"your authentication code."
msgstr ""
"Mở ứng dụng xác thực hai yếu tố (TOTP) hoặc tiện ích mở rộng trình duyệt để "
"xem mã xác thực của bạn."

#. module: auth_totp
#. odoo-javascript
#: code:addons/auth_totp/static/src/services/check_identity/check_identity.xml:0
msgid "Use your authenticator app"
msgstr "Sử dụng ứng dụng xác thực của bạn"

#. module: auth_totp
#. odoo-python
#: code:addons/auth_totp/models/res_users.py:0
msgid "Verification failed, please use the latest 6-digit code"
msgstr "Xác minh không thành công, vui lòng sử dụng mã 6 chữ số mới nhất"

#. module: auth_totp
#. odoo-javascript
#: code:addons/auth_totp/static/src/services/check_identity/check_identity.xml:0
msgid "Verify"
msgstr "Xác minh"

#. module: auth_totp
#. odoo-python
#: code:addons/auth_totp/models/res_users.py:0
msgid ""
"You reached the limit of authentication mails sent for your account, please "
"try again later."
msgstr ""
"Bạn đã đạt đến giới hạn số thư xác thực được gửi cho tài khoản của mình, vui"
" lòng thử lại sau."

#. module: auth_totp
#. odoo-python
#: code:addons/auth_totp/models/res_users.py:0
msgid ""
"You reached the limit of code verifications for your account, please try "
"again later."
msgstr ""
"Bạn đã đạt đến giới hạn xác minh mã cho tài khoản của mình, vui lòng thử lại"
" sau."
