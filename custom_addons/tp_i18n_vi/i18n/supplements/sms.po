#. module: sms
#. odoo-javascript
#: code:addons/sms/static/src/components/sms_widget/sms_composer_template_selector.js:0
msgid "Select a Template"
msgstr "Chọn một mẫu"

#. module: sms
#. odoo-python
#: code:addons/sms/wizard/sms_composer.py:0
msgid "A message can only be scheduled in comment mode"
msgstr "Một tin nhắn chỉ có thể được lên lịch ở chế độ bình luận"

#. module: sms
#. odoo-python
#: code:addons/sms/wizard/sms_composer.py:0
msgid "A scheduled date is needed to schedule a message"
msgstr "Cần có ngày đã lên lịch để lên lịch gửi tin nhắn"

#. module: sms
#. odoo-python
#: code:addons/sms/wizard/sms_composer.py:0
msgid "Create an SMS Template"
msgstr "Tạo mẫu SMS"

#. module: sms
#. odoo-javascript
#: code:addons/sms/static/src/core/notification_model_patch.js:0
msgid "Database non active"
msgstr "Cơ sở dữ liệu không hoạt động"

#. module: sms
#. odoo-python
#: code:addons/sms/models/mail_scheduled_message.py:0
msgid "Edit Scheduled SMS"
msgstr "Chỉnh sửa SMS đã lên lịch"

#. module: sms
#. odoo-python
#: code:addons/sms/wizard/sms_composer.py:0
msgid "Impossible to determine the model for the template."
msgstr "Không thể xác định mô hình cho mẫu."

#. module: sms
#. odoo-python
#: code:addons/sms/models/sms_sms.py:0
