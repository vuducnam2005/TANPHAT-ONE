msgstr "Không đủ tín dụng để gửi SMS"

#. module: sms
#. odoo-python
#: code:addons/sms/wizard/sms_composer.py:0
msgid "Please provide a name for the template."
msgstr "Vui lòng cung cấp tên cho mẫu."

#. module: sms
#. odoo-python
#: code:addons/sms/wizard/sms_composer.py:0
msgid "Scheduling messages is only supported on mail.thread models."
msgstr "Lên lịch tin nhắn chỉ được hỗ trợ trên các mô hình mail.thread."

#. module: sms
#. odoo-python
#: code:addons/sms/models/ir_actions_server.py:0
msgid "Sending SMS can only be done on a not transient mail.thread model"
msgstr ""
"Việc gửi SMS chỉ có thể được thực hiện trên mô hình mail.thread không nhất "
"thời"
