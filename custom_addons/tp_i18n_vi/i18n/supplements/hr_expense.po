msgid "Expenses similar to %(other_expense_name)s"
msgstr "Chi phí tương tự %(other_expense_name)s"

#. module: hr_expense
#. odoo-python
#: code:addons/hr_expense/models/hr_expense.py:0
msgid "Go to Account"
msgstr "Đi tới Tài khoản"

#. module: hr_expense
#. odoo-python
#: code:addons/hr_expense/models/hr_expense.py:0
msgid "Go to expense(s)"
msgstr "Đi tới (các) chi phí"

#. module: hr_expense
#. odoo-python
#: code:addons/hr_expense/models/ir_actions_report.py:0
msgid "Multiple Managers"
msgstr "Nhiều người quản lý"

#. module: hr_expense
#. odoo-python
#: code:addons/hr_expense/models/ir_actions_report.py:0
msgid "Multiple employees"
msgstr "Nhiều nhân viên"

#. module: hr_expense
#. odoo-python
#: code:addons/hr_expense/models/ir_actions_report.py:0
msgid "Multiple payment modes"
msgstr "Nhiều chế độ thanh toán"

#. module: hr_expense
#. odoo-python
#: code:addons/hr_expense/models/ir_actions_report.py:0
msgid "No employee"
msgstr "Không có nhân viên"

#. module: hr_expense
#. odoo-python
#: code:addons/hr_expense/models/ir_actions_report.py:0
msgid "None (automatic)"
msgstr "Không có (tự động)"

#. module: hr_expense
#. odoo-python
#: code:addons/hr_expense/models/hr_expense_product_job_position_limit.py:0
msgid "Only one generic expense limit can be defined per product."
msgstr "Chỉ có thể xác định một giới hạn chi phí chung cho mỗi sản phẩm."

#. module: hr_expense
#. odoo-python
#: code:addons/hr_expense/models/hr_expense.py:0
msgid "Only submitted expenses exceeding a job position limit can be capped."
msgstr ""
"Chỉ những chi phí đã nộp vượt quá giới hạn vị trí công việc mới có thể bị "
"giới hạn."

#. module: hr_expense
#. odoo-python
#: code:addons/hr_expense/models/hr_expense.py:0
msgid ""
"Please specify if the expenses were paid by the company, reimbursed to the "
"employee directly, or in a payslip."
msgstr ""
"Vui lòng nêu rõ chi phí được công ty thanh toán, hoàn trả trực tiếp cho nhân"
" viên hay bằng phiếu lương."

#. module: hr_expense
#. odoo-javascript
#: code:addons/hr_expense/static/src/js/tours/hr_expense.js:0
msgid ""
"Ready? You can save it manually or discard modifications from here. You "
"don't <em>need to save</em> - Odoo will save everything for you when you "
"navigate."
msgstr ""
"Sẵn sàng chưa? Bạn có thể lưu thủ công hoặc loại bỏ các sửa đổi từ đây. Bạn "
"không cần lưu <em></em> - Odoo sẽ lưu mọi thứ cho bạn khi bạn điều hướng."

#. module: hr_expense
#. odoo-python
#: code:addons/hr_expense/models/hr_expense.py:0
msgid "Select a product to proceed."
msgstr "Chọn một sản phẩm để tiếp tục."

#. module: hr_expense
#. odoo-python
#: code:addons/hr_expense/models/hr_expense.py:0
msgid "Select an employee to proceed."
msgstr "Chọn một nhân viên để tiến hành."

#. module: hr_expense
#. odoo-python
#: code:addons/hr_expense/models/hr_expense.py:0
msgid "The account %(name)s (%(code)s) is archived. Activate it to continue"
msgstr ""
"Tài khoản %(name)s (%(code)s) đã được lưu trữ. Kích hoạt nó để tiếp tục"

#. module: hr_expense
#. odoo-python
#: code:addons/hr_expense/models/ir_actions_report.py:0
msgid ""
"The attachment (%(attachment_name)s) has not been added to the report due to"
" the following error: '%(error)s'"
msgstr ""
"Tệp đính kèm (%(attachment_name)s) chưa được thêm vào báo cáo do lỗi sau: "
"'%(error)s'"

#. module: hr_expense
#. odoo-python
#: code:addons/hr_expense/models/res_company.py:0
msgid "The employee expense journal must be a purchase journal."
msgstr "Nhật ký chi phí nhân viên phải là nhật ký mua hàng."

#. module: hr_expense
#. odoo-python
#: code:addons/hr_expense/models/hr_expense.py:0
msgid "The existing bill must be set."
msgstr "Hóa đơn hiện tại phải được thiết lập."

#. module: hr_expense
#. odoo-python
#: code:addons/hr_expense/models/hr_expense.py:0
msgid ""
"The following expenses payment method leads to several accounts payable and this isn't supported:\n"
"%(expenses)s"
msgstr ""
"Phương thức thanh toán chi phí sau đây dẫn đến một số tài khoản phải trả và phương thức này không được hỗ trợ:\n"
"%(expenses)s"

#. module: hr_expense
#. odoo-python
#: code:addons/hr_expense/models/hr_expense.py:0
msgid ""
"The vendor is required for expenses using SEPA Credit Transfer as the payment method.\n"
"Please set a vendor on the expenses."
msgstr ""
"Nhà cung cấp được yêu cầu thanh toán các chi phí sử dụng Chuyển khoản tín dụng SEPA làm phương thức thanh toán.\n"
"Vui lòng đặt nhà cung cấp về chi phí."

#. module: hr_expense
#. odoo-python
#: code:addons/hr_expense/models/product_product.py:0
msgid ""
"There are draft expenses linked to this product. Updating the product cost "
"will change expense amounts. Make sure it is what you want to do."
msgstr ""
"Có dự thảo chi phí liên quan đến sản phẩm này. Việc cập nhật giá sản phẩm sẽ"
" thay đổi số tiền chi phí. Hãy chắc chắn rằng đó là những gì bạn muốn làm."

#. module: hr_expense
#. odoo-python
#: code:addons/hr_expense/models/ir_actions_report.py:0
msgid "Unknown"
msgstr "Không xác định"

#. module: hr_expense
#. odoo-python
#: code:addons/hr_expense/models/hr_expense.py:0
msgid "You can't add an attachment to an expense once it has been approved."
msgstr "Bạn không thể thêm tệp đính kèm vào chi phí khi nó đã được phê duyệt."

#. module: hr_expense
#. odoo-python
#: code:addons/hr_expense/models/hr_expense.py:0
msgid ""
"You can't create move for employee-paid expenses belonging to different "
"companies at the same time"
msgstr ""
"Bạn không thể tạo động thái cho các chi phí do nhân viên trả của các công ty"
" khác nhau cùng một lúc"

#. module: hr_expense
#. odoo-python
#: code:addons/hr_expense/models/ir_attachment.py:0
msgid ""
"You can't delete attachments from an expense once it has been submitted."
msgstr ""
"Bạn không thể xóa phần đính kèm khỏi một khoản chi phí sau khi nó đã được "
"gửi."

#. module: hr_expense
#. odoo-python
#: code:addons/hr_expense/models/hr_expense.py:0
msgid "You cannot cancel an expense linked to a journal entry"
msgstr "Bạn không thể hủy một khoản chi phí liên quan đến một mục nhật ký"

#. module: hr_expense
#. odoo-python
#: code:addons/hr_expense/models/hr_expense.py:0
msgid ""
"You cannot refuse:\n"
"%(reasons)s"
msgstr ""
"Bạn không thể từ chối:\n"
"%(reasons)s"

#. module: hr_expense
#. odoo-python
#: code:addons/hr_expense/models/hr_expense.py:0
msgid "You cannot reset to draft an expense linked to a journal entry."
msgstr ""
"Bạn không thể đặt lại để soạn thảo một khoản chi phí được liên kết với một "
"mục nhật ký."

#. module: hr_expense
#. odoo-python
#: code:addons/hr_expense/models/hr_expense.py:0
msgid "You don't have the access rights to modify this expense."
msgstr "Bạn không có quyền truy cập để sửa đổi chi phí này."
