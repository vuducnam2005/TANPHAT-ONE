"An expense with the same product, amount, and date already exists.\n"
"Are you sure you want to submit this one as well?"
msgstr ""
"Đã tồn tại một khoản chi phí có cùng sản phẩm, số tiền và ngày tháng.\n"
"Bạn có chắc chắn muốn gửi cái này không?"

#. module: hr_expense
#. odoo-javascript
#: code:addons/hr_expense/static/src/js/tours/hr_expense.js:0
msgid "Click on all expenses"
msgstr "Bấm vào tất cả các chi phí"

#. module: hr_expense
#. odoo-python
#: code:addons/hr_expense/models/hr_expense.py:0
