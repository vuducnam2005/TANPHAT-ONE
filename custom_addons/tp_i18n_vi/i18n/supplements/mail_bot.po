#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/res_users.py:0
msgid "Go ahead - Try sending me an emoji 😊"
msgstr "Hãy tiếp tục - Hãy thử gửi cho tôi một biểu tượng cảm xúc 😊"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Great! You can customize %(bold_start)scanned responses%(bold_end)s in the "
"Discuss app settings."
msgstr ""
"Tuyệt vời! Bạn có thể tùy chỉnh các câu trả lời đóng hộp "
"%(bold_start)s%(bold_end)s trong cài đặt ứng dụng Thảo luận."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/res_users.py:0
msgid "Hello 👋"
msgstr "Xin chào 👋"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "Hmmm..."
msgstr "Ừm..."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"It looks like you're not sure what to do next. Please type "
"%(command_start)s/%(command_end)s to see the suggestions, then select "
"%(command_start)shelp%(command_end)s and press Enter."
msgstr ""
"Có vẻ như bạn không chắc chắn phải làm gì tiếp theo. Hãy gõ "
"%(command_start)s/%(command_end)s để xem gợi ý, sau đó chọn "
"%(command_start)shelp%(command_end)s rồi nhấn Enter."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Not quite. To continue the tour, please send an emoji by typing "
"%(command_start)s:)%(command_end)s and pressing Enter, or by clicking the "
"%(smile_icon)s icon to pick one."
msgstr ""
"Không hẳn. Để tiếp tục chuyến tham quan, vui lòng gửi biểu tượng cảm xúc "
"bằng cách nhập %(command_start)s:)%(command_end)s và nhấn Enter hoặc bằng "
"cách nhấp vào biểu tượng %(smile_icon)s để chọn một biểu tượng."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Not sure what you're doing? Please type %(command_start)s::%(command_end)s "
"to see canned responses. Select one and press Enter."
msgstr ""
"Bạn không chắc mình đang làm gì? Vui lòng nhập "
"%(command_start)s::%(command_end)s để xem các câu trả lời soạn sẵn. Chọn một"
" và nhấn Enter."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/res_users.py:0
msgid ""
"Odoo's Discuss application helps employees collaborate efficiently. I'm here"
" to help you explore its features."
msgstr ""
"Ứng dụng Thảo luận của Odoo giúp nhân viên cộng tác hiệu quả. Tôi ở đây để "
"giúp bạn khám phá các tính năng của nó."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Sorry, I'm not listening right now. To get my attention, "
"%(bold_start)smention me%(bold_end)s by typing "
"%(command_start)s@OdooBot%(command_end)s and selecting me."
msgstr ""
"Xin lỗi, bây giờ tôi không nghe. Để thu hút sự chú ý của tôi, "
"%(bold_start)sđề cập đến me%(bold_end)s bằng cách nhập "
"%(command_start)s@OdooBot%(command_end)s và chọn tôi."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"That's the end of this overview. You can %(bold_start)sclose this "
"conversation%(bold_end)s or type %(command_start)sstart the "
"tour%(command_end)s to see it again. Enjoy exploring Odoo!"
msgstr ""
"Đó là sự kết thúc của tổng quan này. Bạn có thể %(bold_start)sđóng cuộc trò "
"chuyện này%(bold_end)s hoặc gõ %(command_start)sbắt đầu chuyến tham "
"quan%(command_end)s để xem lại. Tận hưởng khám phá Odoo!"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"To %(bold_start)ssend an attachment%(bold_end)s, first click the "
"%(plus_icon)s icon, then select %(paperclip_icon)s Attach files."
msgstr ""
"Để %(bold_start)sgửi tệp đính kèm%(bold_end)s, trước tiên hãy nhấp vào biểu "
"tượng %(plus_icon)s, sau đó chọn %(paperclip_icon)s Đính kèm tệp."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "To get started, try sending me an emoji 😊"
msgstr "Để bắt đầu, hãy thử gửi cho tôi một biểu tượng cảm xúc 😊"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"To use special commands, %(bold_start)sstart your message with a "
"%(bold_end)s %(command_start)s/%(command_end)s. For example, try typing "
"%(command_start)s/help%(command_end)s."
msgstr ""
"Để sử dụng các lệnh đặc biệt, %(bold_start)sbắt đầu tin nhắn của bạn bằng "
"%(bold_end)s %(command_start)s/%(command_end)s. Ví dụ: thử gõ "
"%(command_start)s/help%(command_end)s."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Unfortunately, I'm just a bot 😞 I don't understand that.%(new_line)sIf you "
"need help exploring our apps, please check out %(document_link_start)sour "
"documentation%(document_link_end)s or %(slides_link_start)sour "
"videos%(slides_link_end)s."
msgstr ""
"Thật không may, tôi chỉ là một bot 😞 Tôi không hiểu điều đó.%(new_line)sNếu "
"bạn cần trợ giúp khám phá các ứng dụng của chúng tôi, vui lòng xem "
"%(document_link_start)stài liệu của chúng tôi%(document_link_end)s hoặc "
"%(slides_link_start)svideo của chúng tôi%(slides_link_end)s."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Wonderful! 😇%(new_line)sTry typing %(command_start)s::%(command_end)s to use"
" canned responses. I've created a temporary one just for you."
msgstr ""
"Tuyệt vời! 😇%(new_line)sHãy thử gõ %(command_start)s::%(command_end)s để sử "
"dụng câu trả lời soạn sẵn. Tôi đã tạo một cái tạm thời chỉ dành cho bạn."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Wow, you're a natural!%(new_line)s Use @username to mention someone and grab"
" their attention.%(new_line)s %(bold_start)sTry mentioning me by "
"typing%(bold_end)s %(command_start)s@OdooBot%(command_end)s in your message."
msgstr ""
"Ồ, bạn thật tài tình!%(new_line)s Sử dụng @username để đề cập đến ai đó và "
"thu hút sự chú ý của họ.%(new_line)s %(bold_start)sHãy thử nhắc đến tôi bằng"
" cách gõ%(bold_end)s %(command_start)s@OdooBot%(command_end)s trong tin nhắn"
" của bạn."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Yep, I'm here! 🎉 %(new_line)sNow, try %(bold_start)ssending an "
"attachment%(bold_end)s 📎 - maybe a picture of your cute dog... 🐕"
msgstr ""
"Vâng, tôi ở đây! 🎉 %(new_line)sBây giờ, hãy thử %(bold_start)sgửi tệp đính "
"kèm%(bold_end)s 📎 - có thể là hình ảnh chú chó dễ thương của bạn... 🐕"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "fuck"
msgstr "chết tiệt"
