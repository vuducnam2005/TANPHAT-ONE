<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="tp_hr_attendance.MyProfile" t-inherit="tp_hr_workspace.MyProfile" t-inherit-mode="extension">
    <xpath expr="//div[hasclass('tab-content')]" position="inside">
        <div t-if="this.state.activeTab === 'attendance'" class="tab-pane active show"><MyAttendance embedded="true"/></div>
    </xpath>
</t>
<t t-name="tp_hr_attendance.Mine">
<section class="o_tp_att o_tp_att_mine" t-att-class="{'o_tp_att_embedded': this.props.embedded}" aria-label="Công của tôi" t-att-aria-busy="this.state.loading ? 'true' : 'false'">
    <div t-if="this.state.error" class="alert alert-danger" role="alert"><t t-out="this.state.error"/> <button class="btn btn-link p-0" t-on-click="this.load">Thử lại</button></div>
    <p t-elif="!this.data" role="status" class="o_tp_att_loading">Đang tải công cá nhân…</p>
    <div t-elif="!this.data.has_employee" class="alert alert-info" t-out="this.data.message"/>
    <t t-else="">
        <header class="o_tp_att_header">
            <div>
                <h1 t-if="!this.props.embedded">Công của tôi</h1>
                <p class="o_tp_att_subtitle"><t t-out="this.data.employee.name"/> · <t t-out="this.data.employee.code or 'Chưa có mã'"/> · <t t-out="this.data.employee.department or 'Chưa có phòng ban'"/></p>
            </div>
            <div class="o_tp_att_actions">
                <button type="button" class="btn btn-outline-primary" t-on-click="this.exportOwn"><i class="oi me-1" data-icon="download" aria-hidden="true"/>Xuất Excel</button>
                <button type="button" class="btn btn-outline-secondary" t-on-click="this.openRequests">Yêu cầu của tôi</button>
                <button type="button" class="btn btn-light" t-on-click="this.openRequest">Đề nghị điều chỉnh</button>
            </div>
        </header>
        <section class="o_tp_att_toolbar" aria-label="Chọn kỳ">
            <div class="o_tp_att_segment" role="group" aria-label="Chế độ xem">
                <button t-foreach="this.modes" t-as="mode" t-key="mode[0]" type="button" t-att-class="{'active': this.state.mode === mode[0]}"
                    t-att-aria-pressed="this.state.mode === mode[0] ? 'true' : 'false'" t-on-click="() => this.setMode(mode[0])" t-out="mode[1]"/>
                <button type="button" t-att-class="{'active': this.state.mode === 'range'}" t-att-aria-expanded="this.state.fileMenu ? 'true' : 'false'"
                    t-on-click="() => this.state.fileMenu = !this.state.fileMenu">Kỳ theo file</button>
            </div>
            <div class="o_tp_att_period">
                <button type="button" class="o_tp_att_icon_btn" t-on-click="() => this.step(-1)" aria-label="Kỳ trước"><i class="oi" data-icon="chevron_backward" aria-hidden="true"/></button>
                <input t-if="this.state.mode === 'month'" type="month" t-att-value="this.data.start.slice(0, 7)" t-on-change="this.onMonth" aria-label="Chọn tháng"/>
                <input t-elif="this.state.mode === 'week'" type="date" t-att-value="this.state.date" t-on-change="this.onDate" aria-label="Chọn một ngày trong tuần (T2–CN)"/>
                <span t-else="" class="o_tp_att_badge o_info" t-out="this.data.period_label"/>
                <button type="button" class="o_tp_att_icon_btn" t-on-click="() => this.step(1)" aria-label="Kỳ sau"><i class="oi" data-icon="chevron_forward" aria-hidden="true"/></button>
                <button type="button" class="btn btn-light" t-on-click="this.goToday">Hôm nay</button>
            </div>
        </section>
        <div t-if="this.state.fileMenu" class="o_tp_att_file_menu" role="menu" aria-label="Kỳ theo tệp đã nhập">
            <p t-if="!this.data.file_periods.length" class="o_tp_att_muted">Chưa có tệp Excel máy nào được nhập.</p>
            <button t-foreach="this.data.file_periods" t-as="item" t-key="item.from + item.to" type="button" role="menuitem"
                t-att-class="{'active': this.state.mode === 'range' and this.state.from === item.from and this.state.to === item.to}"
                t-on-click="() => this.openFilePeriod(item)"><strong t-out="item.label"/></button>
        </div>
        <SourceStrip source="this.data.source"/>
        <PersonDetail data="this.data"/>
    </t>
</section>
</t>
</templates>
