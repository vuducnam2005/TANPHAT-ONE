<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="tp_hr_attendance.Sources">
<div class="o_tp_att o_tp_att_sources" aria-label="Nguồn dữ liệu chấm công" t-att-aria-busy="this.state.loading ? 'true' : 'false'">
    <header class="o_tp_att_header">
        <div>
            <h1>Nguồn dữ liệu chấm công</h1>
            <p class="o_tp_att_subtitle">Giờ làm tham chiếu <strong t-out="this.referenceHours"/> (chỉ để hiển thị) · Số đi muộn lấy nguyên từ Excel máy theo đúng kỳ</p>
        </div>
        <div class="o_tp_att_actions">
            <button type="button" class="btn btn-outline-secondary" t-on-click="() => this.open('tp_hr_attendance.action_late')">Tổng đi muộn theo kỳ</button>
            <button type="button" class="btn btn-primary" t-on-click="this.openUpload"><i class="oi me-1" data-icon="upload_file" aria-hidden="true"/>Nhập Excel máy chấm công</button>
        </div>
    </header>

    <div t-if="this.state.error" class="alert alert-danger" role="alert"><t t-out="this.state.error"/> <button class="btn btn-link p-0" t-on-click="this.load">Thử lại</button></div>
    <p t-elif="!this.data" role="status" class="o_tp_att_loading">Đang tải nguồn dữ liệu…</p>
    <t t-else="">
        <section class="o_tp_att_source_cards" aria-label="Trạng thái nguồn">
            <article class="o_tp_att_source_card" t-att-class="this.data.excel.in_use ? 'o_ok' : 'o_muted'">
                <header>
                    <i class="oi" data-icon="description" aria-hidden="true"/>
                    <h2>Excel máy chấm công</h2>
                    <span class="o_tp_att_badge" t-att-class="this.data.excel.in_use ? 'o_ok' : 'o_muted'" t-out="this.data.excel.in_use ? 'Đang dùng' : 'Chưa có tệp đã nhập'"/>
                </header>
                <dl>
                    <div><dt>Lô đã ghi</dt><dd t-out="this.data.excel.batches"/></div>
                    <div><dt>Dữ liệu đến</dt><dd t-out="this.data.excel.data_to or '—'"/></div>
                    <div><dt>Cập nhật</dt><dd t-out="this.data.excel.updated_at or '—'"/></div>
                    <div><dt>Tệp gần nhất</dt><dd class="o_tp_att_source_file" t-att-title="this.data.excel.file" t-out="this.data.excel.file or '—'"/></div>
                </dl>
                <p class="o_tp_att_muted" t-out="this.data.excel.note"/>
            </article>
            <article class="o_tp_att_source_card" t-att-class="this.data.api.enti &amp;&amp; this.data.api.enti.live ? 'o_ok' : 'o_muted'">
                <header>
                    <i class="oi" t-att-data-icon="this.data.api.enti &amp;&amp; this.data.api.enti.live ? 'cloud_done' : 'cloud_off'" aria-hidden="true"/>
                    <h2>API chấm công ENTI (enti.vn)</h2>
                    <span class="o_tp_att_badge" t-att-class="this.data.api.enti &amp;&amp; this.data.api.enti.live ? 'o_ok' : 'o_muted'" t-out="this.data.api.label"/>
                </header>
                <dl>
                    <div><dt>Kết nối trực tiếp</dt><dd t-out="this.data.api.enti &amp;&amp; this.data.api.enti.live ? 'Bật (Tự động)' : 'Tắt'"/></div>
                    <div><dt>Lịch tự đồng bộ</dt><dd t-out="this.data.api.enti &amp;&amp; this.data.api.enti.live ? '1 phút / lần' : 'Tắt'"/></div>
                    <div><dt>Đã khớp nhân viên</dt><dd t-out="this.data.api.enti ? this.data.api.enti.mapped_count : 0"/></div>
                    <div><dt>Chờ đối chiếu</dt><dd t-out="this.data.api.enti ? this.data.api.enti.unmapped_count : 0"/></div>
                    <div><dt>Ngày công đã lấy</dt><dd t-out="this.data.api.enti ? this.data.api.enti.days_count : 0"/></div>
                    <div><dt>Dữ liệu đến ngày</dt><dd t-out="(this.data.api.enti &amp;&amp; this.data.api.enti.data_to) || '—'"/></div>
                    <div><dt>Lần lấy gần nhất</dt><dd t-out="(this.data.api.enti &amp;&amp; this.data.api.enti.last_success_at) || '—'"/></div>
                </dl>
                <p t-if="this.data.api.enti &amp;&amp; this.data.api.enti.last_error" class="text-danger small mb-2">
                    Lỗi lần trước: <t t-out="this.data.api.enti.last_error"/>
                </p>
                <p class="o_tp_att_muted">Kết nối trực tiếp với dịch vụ chấm công ENTI qua API backend. Tự động lấy giờ vào/ra, đối chiếu với hồ sơ nhân viên Odoo và cập nhật bảng công chuẩn.</p>
                <div class="o_tp_att_actions">
                    <button t-if="this.data.can_configure" type="button" class="btn btn-primary btn-sm" t-on-click="this.syncEntiNow" t-att-disabled="this.state.loading"><i class="oi me-1" data-icon="sync" aria-hidden="true"/>Đồng bộ ngay</button>
                    <button t-if="this.data.can_configure" type="button" class="btn btn-outline-secondary btn-sm" t-on-click="() => this.open('tp_hr_attendance.action_enti_mapping')">Đối chiếu nhân viên</button>
                    <button t-if="this.data.can_configure" type="button" class="btn btn-outline-secondary btn-sm" t-on-click="() => this.open('tp_hr_attendance.action_enti_config')">Cấu hình kết nối</button>
                    <button type="button" class="btn btn-link btn-sm" t-on-click="() => this.open('tp_hr_attendance.action_enti_logs')">Nhật ký đồng bộ</button>
                </div>
            </article>
        </section>

        <section class="o_tp_att_panel" aria-labelledby="tp_att_checklist">
            <h2 id="tp_att_checklist">Cần hãng máy cung cấp trước khi kết nối API</h2>
            <ol class="o_tp_att_checklist">
                <li t-foreach="this.data.checklist" t-as="item" t-key="item.key" t-out="item.label"/>
            </ol>
        </section>

        <section class="o_tp_att_panel" aria-labelledby="tp_att_history">
            <div class="o_tp_att_drill_head">
                <h2 id="tp_att_history">Lịch sử nhập</h2>
                <button type="button" class="btn btn-link btn-sm" t-on-click="() => this.open('tp_hr_attendance.action_import')">Xem tất cả lô nhập</button>
            </div>
            <div class="o_tp_att_table_wrap">
                <table class="o_tp_att_table o_tp_att_history">
                    <thead><tr><th scope="col">Thời điểm</th><th scope="col">Người nhập</th><th scope="col">Tệp</th><th scope="col">Kỳ</th><th scope="col">Kết quả</th><th scope="col" class="o_num">Cần xem</th></tr></thead>
                    <tbody>
                        <tr t-if="!this.data.history.length"><td colspan="6" class="o_tp_att_empty">Chưa có lần nhập nào.</td></tr>
                        <tr t-foreach="this.data.history" t-as="row" t-key="row.id" class="o_tp_att_click" tabindex="0"
                            t-on-click="() => this.openBatch(row)" t-on-keydown="(ev) => ev.key === 'Enter' and this.openBatch(row)">
                            <th scope="row" data-label="Thời điểm" t-out="row.at"/>
                            <td data-label="Người nhập" t-out="row.user or '—'"/>
                            <td data-label="Tệp" class="o_tp_att_source_file" t-att-title="row.file" t-out="row.file or '—'"/>
                            <td data-label="Kỳ" t-out="row.period or '—'"/>
                            <td data-label="Kết quả"><span class="o_tp_att_badge" t-att-class="row.state === 'applied' ? 'o_ok' : (row.state === 'preview' ? 'o_info' : 'o_muted')" t-out="row.state_label"/> <t t-out="row.result"/></td>
                            <td data-label="Cần xem" class="o_num" t-out="row.attention or '—'"/>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>
    </t>
</div>
</t>
</templates>
