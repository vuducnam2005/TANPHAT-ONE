<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="tp_hr_attendance.Sources">
<div class="o_tp_att o_tp_att_sources o_tp_att_admin" aria-label="Quản trị chấm công" t-att-aria-busy="this.state.loading ? 'true' : 'false'">
    <header class="o_tp_att_admin_heading">
        <h1>Quản trị chấm công</h1>
    </header>

    <InlineErrors errors="[]" server="this.state.serverError" attempt="this.state.attempt"/>
    <div t-if="this.state.serverError and !this.data" class="mb-2">
        <button type="button" class="btn btn-outline-secondary btn-sm" t-on-click="() => this.load()">Thử lại</button>
    </div>
    <div t-if="this.state.notice" class="alert alert-success d-flex justify-content-between align-items-start gap-2" role="status">
        <span t-out="this.state.notice"/>
        <button type="button" class="btn-close" aria-label="Đóng thông báo" t-on-click="() => this.state.notice = ''"/>
    </div>
    <p t-if="!this.data and !this.state.serverError" role="status" class="o_tp_att_loading">Đang tải quản trị chấm công…</p>
    <t t-if="this.data">
        <section class="o_tp_att_admin_connection" aria-label="Kết nối chấm công">
            <div class="o_tp_att_admin_connection_head">
                <div>
                    <h2>Kết nối chấm công</h2>
                    <span class="o_tp_att_admin_health" t-att-class="'o_' + this.health.tone" t-out="this.health.text"/>
                </div>
                <div class="o_tp_att_admin_actions" t-if="this.data.can_configure">
                    <button type="button" class="btn btn-outline-secondary" t-on-click="() => this.open('tp_hr_attendance.action_enti_config')">Cấu hình kết nối</button>
                    <button type="button" class="btn btn-primary" t-on-click="this.syncEntiNow" t-att-disabled="this.state.syncing">
                        <i class="oi me-1" data-icon="autorenew" aria-hidden="true"/>
                        <t t-out="this.state.syncing ? 'Đang đồng bộ…' : 'Đồng bộ ngay'"/>
                    </button>
                </div>
            </div>
            <dl class="o_tp_att_admin_metrics">
                <div><dt>Đồng bộ thành công gần nhất</dt><dd class="o_stamp" t-out="this.enti.last_success_at or 'Chưa có'"/></div>
                <div><dt>Thời lượng lượt gần nhất</dt><dd t-out="this.enti.last_duration_seconds != null ? (this.enti.last_duration_seconds + ' giây') : '—'"/></div>
                <div><dt>Bản ghi ngày công đã nhận</dt><dd t-out="this.enti.days_count ?? '—'"/></div>
                <div><dt>Nhân viên đã khớp</dt><dd t-out="this.enti.mapped_count ?? '—'"/></div>
                <div><dt>Nhân viên cần đối chiếu</dt><dd class="o_attention" t-out="this.enti.unmapped_count ?? '—'"/></div>
            </dl>
            <p t-if="this.enti.data_to" class="o_tp_att_admin_data_to">Dữ liệu máy đã nhận đến ngày <strong t-out="this.enti.data_to"/>.</p>
            <p t-if="this.enti.last_error" class="o_tp_att_admin_data_to text-danger" t-out="this.enti.last_error"/>
        </section>

        <section class="o_tp_att_admin_panel o_tp_att_admin_images" aria-labelledby="tp_att_admin_images_title">
            <header>
                <div>
                    <h2 id="tp_att_admin_images_title">Nguồn dữ liệu ENTI — Đồng bộ ảnh hồ sơ nhân viên</h2>
                    <div class="d-flex flex-wrap align-items-center gap-2 mt-1">
                        <span class="o_tp_att_admin_health mt-0" t-att-class="'o_' + this.imageHealth.tone" t-out="this.imageHealth.text"/>
                        <span t-if="this.imageSync.last_sync_at" class="text-muted small">
                            Lần đồng bộ gần nhất: <strong t-out="this.imageSync.last_sync_at"/>
                        </span>
                        <span t-else="" class="text-muted small">Lần đồng bộ gần nhất: <strong>Chưa có</strong></span>
                    </div>
                </div>
                <div class="o_tp_att_admin_actions align-items-center" t-if="this.data.can_configure">
                    <label class="form-check form-switch mb-0 me-2 d-inline-flex align-items-center gap-2">
                        <input class="form-check-input" type="checkbox"
                            t-att-checked="this.imageSync.prefer_manual_image"
                            t-on-change="(ev) => this.togglePreferManualImage(ev)"/>
                        <span class="form-check-label small">Ưu tiên ảnh thủ công</span>
                    </label>
                    <button type="button" class="btn btn-outline-secondary"
                        t-on-click="() => this.open('tp_hr_attendance.action_enti_employee_images')">
                        Mở bảng chi tiết
                    </button>
                    <button type="button" class="btn btn-outline-warning"
                        t-on-click="() => this.syncEntiImages({ onlyFailed: true })"
                        t-att-disabled="this.state.imageSyncing or this.state.imageRetrying">
                        <i class="oi me-1" data-icon="refresh" aria-hidden="true"/>
                        <t t-out="this.state.imageRetrying ? 'Đang thử lại…' : 'Đồng bộ lại ảnh lỗi'"/>
                    </button>
                    <button type="button" class="btn btn-primary"
                        t-on-click="() => this.syncEntiImages({ onlyFailed: false })"
                        t-att-disabled="this.state.imageSyncing or this.state.imageRetrying">
                        <i class="oi me-1" data-icon="autorenew" aria-hidden="true"/>
                        <t t-out="this.state.imageSyncing ? 'Đang đồng bộ ảnh…' : 'Đồng bộ ảnh hồ sơ'"/>
                    </button>
                </div>
            </header>

            <dl class="o_tp_att_admin_metrics">
                <div><dt>Tổng số nhân viên ENTI</dt><dd t-out="this.imageSync.total_employees ?? 0"/></div>
                <div><dt>Số ảnh đã đồng bộ</dt><dd t-out="this.imageSync.synced_count ?? 0"/></div>
                <div><dt>Số ảnh chưa có</dt><dd t-out="this.imageSync.no_image_count ?? 0"/></div>
                <div><dt>Số ảnh lỗi</dt><dd class="o_attention" t-out="this.imageSync.failed_count ?? 0"/></div>
                <div><dt>Số nhân viên chưa đối chiếu</dt><dd class="o_attention" t-out="this.imageSync.unmapped_count ?? 0"/></div>
            </dl>
            <p t-if="this.imageSync.message" class="o_tp_att_admin_data_to" t-out="this.imageSync.message"/>

            <div class="o_tp_att_image_log_controls mt-3">
                <label class="o_tp_att_field">
                    <span>Trạng thái ảnh</span>
                    <select t-on-change="(ev) => { this.state.imageState = ev.target.value; this.applyImageFilters(); }">
                        <option value="" t-att-selected="!this.state.imageState">Tất cả trạng thái</option>
                        <option value="synced" t-att-selected="this.state.imageState === 'synced'">Đã đồng bộ</option>
                        <option value="downloaded" t-att-selected="this.state.imageState === 'downloaded'">Đã tải mới</option>
                        <option value="unchanged" t-att-selected="this.state.imageState === 'unchanged'">Không thay đổi</option>
                        <option value="no_image" t-att-selected="this.state.imageState === 'no_image'">Chưa có ảnh</option>
                        <option value="failed" t-att-selected="this.state.imageState === 'failed'">Lỗi tải ảnh</option>
                        <option value="unmapped" t-att-selected="this.state.imageState === 'unmapped'">Chưa đối chiếu</option>
                    </select>
                </label>
                <label class="o_tp_att_field">
                    <span>Phòng ban</span>
                    <select t-on-change="(ev) => { this.state.imageDepartment = ev.target.value; this.applyImageFilters(); }">
                        <option value="" t-att-selected="!this.state.imageDepartment">Tất cả phòng ban</option>
                        <option t-foreach="this.data.departments or []" t-as="dept" t-key="dept.id"
                            t-att-value="dept.id"
                            t-att-selected="'' + dept.id === '' + this.state.imageDepartment"
                            t-out="dept.name"/>
                    </select>
                </label>
                <label class="o_tp_att_field">
                    <span>Nhân viên</span>
                    <input type="search" placeholder="Tìm theo tên hoặc mã nhân viên…"
                        t-att-value="this.state.imageSearch"
                        t-on-input="(ev) => { this.state.imageSearch = ev.target.value; }"
                        t-on-change="() => this.applyImageFilters()"/>
                </label>
                <button type="button" class="btn btn-outline-secondary"
                    t-on-click="() => this.applyImageFilters()"
                    t-att-disabled="this.state.imageFiltering">
                    Lọc nhật ký
                </button>
            </div>

            <p t-if="!this.imageSync.rows?.length" class="o_tp_att_admin_empty mt-3">
                Chưa có bản ghi nhật ký đồng bộ ảnh phù hợp với bộ lọc.
            </p>
            <div t-else="" class="o_tp_att_image_table_wrap mt-3">
                <table class="table table-sm align-middle mb-0 o_tp_att_image_table">
                    <thead>
                        <tr>
                            <th>Ảnh ENTI / Odoo</th>
                            <th>Nhân viên ENTI</th>
                            <th>Nhân viên Odoo</th>
                            <th>Phòng ban</th>
                            <th>Trạng thái</th>
                            <th>Đồng bộ lúc</th>
                            <th>Ghi chú / Lỗi</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="this.imageSync.rows" t-as="imgRow" t-key="imgRow.id">
                            <td data-label="Ảnh ENTI / Odoo">
                                <div class="o_tp_att_image_pair">
                                    <img t-if="imgRow.has_enti_image"
                                        t-att-src="'/web/image/tp.hr.attendance.enti.employee.image/' + imgRow.id + '/enti_image_128'"
                                        alt="Ảnh ENTI" title="Ảnh từ ENTI" class="o_tp_att_thumb"/>
                                    <span t-else="" class="o_tp_att_thumb_empty" title="Chưa có ảnh ENTI">—</span>
                                    <img t-if="imgRow.has_odoo_image"
                                        t-att-src="'/web/image/hr.employee/' + imgRow.employee_id + '/image_128'"
                                        alt="Ảnh Odoo" title="Ảnh hiện tại trong Odoo" class="o_tp_att_thumb"/>
                                    <span t-else="" class="o_tp_att_thumb_empty" title="Chưa đối chiếu Odoo">—</span>
                                </div>
                            </td>
                            <td data-label="Nhân viên ENTI">
                                <strong t-out="imgRow.ten_nv or '—'"/>
                                <div t-if="imgRow.ma_nv" class="text-muted small" t-out="imgRow.ma_nv"/>
                            </td>
                            <td data-label="Nhân viên Odoo">
                                <t t-if="imgRow.employee_id">
                                    <strong t-out="imgRow.employee_name"/>
                                    <div t-if="imgRow.employee_code" class="text-muted small" t-out="imgRow.employee_code"/>
                                </t>
                                <span t-else="" class="text-warning fw-semibold">Chưa đối chiếu</span>
                            </td>
                            <td data-label="Phòng ban" t-out="imgRow.department_name or '—'"/>
                            <td data-label="Trạng thái">
                                <span class="o_tp_att_badge"
                                    t-att-class="(imgRow.mapping_state === 'mapped' and (imgRow.state === 'downloaded' or imgRow.state === 'unchanged')) ? 'o_ok' : (imgRow.state === 'failed' ? 'o_warn' : 'o_muted')"
                                    t-out="imgRow.status_label"/>
                            </td>
                            <td data-label="Đồng bộ lúc" t-out="imgRow.downloaded_at or imgRow.last_seen_at or '—'"/>
                            <td data-label="Ghi chú / Lỗi" class="small text-muted" t-out="imgRow.error_message or (imgRow.image_mime ? (imgRow.image_mime + ' · ' + imgRow.image_size + ' B') : '—')"/>
                            <td data-label="Thao tác" class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <button type="button" class="btn btn-sm btn-outline-secondary"
                                        t-on-click="() => this.openImageRecord(imgRow)">
                                        Xem ảnh
                                    </button>
                                    <button t-if="this.data.can_configure and imgRow.mapping_state === 'mapped' and imgRow.has_enti_image"
                                        type="button" class="btn btn-sm btn-outline-primary"
                                        t-on-click="() => this.applyRowImage(imgRow)">
                                        Cập nhật
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <section t-if="this.data.can_export" class="o_tp_att_admin_panel o_tp_att_admin_export" aria-labelledby="tp_att_admin_export_title">
            <header>
                <div>
                    <h2 id="tp_att_admin_export_title">Xuất bảng công</h2>
                    <p>Tải tệp .xlsx gồm bảng giờ vào/ra và chi tiết theo ngày.</p>
                </div>
            </header>
            <form class="o_tp_att_admin_export_fields" t-on-submit.prevent="this.exportSheet">
                <label class="o_tp_att_field"><span>Kỳ xuất</span>
                    <select t-on-change="(ev) => this.state.mode = ev.target.value">
                        <option value="week" t-att-selected="this.state.mode === 'week'">Tuần</option>
                        <option value="month" t-att-selected="this.state.mode === 'month'">Tháng</option>
                        <option value="range" t-att-selected="this.state.mode === 'range'">Khoảng ngày</option>
                    </select>
                </label>
                <label class="o_tp_att_field" t-if="this.state.mode === 'month'"><span>Chọn tháng</span>
                    <input type="month" t-att-value="this.state.date.slice(0, 7)"
                        t-on-change="(ev) => this.state.date = ev.target.value ? ev.target.value + '-01' : ''"/>
                </label>
                <label class="o_tp_att_field" t-elif="this.state.mode === 'week'"><span>Ngày trong tuần cần xuất</span>
                    <input type="date" t-att-value="this.state.date" t-on-change="(ev) => this.state.date = ev.target.value"/>
                </label>
                <t t-else="">
                    <label class="o_tp_att_field"><span>Từ ngày</span>
                        <input type="date" t-att-value="this.state.from" t-on-change="(ev) => this.state.from = ev.target.value"/>
                    </label>
                    <label class="o_tp_att_field"><span>Đến ngày</span>
                        <input type="date" t-att-value="this.state.to" t-on-change="(ev) => this.state.to = ev.target.value"/>
                    </label>
                </t>
                <label class="o_tp_att_field"><span>Phòng ban</span>
                    <select t-on-change="(ev) => this.state.department = ev.target.value">
                        <option value="" t-att-selected="!this.state.department">Tất cả phòng ban</option>
                        <option t-foreach="this.data.departments or []" t-as="department" t-key="department.id" t-att-value="department.id"
                            t-att-selected="'' + department.id === this.state.department" t-out="department.name"/>
                    </select>
                </label>
                <button type="submit" class="btn btn-primary" t-att-disabled="this.state.exporting">
                    <i class="oi me-1" data-icon="download" aria-hidden="true"/>
                    <t t-out="this.state.exporting ? 'Đang xuất…' : 'Tải tệp .xlsx'"/>
                </button>
            </form>
            <div class="mt-2">
                <InlineErrors errors="this.state.exportErrors" server="this.state.exportServerError" attempt="this.state.exportAttempt"/>
            </div>
        </section>

        <div class="o_tp_att_admin_grid">
            <section class="o_tp_att_admin_panel" aria-labelledby="tp_att_unmapped">
                <header>
                    <div>
                        <h2 id="tp_att_unmapped">Cần đối chiếu nhân viên</h2>
                        <p t-if="this.unmapped.length">Hiển thị <t t-out="this.unmapped.length"/> / <t t-out="this.enti.unmapped_count"/> người cần đối chiếu</p>
                    </div>
                    <button type="button" class="btn btn-outline-secondary" t-on-click="() => this.open('tp_hr_attendance.action_enti_mapping')">Mở đối chiếu</button>
                </header>
                <div class="o_tp_att_admin_actions" t-if="this.enti.unmapped_count">
                    <button type="button" class="btn btn-light" t-on-click="() => this.open('tp_hr_attendance.action_enti_mapping', {search_default_state_suggested: 1})">
                        Chờ xác nhận <strong t-out="this.data.mapping?.suggested ?? '—'"/>
                    </button>
                    <button type="button" class="btn btn-light" t-on-click="() => this.open('tp_hr_attendance.action_enti_mapping', {search_default_state_unmapped: 1})">
                        Chưa khớp <strong t-out="this.data.mapping?.unmapped ?? '—'"/>
                    </button>
                </div>
                <p t-if="!this.unmapped.length" class="o_tp_att_admin_empty">Chưa có nhân viên cần đối chiếu.</p>
                <ul t-else="" class="o_tp_att_admin_rows">
                    <li t-foreach="this.unmapped" t-as="row" t-key="row.id">
                        <div class="o_tp_att_admin_row_head">
                            <strong t-out="row.name or row.code or 'Chưa có tên'"/>
                            <span class="o_tp_att_badge" t-att-class="row.state === 'suggested' ? 'o_info' : 'o_warn'" t-out="row.state_label"/>
                        </div>
                        <p t-if="row.code or row.department"><t t-out="row.code"/><t t-if="row.code and row.department"> · </t><t t-out="row.department"/></p>
                        <p t-if="row.candidate">Đề xuất <strong t-out="row.candidate"/></p>
                        <p t-if="row.reason" t-out="row.reason"/>
                    </li>
                </ul>
            </section>

            <section t-if="this.data.can_view_logs" class="o_tp_att_admin_panel" aria-labelledby="tp_att_sync_logs">
                <header>
                    <div>
                        <h2 id="tp_att_sync_logs">Đồng bộ gần đây</h2>
                        <p t-if="this.data.sync_logs?.length">Hiển thị <t t-out="this.data.sync_logs.length"/> lượt gần nhất</p>
                    </div>
                    <button type="button" class="btn btn-outline-secondary" t-on-click="() => this.open('tp_hr_attendance.action_enti_logs')">Mở nhật ký</button>
                </header>
                <p t-if="!this.data.sync_logs?.length" class="o_tp_att_admin_empty">Chưa có lượt đồng bộ.</p>
                <ul t-else="" class="o_tp_att_admin_rows">
                    <li t-foreach="this.data.sync_logs" t-as="row" t-key="row.id">
                        <div class="o_tp_att_admin_row_head">
                            <strong t-out="row.at"/>
                            <span class="o_tp_att_badge" t-att-class="row.status === 'success' ? 'o_ok' : ((row.status === 'error' or row.status === 'partial') ? 'o_warn' : 'o_muted')" t-out="row.status_label"/>
                        </div>
                        <p>
                            Đã nhận <strong t-out="row.days_received"/> · Đã cập nhật <strong t-out="row.days_applied"/>
                            <t t-if="row.duration_seconds != null"> · Thời lượng <strong t-out="row.duration_seconds"/>s</t>
                        </p>
                        <p t-if="row.unmapped">Chưa khớp <strong t-out="row.unmapped"/> nhân viên</p>
                        <p t-if="row.has_warning" class="text-warning small mb-0">
                            <t t-if="row.kept_count">Giữ nguyên <strong t-out="row.kept_count"/> dòng thuộc kỳ chốt / điều chỉnh đã duyệt</t>
                            <t t-else="">Có cảnh báo tải ảnh hồ sơ — mở Nhật ký để xem chi tiết</t>
                        </p>
                    </li>
                </ul>
            </section>
        </div>

        <section class="o_tp_att_admin_panel" aria-labelledby="tp_att_admin_tasks" t-if="this.data.can_review or this.data.can_lock">
            <header><h2 id="tp_att_admin_tasks">Xử lý công</h2></header>
            <div class="o_tp_att_admin_task_grid">
                <button t-if="this.data.can_review" type="button" class="btn btn-light" t-on-click="() => this.open('tp_hr_attendance.action_review')">
                    <i class="oi" data-icon="fact_check" aria-hidden="true"/> Xử lý điều chỉnh
                </button>
                <button t-if="this.data.can_lock" type="button" class="btn btn-light" t-on-click="() => this.open('tp_hr_attendance.action_periods')">
                    <i class="oi" data-icon="lock" aria-hidden="true"/> Chốt kỳ
                </button>
            </div>
        </section>

    </t>
</div>
</t>
</templates>
