<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="tp_hr_attendance.Dashboard">
<div class="o_tp_att o_tp_att_ov" aria-label="Tổng quan chấm công" t-att-aria-busy="this.state.loading ? 'true' : 'false'">
    <header class="o_tp_att_ov_head">
        <div class="o_tp_att_ov_title">
            <h1>Tổng quan chấm công</h1>
            <p class="o_tp_att_subtitle" t-out="this.heading"/>
        </div>
        <button t-if="this.data?.can_export" type="button" class="btn btn-primary o_tp_att_ov_export" t-att-disabled="this.state.exporting"
                t-on-click="() => this.exportExcel()">
            <i class="oi me-1" t-att-data-icon="this.state.exporting ? 'hourglass_top' : 'download'" aria-hidden="true"/>
            <t t-out="this.state.exporting ? 'Đang xuất…' : 'Xuất Excel'"/>
        </button>
    </header>

    <div t-if="this.state.exportError" class="alert alert-danger o_tp_att_ov_alert" role="alert">
        <strong>Xuất Excel chưa thành công.</strong> <t t-out="this.state.exportError"/>
    </div>

    <section class="o_tp_att_ov_filters" aria-label="Kỳ và bộ lọc">
      <div class="o_tp_att_ov_when">
        <div class="o_tp_att_segment" role="group" aria-label="Chế độ xem">
            <button t-foreach="this.modes" t-as="mode" t-key="mode[0]" type="button" t-att-class="{'active': this.state.mode === mode[0]}"
                t-att-aria-pressed="this.state.mode === mode[0] ? 'true' : 'false'" t-on-click="() => this.setMode(mode[0])" t-out="mode[1]"/>
        </div>
        <div class="o_tp_att_period" t-if="this.state.mode !== 'range'">
            <button type="button" class="o_tp_att_icon_btn" t-att-disabled="!this.data" t-on-click="() => this.step(-1)" aria-label="Kỳ trước"><i class="oi" data-icon="chevron_backward" aria-hidden="true"/></button>
            <input t-if="this.state.mode === 'month'" type="month" t-att-value="this.data?.start?.slice(0, 7)" t-on-change="this.onMonth" aria-label="Chọn tháng"/>
            <input t-else="" type="date" t-att-value="this.data?.date or this.state.date" t-on-change="this.onDate"
                   t-att-aria-label="this.state.mode === 'week' ? 'Chọn một ngày trong tuần (T2–CN)' : 'Chọn ngày'"/>
            <button type="button" class="o_tp_att_icon_btn" t-att-disabled="!this.data" t-on-click="() => this.step(1)" aria-label="Kỳ sau"><i class="oi" data-icon="chevron_forward" aria-hidden="true"/></button>
            <button type="button" class="btn btn-light" t-on-click="this.goToday">Hôm nay</button>
        </div>
        <div class="o_tp_att_period o_tp_att_ov_range" t-else="">
            <button type="button" class="o_tp_att_icon_btn" t-att-disabled="!this.data" t-on-click="() => this.step(-1)" aria-label="Khoảng trước"><i class="oi" data-icon="chevron_backward" aria-hidden="true"/></button>
            <input type="date" t-att-value="this.state.from" t-on-change="(ev) => this.onRange('from', ev)" aria-label="Từ ngày"/>
            <span aria-hidden="true">→</span>
            <input type="date" t-att-value="this.state.to" t-on-change="(ev) => this.onRange('to', ev)" aria-label="Đến ngày"/>
            <button type="button" class="o_tp_att_icon_btn" t-att-disabled="!this.data" t-on-click="() => this.step(1)" aria-label="Khoảng sau"><i class="oi" data-icon="chevron_forward" aria-hidden="true"/></button>
        </div>
      </div>
      <div class="o_tp_att_ov_which">
        <label class="o_tp_att_field"><span>Phòng ban</span>
            <select t-on-change="this.onDepartment" aria-label="Lọc phòng ban">
                <option value="" t-att-selected="!this.state.department">Tất cả phòng ban</option>
                <option t-foreach="this.data?.departments or []" t-as="dept" t-key="dept.id" t-att-value="dept.id" t-att-selected="('' + dept.id) === ('' + this.state.department)" t-out="dept.name"/>
            </select>
        </label>
        <label class="o_tp_att_field o_tp_att_ov_search"><span>Nhân viên</span>
            <input type="search" t-att-value="this.state.search" t-on-input="this.onSearch" placeholder="Tên hoặc mã NV" aria-label="Tìm theo tên hoặc mã nhân viên" autocomplete="off"/>
        </label>
        <label class="o_tp_att_field"><span>Tình trạng</span>
            <select t-on-change="this.onStatus" aria-label="Lọc tình trạng của bảng">
                <option t-foreach="this.statusOptions" t-as="option" t-key="option[0]" t-att-value="option[0]" t-att-selected="option[0] === this.state.status" t-out="option[1]"/>
            </select>
        </label>
        <button type="button" class="btn btn-outline-secondary o_tp_att_ov_reset" t-att-disabled="!this.hasFilters" t-on-click="() => this.clearFilters()">
            <i class="oi me-1" data-icon="refresh" aria-hidden="true"/>Đặt lại
        </button>
      </div>
    </section>

    <div t-if="this.state.error" class="alert alert-danger" role="alert"><t t-out="this.state.error"/> <button class="btn btn-link p-0" t-on-click="() => this.load()">Thử lại</button></div>
    <p t-elif="!this.data" role="status" class="o_tp_att_loading">Đang tải tổng quan…</p>
    <t t-else="">
        <p t-if="this.data.future" class="alert alert-secondary">Kỳ này chưa đến; chưa có dữ liệu chấm công.</p>

        <section class="o_tp_att_ov_groups" aria-labelledby="o_tp_att_ov_groups_info">
            <p id="o_tp_att_ov_groups_info" class="o_tp_att_ov_groups_info">
                <span>Tổng nhân viên: <b t-out="this.groups.people"/></span>
                <span>Ngày <b t-out="this.groups.date_label"/><t t-if="this.groups.is_today"> (hôm nay)</t></span>
                <span>Cập nhật lúc <b t-out="this.data.source.updated_at or '—'"/></span>
                <span t-if="this.groups.note" class="o_tp_att_muted" t-out="this.groups.note"/>
            </p>
            <div class="o_tp_att_ov_kpis">
                <button t-foreach="this.groupCards" t-as="card" t-key="card.key" type="button"
                        class="o_tp_att_ov_kpi o_tp_att_ov_group" t-att-class="'o_' + card.key + (this.isFresh('group:' + card.key) ? ' o_fresh' : '')"
                        t-att-title="this.groups.hints[card.key]" aria-haspopup="dialog"
                        t-att-aria-label="this.groups.labels[card.key] + ': ' + this.groups.counts[card.key] + ' nhân viên. ' + this.groups.hints[card.key] + ' Xem danh sách.'"
                        t-on-click="() => this.openGroup(card.key)">
                    <span class="o_label"><i class="oi" t-att-data-icon="card.icon" aria-hidden="true"/><t t-out="this.groups.labels[card.key]"/></span>
                    <strong t-out="this.groups.counts[card.key]"/>
                    <span class="o_more">Xem danh sách <i class="oi" data-icon="chevron_forward" aria-hidden="true"/></span>
                </button>
            </div>
            <p t-if="!this.groups.live_ok" class="o_tp_att_ov_live_warn" role="status">
                <i class="oi me-1" data-icon="schedule" aria-hidden="true"/>Chưa nhận được dữ liệu mới từ nguồn chấm công. Người chưa có lượt chấm hôm nay được tính là Chưa xác định, không tính là Chưa đi làm.
            </p>
            <button t-if="this.groups.counts.unknown" type="button" class="o_tp_att_ov_unknown" aria-haspopup="dialog"
                    t-att-class="{'o_fresh': this.isFresh('group:unknown')}" t-on-click="() => this.openGroup('unknown')">
                <i class="oi" data-icon="help" aria-hidden="true"/>
                <span><b><t t-out="this.groups.counts.unknown"/> nhân viên chưa xác định</b> · <t t-out="this.unknownText"/></span>
                <span class="o_more">Xem danh sách <i class="oi" data-icon="chevron_forward" aria-hidden="true"/></span>
            </button>
        </section>

        <div class="o_tp_att_ov_grid o_tp_att_ov_main">
            <section class="o_tp_att_ov_card o_tp_att_ov_status" aria-labelledby="o_tp_att_ov_status_title">
                <header class="o_tp_att_ov_card_head">
                    <div>
                        <h2 id="o_tp_att_ov_status_title">Tình trạng trong ngày</h2>
                        <p class="o_tp_att_muted">Ngày <t t-out="this.groups.date_label"/> · bấm một nhóm để xem danh sách</p>
                    </div>
                </header>
                <div t-if="!this.groups.total" class="o_tp_att_ov_empty">Chưa có nhân viên nào được tính trong ngày này.</div>
                <div t-else="" class="o_tp_att_ov_donut_row">
                    <div class="o_tp_att_ov_donut">
                        <canvas t-ref="this.donut.ref" role="img" t-att-aria-label="this.donutLabel"/>
                        <div class="o_tp_att_ov_donut_center" aria-hidden="true">
                            <strong t-out="this.groups.total"/>
                            <span>nhân viên</span>
                        </div>
                    </div>
                    <ul class="o_tp_att_ov_legend">
                        <li t-foreach="this.legend" t-as="item" t-key="item.key">
                            <button type="button" t-att-class="'o_' + item.key" aria-haspopup="dialog" t-on-click="() => this.openGroup(item.key)">
                                <span class="o_dot" aria-hidden="true"/>
                                <span class="o_name" t-out="item.label"/>
                                <b t-out="item.value"/>
                                <small t-out="item.percent + '%'"/>
                            </button>
                        </li>
                    </ul>
                </div>
            </section>

            <section class="o_tp_att_ov_card o_tp_att_ov_recent" aria-labelledby="o_tp_att_ov_recent_title">
                <header class="o_tp_att_ov_card_head">
                    <div>
                        <h2 id="o_tp_att_ov_recent_title"><t t-out="this.data.recent_info.title"/>
                            <span class="o_tp_att_ov_info" tabindex="0" role="note" t-att-title="this.data.recent_info.hint" t-att-aria-label="this.data.recent_info.hint">
                                <i class="oi" data-icon="info" aria-hidden="true"/>
                            </span>
                        </h2>
                        <p class="o_tp_att_muted">Ngày <t t-out="this.data.recent_info.date_label"/> · mới nhất ở trên · theo bộ lọc và quyền xem</p>
                    </div>
                </header>
                <div class="o_tp_att_ov_recent_wrap" tabindex="0" role="region" aria-labelledby="o_tp_att_ov_recent_title">
                    <table class="o_tp_att_ov_recent_table">
                        <thead><tr>
                            <th scope="col" class="o_code">Mã NV</th>
                            <th scope="col">Họ và tên</th>
                            <th scope="col" class="o_clock">Thời gian</th>
                            <th scope="col" class="o_place">Địa điểm</th>
                        </tr></thead>
                        <tbody>
                            <tr t-if="!this.data.recent.length"><td colspan="4" class="o_tp_att_ov_recent_empty">Chưa có lượt chấm công trong ngày này.</td></tr>
                            <tr t-foreach="this.data.recent" t-as="row" t-key="row.key" t-att-class="{'o_fresh': this.isFresh(row.key)}">
                                <td class="o_code" t-out="row.code or '—'"/>
                                <th scope="row" class="o_name" t-out="row.name"/>
                                <td class="o_clock"><time t-out="row.time"/></td>
                                <td class="o_place" t-out="row.location or '—'"/>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>
        </div>

        <div class="o_tp_att_ov_grid o_tp_att_ov_trends">
            <section class="o_tp_att_ov_card" aria-labelledby="o_tp_att_ov_trend_title">
                <header class="o_tp_att_ov_card_head">
                    <div>
                        <h2 id="o_tp_att_ov_trend_title">Diễn biến theo ngày</h2>
                        <p class="o_tp_att_muted"><t t-out="this.data.trend_label"/> · đơn vị: nhân viên mỗi ngày · bấm cột để xem ngày đó</p>
                    </div>
                    <ul class="o_tp_att_ov_keys" aria-hidden="true">
                        <li><span class="o_working"/>Đang làm</li>
                        <li><span class="o_done"/>Đã về</li>
                        <li><span class="o_not_started"/>Chưa đi làm</li>
                    </ul>
                </header>
                <div class="o_tp_att_ov_chart">
                    <canvas t-ref="this.trend.ref" role="img" t-att-aria-label="'Biểu đồ cột số nhân viên đang làm, đã về và chưa đi làm theo ngày, ' + this.data.trend_label"/>
                </div>
            </section>
            <section class="o_tp_att_ov_card" aria-labelledby="o_tp_att_ov_late_title">
                <header class="o_tp_att_ov_card_head">
                    <div>
                        <h2 id="o_tp_att_ov_late_title">Phút đi muộn theo ngày</h2>
                        <p class="o_tp_att_muted">Theo nguồn chấm công · ngày chưa có số liệu để trống, không tính là 0</p>
                    </div>
                </header>
                <div t-if="!this.lateKnown" class="o_tp_att_ov_empty">Chưa có số liệu đi muộn trong kỳ này.</div>
                <div t-else="" class="o_tp_att_ov_chart o_small">
                    <canvas t-ref="this.lateChart.ref" role="img" aria-label="Biểu đồ cột tổng phút đi muộn theo ngày"/>
                </div>
            </section>
        </div>

        <section class="o_tp_att_ov_card o_tp_att_ov_table_card" aria-labelledby="o_tp_att_ov_table_title">
            <header class="o_tp_att_ov_card_head">
                <div>
                    <h2 id="o_tp_att_ov_table_title" t-out="this.statusTitle"/>
                    <p class="o_tp_att_muted"><t t-out="this.data.total"/> dòng · ngày mới nhất ở trên · bấm một dòng để xem giờ theo ngày</p>
                </div>
                <button type="button" class="btn btn-outline-primary btn-sm" t-on-click="() => this.openBoard()">
                    <i class="oi me-1" data-icon="table_view" aria-hidden="true"/>Mở Bảng chấm công
                </button>
            </header>
            <div class="o_tp_att_table_wrap">
                <table class="o_tp_att_table o_tp_att_ov_table">
                    <thead><tr>
                        <th scope="col">Nhân viên</th><th scope="col">Phòng ban</th><th scope="col">Thứ/ngày</th>
                        <th scope="col">Giờ vào</th><th scope="col">Giờ ra</th><th scope="col">Tình trạng</th><th scope="col" class="o_num">Phút muộn</th>
                    </tr></thead>
                    <tbody>
                        <tr t-if="!this.data.rows.length"><td colspan="7" class="o_tp_att_empty">Không có dòng nào khớp bộ lọc.</td></tr>
                        <tr t-foreach="this.data.rows" t-as="row" t-key="row.employee_id + ':' + row.date" class="o_tp_att_click" tabindex="0"
                            t-on-click="() => this.openPerson(row)" t-on-keydown="(ev) => ev.key === 'Enter' and this.openPerson(row)">
                            <th scope="row" data-label="Nhân viên"><span class="o_tp_att_name" t-out="row.name"/><small t-out="row.code or 'Chưa có mã'"/></th>
                            <td data-label="Phòng ban" t-out="row.department or '—'"/>
                            <td data-label="Thứ/ngày" t-out="row.day_label"/>
                            <td data-label="Giờ vào"><span class="o_time" t-out="row.in or '—'"/></td>
                            <td data-label="Giờ ra"><span class="o_time" t-out="row.out or '—'"/></td>
                            <td data-label="Tình trạng">
                                <span class="o_tp_att_ov_state" t-att-class="'o_' + row.state">
                                    <t t-out="row.state === 'missing' ? this.attendanceIssue(row).label : row.state_label"/>
                                </span>
                            </td>
                            <td data-label="Phút muộn" class="o_num" t-out="row.late === null ? '—' : row.late"/>
                        </tr>
                    </tbody>
                </table>
            </div>
            <AttPager t-if="this.data.total" data="this.data" unit="'dòng'" onPage="(page) => this.setPage(page)" onSize="(size) => this.setSize(size)"/>
        </section>
    </t>
</div>
</t>
</templates>
