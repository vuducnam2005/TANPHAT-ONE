<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="tp_hr_attendance.Board">
<AttendanceFileMatrix t-if="this.data?.can_import" action="this.props.action"/>
<div t-else="" class="o_tp_att o_tp_att_board" aria-label="Bảng chấm công" t-att-aria-busy="this.state.loading ? 'true' : 'false'">
    <header class="o_tp_att_header">
        <div>
            <h1>Bảng chấm công</h1>
            <p class="o_tp_att_subtitle" t-out="this.title"/>
        </div>
        <div class="o_tp_att_actions">
            <button t-if="this.data?.can_import" type="button" class="btn btn-outline-primary" t-on-click="() => this.openFileMatrix()">
                <i class="oi me-1" data-icon="grid_on" aria-hidden="true"/>Bảng công theo file (Vào/Ra)
            </button>
            <button t-if="this.data?.can_import" type="button" class="btn btn-outline-secondary" t-on-click="() => this.openFileMatrix('compare')">
                <i class="oi me-1" data-icon="compare_arrows" aria-hidden="true"/>Đối chiếu A/B
            </button>
            <button t-if="this.data?.can_export" type="button" class="btn btn-outline-primary" t-on-click="this.exportSheet"><i class="oi me-1" data-icon="download" aria-hidden="true"/>Xuất Excel</button>
            <button t-if="this.data?.can_import" type="button" class="btn btn-primary" t-on-click="this.openUpload"><i class="oi me-1" data-icon="upload_file" aria-hidden="true"/>Nhập Excel máy chấm công</button>
        </div>
    </header>

    <section class="o_tp_att_toolbar" aria-label="Kỳ và bộ lọc">
        <div class="o_tp_att_segment" role="group" aria-label="Chế độ xem">
            <button t-foreach="this.modes" t-as="mode" t-key="mode[0]" type="button" t-att-class="{'active': this.state.mode === mode[0]}"
                t-att-aria-pressed="this.state.mode === mode[0] ? 'true' : 'false'" t-on-click="() => this.setMode(mode[0])" t-out="mode[1]"/>
            <button type="button" t-att-class="{'active': this.state.mode === 'range'}" t-att-aria-expanded="this.state.fileMenu ? 'true' : 'false'"
                t-on-click="() => this.state.fileMenu = !this.state.fileMenu">Kỳ theo file</button>
        </div>
        <div class="o_tp_att_period">
            <button type="button" class="o_tp_att_icon_btn" t-att-disabled="!this.data" t-on-click="() => this.step(-1)" aria-label="Kỳ trước"><i class="oi" data-icon="chevron_backward" aria-hidden="true"/></button>
            <input t-if="this.state.mode === 'month'" type="month" t-att-value="this.data?.start?.slice(0, 7)" t-on-change="this.onMonth" aria-label="Chọn tháng"/>
            <t t-elif="this.state.mode === 'range'">
                <input type="date" t-att-value="this.state.from" t-on-change="(ev) => this.onRange('from', ev)" aria-label="Từ ngày"/>
                <span aria-hidden="true">–</span>
                <input type="date" t-att-value="this.state.to" t-on-change="(ev) => this.onRange('to', ev)" aria-label="Đến ngày"/>
            </t>
            <input t-else="" type="date" t-att-value="this.state.date" t-on-change="this.onDate" t-att-aria-label="this.state.mode === 'week' ? 'Chọn một ngày trong tuần (T2–CN)' : 'Chọn ngày'"/>
            <button type="button" class="o_tp_att_icon_btn" t-att-disabled="!this.data" t-on-click="() => this.step(1)" aria-label="Kỳ sau"><i class="oi" data-icon="chevron_forward" aria-hidden="true"/></button>
            <button type="button" class="btn btn-light" t-on-click="this.goToday">Hôm nay</button>
        </div>
        <label class="o_tp_att_field"><span>Phòng ban</span>
            <select t-on-change="this.onDepartment" aria-label="Lọc phòng ban">
                <option value="" t-att-selected="!this.state.department">Tất cả phòng ban</option>
                <option t-foreach="this.data?.departments or []" t-as="dept" t-key="dept.id" t-att-value="dept.id" t-att-selected="('' + dept.id) === ('' + this.state.department)" t-out="dept.name"/>
            </select>
        </label>
        <label class="o_tp_att_field o_tp_att_search"><span>Nhân viên</span>
            <input type="search" placeholder="Tên hoặc mã nhân viên…" t-att-value="this.state.search" t-on-input="this.onSearch" aria-label="Tìm tên hoặc mã nhân viên"/>
        </label>
        <label t-if="this.isDay" class="o_tp_att_field"><span>Tình trạng</span>
            <select t-on-change="this.onDayState" aria-label="Lọc tình trạng ngày">
                <option t-foreach="this.dayStates" t-as="item" t-key="item[0]" t-att-value="item[0]" t-att-selected="this.state.dayState === item[0]" t-out="item[1]"/>
            </select>
        </label>
        <button t-if="this.state.department or this.state.search or this.state.dayState" type="button" class="btn btn-link" t-on-click="this.clearFilters">Xóa lọc</button>
    </section>

    <div t-if="this.state.fileMenu" class="o_tp_att_file_menu" role="menu" aria-label="Kỳ theo tệp đã nhập">
        <p t-if="!this.data?.file_periods?.length" class="o_tp_att_muted">Chưa có tệp Excel máy nào được nhập.</p>
        <button t-foreach="this.data?.file_periods or []" t-as="item" t-key="item.from + item.to" type="button" role="menuitem"
            t-att-class="{'active': this.state.mode === 'range' and this.state.from === item.from and this.state.to === item.to}"
            t-on-click="() => this.openFilePeriod(item)"><strong t-out="item.label"/><small t-out="item.file"/></button>
    </div>

    <SourceStrip source="this.data?.source" onSources="this.data?.can_import ? (() => this.openSources()) : null"/>

    <div t-if="this.state.error" class="alert alert-danger" role="alert"><t t-out="this.state.error"/> <button class="btn btn-link p-0" t-on-click="this.load">Thử lại</button></div>
    <p t-elif="!this.data" role="status" class="o_tp_att_loading">Đang tải bảng chấm công…</p>
    <t t-else="">
        <t t-if="this.isDay">
            <div class="o_tp_att_note_row">
                <span class="o_tp_att_muted">Giờ làm tham chiếu <t t-out="this.data.reference_hours.replace('-', '–')"/>. Ô trống là chưa có ghi nhận, không phải nghỉ.</span>
                <span t-if="this.data.late_note" class="o_tp_att_late_hint"><t t-out="this.data.late_note"/>
                    <button t-foreach="this.dayPeriods" t-as="item" t-key="item.from + item.to" type="button" class="btn btn-link btn-sm" t-on-click="() => this.openLate(item)">Xem tổng kỳ <t t-out="item.label"/></button>
                </span>
            </div>
            <div class="o_tp_att_table_wrap">
                <table class="o_tp_att_table o_tp_att_day_table">
                    <thead><tr><th scope="col">Nhân viên</th><th scope="col">Phòng ban</th><th scope="col">Thứ/ngày</th><th scope="col">Giờ vào</th><th scope="col">Giờ ra</th></tr></thead>
                    <tbody>
                        <tr t-if="!this.data.rows.length"><td colspan="5" class="o_tp_att_empty">Không có nhân viên trong phạm vi lọc.</td></tr>
                        <tr t-foreach="this.data.rows" t-as="row" t-key="row.id" class="o_tp_att_click" tabindex="0" t-att-title="row.state_label"
                            t-on-click="() => this.openPerson(row)" t-on-keydown="(ev) => ev.key === 'Enter' and this.openPerson(row)">
                            <th scope="row" data-label="Nhân viên"><span class="o_tp_att_name" t-out="row.name"/><small t-out="row.code or 'Chưa có mã'"/></th>
                            <td data-label="Phòng ban" t-out="row.department or '—'"/>
                            <td data-label="Thứ/ngày" t-out="row.day_label"/>
                            <td data-label="Giờ vào"><span class="o_time" t-out="row.in or '—'"/><small t-if="this.cellNote(row, 'in')" class="o_tp_att_cell_note" t-att-class="'o_' + row.state" t-out="this.cellNote(row, 'in')"/></td>
                            <td data-label="Giờ ra"><span class="o_time" t-out="row.out or '—'"/><small t-if="this.cellNote(row, 'out')" class="o_tp_att_cell_note" t-att-class="'o_' + row.state" t-out="this.cellNote(row, 'out')"/></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
        <t t-else="">
            <div class="o_tp_att_note_row">
                <span t-if="this.data.late_source" class="o_tp_att_source_note"><t t-out="this.data.late_source"/></span>
                <span t-else="" class="o_tp_att_muted">Chưa có tổng đi muộn đúng kỳ <t t-out="this.data.period_label"/>; không chia hoặc cộng số của kỳ khác.</span>
                <span t-if="this.data.late_summary" class="o_tp_att_badge o_info"><t t-out="this.data.late_summary.people"/> người có số liệu · <t t-out="this.data.late_summary.count"/> lần · <t t-out="this.data.late_summary.minutes"/> phút</span>
                <t t-if="this.overlapPeriods.length">
                    <span class="o_tp_att_muted">Xem đúng kỳ nguồn:</span>
                    <button t-foreach="this.overlapPeriods" t-as="item" t-key="item.from + item.to" type="button" class="btn btn-link btn-sm" t-on-click="() => this.openFilePeriod(item)" t-out="item.label"/>
                </t>
            </div>
            <PeriodTable rows="this.data.rows" onPerson="(row) => this.openPerson(row)"/>
        </t>
        <AttPager data="this.data" unit="'nhân viên'" onPage="(page) => this.setPage(page)" onSize="(size) => this.setSize(size)"/>
    </t>
</div>
</t>
</templates>
