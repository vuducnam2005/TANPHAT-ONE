<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="tp_hr_attendance.UploadDialog">
    <Dialog title="'Tải tệp Excel máy chấm công'" size="'lg'" contentClass="'o_tp_att_upload'">
        <div t-if="this.state.error" class="alert alert-danger" role="alert" t-out="this.state.error"/>

        <label class="o_tp_att_drop" t-att-class="{'o_drag': this.state.drag, 'o_busy': this.busy}"
            t-on-dragover="this.onDragOver" t-on-dragleave="this.onDragLeave" t-on-drop="this.onDrop">
            <input type="file" multiple="multiple" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                class="visually-hidden" t-on-change="this.onPick" t-att-disabled="this.busy" aria-describedby="tp_att_drop_help"/>
            <i class="oi o_tp_att_drop_icon" data-icon="upload_file" aria-hidden="true"/>
            <strong t-if="this.busy">Đang đọc <t t-out="this.state.items.length"/> tệp Excel và tạo bảng ma trận nguồn…</strong>
            <strong t-else="">Kéo thả một hoặc nhiều tệp .xlsx vào đây, hoặc bấm để chọn tệp</strong>
            <small id="tp_att_drop_help">
                Hỗ trợ chọn nhiều tệp cùng lúc (1–3 tuần, 28–31 ngày, nhiều trang tính). Mỗi tệp được cấp mã lô riêng, giữ nguyên
                mã nhân viên Excel, hai dòng Vào/Ra, nhóm đơn vị và tổng Đi muộn Lần/Phút để xem bảng đầy đủ và đối chiếu trước khi áp dụng.
            </small>
        </label>

        <div t-if="this.state.items.length" class="o_tp_att_upload_list mt-3" role="status" aria-label="Tiến trình đọc từng tệp">
            <div t-foreach="this.state.items" t-as="item" t-key="item.key" class="o_tp_att_upload_item"
                t-att-class="!item.done ? 'o_reading' : (item.ok ? 'o_ok' : 'o_err')">
                <div class="o_tp_att_upload_item_main">
                    <strong t-out="item.file_name"/>
                    <span t-if="!item.done" class="o_tp_att_badge o_info">Đang đọc…</span>
                    <span t-elif="item.ok" class="o_tp_att_badge o_ok">
                        <t t-out="item.batch_code"/> · Đã lưu nguồn (<t t-out="item.people_count"/> người)
                    </span>
                    <span t-else="" class="o_tp_att_badge o_danger">Không đọc được</span>
                </div>
                <p t-if="item.error" class="o_tp_att_upload_item_err mb-0" t-out="item.error"/>
            </div>
        </div>

        <t t-set-slot="footer">
            <button t-if="this.state.step === 'result'" type="button" class="btn btn-primary" t-on-click="this.pickAgain">Chọn lại tệp .xlsx</button>
            <button type="button" class="btn btn-outline-secondary" t-att-disabled="this.busy" t-on-click="this.close">Đóng</button>
        </t>
    </Dialog>
</t>
</templates>
