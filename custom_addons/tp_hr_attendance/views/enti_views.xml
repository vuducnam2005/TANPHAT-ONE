<?xml version="1.0" encoding="utf-8"?>
<!-- ENTI Live Attendance Views: Configuration Wizard, Employee Mapping, and Sync Logs (ENTI-LIVE-001) -->
<odoo>
    <!-- Wizard View -->
    <record id="enti_config_wizard_view" model="ir.ui.view">
        <field name="name">tp.hr.attendance.enti.config.wizard.form</field>
        <field name="model">tp.hr.attendance.enti.config.wizard</field>
        <field name="arch" type="xml">
            <form string="Cấu hình kết nối chấm công ENTI">
                <sheet>
                    <div class="alert alert-info" role="status">
                        <strong>Tích hợp chấm công ENTI (enti.vn)</strong>: Hệ thống kết nối API trực tiếp từ backend,
                        tự động đồng bộ giờ vào/ra và đối chiếu nhân sự. Mật khẩu được bảo mật tuyệt đối trên máy chủ và không bao giờ hiển thị lại ra trình duyệt.
                    </div>
                    <group>
                        <group string="Thông tin tài khoản">
                            <field name="phone" placeholder="Số điện thoại đăng nhập ENTI"/>
                            <field name="password" password="True" placeholder="Mật khẩu tài khoản ENTI"/>
                            <field name="app_key" placeholder="Để trống nếu tự động nhận diện"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Trạng thái hiện tại">
                            <field name="status_display" readonly="1" widget="badge" decoration-success="is_configured" decoration-warning="not is_configured"/>
                            <field name="is_configured" invisible="1"/>
                        </group>
                    </group>
                    <div class="d-flex gap-2 my-2">
                        <button name="action_test_connection" type="object" string="Kiểm tra kết nối" class="btn btn-outline-primary"/>
                        <button name="action_save_credentials" type="object" string="Lưu cấu hình bảo mật" class="btn btn-primary"/>
                    </div>
                    <field name="last_test_result" readonly="1" class="font-monospace text-wrap border p-2 bg-light rounded" invisible="not last_test_result"/>
                    <separator string="Đồng bộ thủ công khoảng ngày"/>
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group class="d-flex align-items-center">
                            <button name="action_sync_now" type="object" string="Đồng bộ ngay khoảng ngày này" class="btn btn-success"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button special="cancel" string="Đóng" class="btn btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_enti_config" model="ir.actions.act_window">
        <field name="name">Cấu hình kết nối ENTI</field>
        <field name="res_model">tp.hr.attendance.enti.config.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Mapping List & Search -->
    <record id="enti_mapping_list" model="ir.ui.view">
        <field name="name">tp.hr.attendance.enti.mapping.list</field>
        <field name="model">tp.hr.attendance.enti.mapping</field>
        <field name="arch" type="xml">
            <list string="Đối chiếu nhân viên ENTI - Odoo" js_class="tp_hr_table" default_order="state desc, ten_nv">
                <field name="ma_nv" string="Mã ENTI"/>
                <field name="ten_nv" string="Họ tên bên ENTI"/>
                <field name="ten_bp" string="Bộ phận ENTI"/>
                <field name="employee_id" string="Nhân viên Odoo"/>
                <field name="employee_code" string="Mã Odoo"/>
                <field name="employee_department" string="Phòng ban Odoo"/>
                <field name="state" widget="badge" decoration-success="state == 'mapped'" decoration-warning="state == 'suggested'" decoration-danger="state == 'unmapped'"/>
                <field name="match_reason" string="Căn cứ đối chiếu"/>
                <button name="action_confirm_mapping" type="object" string="Xác nhận" class="btn btn-sm btn-primary" invisible="state == 'mapped'"/>
                <button name="action_reject_mapping" type="object" string="Hủy khớp" class="btn btn-sm btn-outline-danger" invisible="state == 'unmapped'"/>
            </list>
        </field>
    </record>

    <record id="enti_mapping_search" model="ir.ui.view">
        <field name="name">tp.hr.attendance.enti.mapping.search</field>
        <field name="model">tp.hr.attendance.enti.mapping</field>
        <field name="arch" type="xml">
            <search string="Đối chiếu nhân viên ENTI">
                <field name="ten_nv" string="Họ tên ENTI"/>
                <field name="ma_nv" string="Mã ENTI"/>
                <field name="employee_id" string="Nhân viên Odoo"/>
                <filter name="state_suggested" string="Chờ xác nhận" domain="[('state', '=', 'suggested')]"/>
                <filter name="state_unmapped" string="Chưa đối chiếu" domain="[('state', '=', 'unmapped')]"/>
                <filter name="state_mapped" string="Đã khớp" domain="[('state', '=', 'mapped')]"/>
                <group>
                    <filter name="group_state" string="Trạng thái đối chiếu" context="{'group_by': 'state'}"/>
                    <filter name="group_dept" string="Bộ phận ENTI" context="{'group_by': 'ten_bp'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_enti_mapping" model="ir.actions.act_window">
        <field name="name">Đối chiếu nhân viên ENTI</field>
        <field name="res_model">tp.hr.attendance.enti.mapping</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="enti_mapping_search"/>
        <field name="context">{'search_default_state_suggested': 1, 'search_default_state_unmapped': 1}</field>
        <field name="help" type="html">
            <p>Danh sách đối chiếu định danh nhân viên giữa ENTI và Odoo. Xác nhận ghép nối để công được ghi nhận vào hồ sơ nhân viên chuẩn.</p>
        </field>
    </record>

    <!-- Sync Log List -->
    <record id="enti_sync_log_list" model="ir.ui.view">
        <field name="name">tp.hr.attendance.enti.sync.log.list</field>
        <field name="model">tp.hr.attendance.enti.sync.log</field>
        <field name="arch" type="xml">
            <list string="Nhật ký đồng bộ ENTI" create="0" edit="0" delete="0">
                <field name="synced_at" string="Thời điểm"/>
                <field name="start_date" string="Từ ngày"/>
                <field name="end_date" string="Đến ngày"/>
                <field name="employee_count" string="Số NV ENTI"/>
                <field name="mapped_count" string="Đã khớp"/>
                <field name="unmapped_count" string="Chưa khớp"/>
                <field name="days_applied" string="Ngày công áp dụng"/>
                <field name="duration_seconds" string="Thời gian (s)"/>
                <field name="state" widget="badge" decoration-success="state == 'success'" decoration-danger="state == 'error'"/>
                <field name="message" string="Chi tiết"/>
            </list>
        </field>
    </record>

    <record id="action_enti_logs" model="ir.actions.act_window">
        <field name="name">Nhật ký đồng bộ ENTI</field>
        <field name="res_model">tp.hr.attendance.enti.sync.log</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p>Lịch sử các lần hệ thống tự động hoặc thủ công đồng bộ dữ liệu từ ENTI.</p>
        </field>
    </record>
</odoo>
