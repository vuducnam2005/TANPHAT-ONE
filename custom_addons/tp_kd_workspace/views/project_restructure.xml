<record id="package_list" model="ir.ui.view"><field name="name">kd.package.list</field><field name="model">tp.bid.package</field><field name="arch" type="xml"><list js_class="tp_kd_list" class="tp_kd_table" limit="20" delete="false"><field name="name" class="tp_kd_wrap tp_kd_strong" width="[240,360]"/><field name="project_id" width="[200,300]"/><field name="investor_id" width="[180,250]"/><field name="partner_summary" width="[200,320]" optional="show"/><field name="owner_id" width="[150,210]"/><field name="deadline" width="[140,180]"/><field name="stage" widget="tp_kd_badge" width="[150,220]"/><field name="budget_display" width="[180,230]" optional="show"/><field name="last_note" width="[240,360]" optional="show"/><field name="outcome" width="[140,200]" optional="hide"/><field name="code" width="[130,180]" optional="hide"/></list></field></record>
