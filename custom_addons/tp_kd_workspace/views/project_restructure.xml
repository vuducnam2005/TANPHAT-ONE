<record id="package_amount_form" model="ir.ui.view"><field name="name">kd.package.amount.form</field><field name="model">tp.bid.package.amount</field><field name="arch" type="xml"><form string="Giá trị gói theo từng nghĩa" delete="false" js_class="tp_kd_review_form" class="tp_kd_form"><sheet><field name="version" invisible="1"/><group><field name="package_id" readonly="id"/><field name="kind" readonly="id"/><field name="amount_state" string="Mức xác định"/><field name="value" invisible="amount_state == 'unknown'"/><field name="currency_id" string="Tiền tệ"/><field name="tax_basis" string="Cơ sở thuế"/><field name="source"/><field name="estimate_date"/></group><p>Chọn Chưa xác định khi chưa có căn cứ; không nhập 0 thay cho thiếu dữ liệu. Không cộng giá gói, giá chào và phần công ty.</p></sheet></form></field></record>
<record id="project_update_list" model="ir.ui.view"><field name="name">kd.project.update.list</field><field name="model">tp.project.update</field><field name="arch" type="xml"><list js_class="tp_kd_table" class="tp_kd_table" limit="20" create="false" edit="false" delete="false"><field name="create_date" string="Thời gian"/><field name="actor_id" string="Người thao tác"/><field name="kind" string="Loại cập nhật"/><field name="project_id" string="Dự án"/><field name="package_id" optional="show"/><field name="state_before" string="Trước cập nhật"/><field name="state_after" string="Sau cập nhật"/><field name="reason" class="tp_kd_wrap" width="[300,480]"/><field name="version" string="Phiên bản"/><field name="correction_id" optional="show"/></list></field></record>
<record id="project_update_form" model="ir.ui.view"><field name="name">kd.project.update.form</field><field name="model">tp.project.update</field><field name="arch" type="xml"><form create="false" edit="false" delete="false" class="tp_kd_form"><sheet><group><field name="project_id" string="Dự án"/><field name="package_id"/><field name="actor_id" string="Người thao tác"/><field name="create_date" string="Thời gian"/><field name="kind" string="Loại cập nhật"/><field name="state_before" string="Trước cập nhật"/><field name="state_after" string="Sau cập nhật"/><field name="version" string="Phiên bản"/><field name="reason"/><field name="correction_id"/></group></sheet></form></field></record>
