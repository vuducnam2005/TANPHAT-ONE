<xpath expr="//field[@name='kd_deadline']" position="replace"><field name="kd_lifecycle" widget="tp_kd_badge" width="[150,210]"/><field name="kd_last_note" width="[220,360]" class="tp_kd_wrap"/></xpath>
</field></record>
