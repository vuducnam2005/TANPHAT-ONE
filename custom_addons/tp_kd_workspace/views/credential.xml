<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <record id="credential_list" model="ir.ui.view">
    <field name="name">kd.credential.list</field>
    <field name="model">tp.credential</field>
    <field name="arch" type="xml">
      <list js_class="tp_kd_list" class="tp_kd_table" limit="20">
        <field name="code" class="tp_kd_wrap" width="[100,140]"/>
        <field name="name" class="tp_kd_wrap tp_kd_strong" width="[190,360]"/>
        <field name="subject_id" string="Đối tượng" class="tp_kd_wrap" width="[150,240]"/>
        <field name="credential_kind" class="tp_kd_wrap" width="[130,200]"/>
        <field name="valid_to" width="[90,120]" widget="tp_kd_date"/>
        <field name="expiry_status" class="tp_kd_wrap" width="[110,160]" widget="tp_kd_badge"/>
        <field name="state" widget="tp_kd_badge" width="[120,160]"/>
        <field name="project_id" class="tp_kd_wrap" width="[160,280]" optional="hide"/>
        <field name="subject_kind" width="[100,140]" optional="hide"/>
        <field name="valid_from" width="[90,120]" optional="hide" widget="tp_kd_date"/>
        <field name="period_from" width="[90,120]" optional="hide" widget="tp_kd_date"/>
        <field name="period_to" width="[90,120]" optional="hide" widget="tp_kd_date"/>
        <field name="owner_id" class="tp_kd_wrap" width="[130,200]" optional="hide"/>
        <field name="date_due" width="[100,130]" optional="hide" widget="tp_kd_date" options="{'numeric': True, 'warning': 'past'}"/>
      </list>
    </field>
  </record>
  <record id="credential_search" model="ir.ui.view">
    <field name="name">kd.credential.search</field>
    <field name="model">tp.credential</field>
    <field name="arch" type="xml">
      <search>
        <field name="code"/>
        <field name="name"/>
        <field name="project_id"/>
        <field name="owner_id"/>
        <filter name="draft" string="Nháp" domain="[('state','=','draft')]"/>
        <filter name="returned" string="Bị trả lại" domain="[('state','=','returned')]"/>
        <filter name="review" string="Chờ tôi rà soát" domain="[('state','=','in_review'),('reviewer_id','=',uid)]"/>
        <filter name="by_project" string="Dự án" context="{'group_by':'project_id'}"/>
        <filter name="by_state" string="Trạng thái" context="{'group_by':'state'}"/>
      </search>
    </field>
  </record>
  <record id="credential_form" model="ir.ui.view">
    <field name="name">kd.credential.form</field>
    <field name="model">tp.credential</field>
    <field name="arch" type="xml">
      <form string="Năng lực và chứng chỉ" js_class="tp_kd_review_form" class="tp_kd_dossier tp_kd_form">
        <header>
          <button name="action_document_remove" type="object" string="Gỡ tài liệu nháp" invisible="state != 'draft' or not can_manage"/><button name="action_document_add" type="object" string="Thêm tài liệu nháp" invisible="state != 'draft' or not can_manage"/><button name="action_documents" type="object" string="Tài liệu"/><button name="action_submit" type="object" string="Gửi rà soát" class="btn-primary" invisible="state != 'draft' or not can_submit" context="{'kd_expected_version': version}"/>
          <button name="action_return" type="object" string="Trả lại" invisible="state != 'in_review' or not can_review" context="{'kd_expected_version': version}" class="btn-warning"/>
          <button name="action_rework" type="object" string="Mở bản sửa" invisible="state != 'returned' or not can_prepare" context="{'kd_expected_version': version}"/>
          <field name="can_manage" invisible="1"/><field name="can_take_review" invisible="1"/>
<button name="action_assign" type="object" string="Phân công" invisible="not can_manage or state not in ('draft','returned')"/>
<button name="action_take_review" type="object" string="Nhận rà soát" invisible="not can_take_review"/>
<field name="state" widget="statusbar"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_project" type="object" class="oe_stat_button" icon="fa-folder-open">
              <span>Hồ sơ dự án</span>
            </button>
          </div>
          <field name="can_prepare" invisible="1"/>
          <field name="can_submit" invisible="1"/>
          <field name="can_review" invisible="1"/>
          <field name="can_read_money" invisible="1"/>
          <field name="eligible_reviewer_ids" invisible="1"/>
          <div class="oe_title">
            <h1>
              <field name="name" readonly="state != 'draft' or (id and not can_prepare)"/>
            </h1>
          </div>
          <group>
            <group string="Căn cứ và dự án">
              <field name="code" readonly="state != 'draft' or (id and not can_prepare)"/>
              <field name="project_id" readonly="id" domain="[('tp_managed','=',True),('company_id','in',context.get('allowed_company_ids', []))]" context="{'form_view_ref': 'tp_kd_workspace.project_governance_form', 'tp_kd_leaf': 'tp_kd_workspace.menu_projects'}" options="{'no_create': True}"/>
              <field name="company_id" invisible="1"/>
              <field name="department_id" options="{'no_open': True, 'no_create': True}"/>
              <field name="contract_id" domain="[('project_id','=',project_id)]" readonly="state != 'draft' or (id and not can_prepare)" context="{'form_view_ref': 'tp_contract.view_contract_form', 'tp_kd_leaf': 'tp_kd_workspace.menu_contracts'}" options="{'no_create': True}"/>
              <field name="task_id" domain="[('project_id','=',project_id)]" readonly="state != 'draft' or (id and not can_prepare)" context="{'form_view_ref': 'tp_kd_workspace.kd_task_form', 'tp_kd_leaf': 'tp_kd_workspace.menu_tasks'}" options="{'no_create': True}"/>
            </group>
            <group string="Phụ trách và hạn">
              <field name="owner_id" readonly="id" options="{'no_open': True, 'no_create': True}"/>
              <field name="reviewer_id" domain="[('id','in',eligible_reviewer_ids)]" readonly="state != 'draft' or (id and not can_prepare)" options="{'no_open': True, 'no_create': True}"/>
              <field name="date" readonly="state != 'draft' or (id and not can_prepare)" widget="tp_kd_date"/>
              <field name="date_due" readonly="state != 'draft' or (id and not can_prepare)" widget="tp_kd_date" options="{'numeric': True, 'warning': 'past'}"/>
              <field name="version" string="Phiên bản" readonly="1" force_save="1"/>
            </group>
          </group>
          <group name="kd_business">
            <group string="Đối tượng năng lực">
              <field name="subject_kind" readonly="state != 'draft' or (id and not can_prepare)"/>
              <field name="subject_id" readonly="state != 'draft' or (id and not can_prepare)" context="{'form_view_ref': 'tp_kd_workspace.kd_partner_summary_form'}" options="{'no_create': True}"/>
              <field name="credential_kind" readonly="state != 'draft' or (id and not can_prepare)"/>
              <button name="action_used_opportunities" type="object" string="Mở hồ sơ dự án đang sử dụng"/>
            </group>
            <group string="Hiệu lực">
              <field name="valid_from" readonly="state != 'draft' or (id and not can_prepare)" widget="tp_kd_date"/>
              <field name="valid_to" readonly="state != 'draft' or (id and not can_prepare)" widget="tp_kd_date"/>
              <field name="expiry_status"/>
            </group>
          </group>
          <group invisible="not can_manage or state != 'draft'"><field name="intervention_reason" placeholder="Nhập lý do khi sửa nháp của người khác"/></group><notebook>
            <page string="Phạm vi năng lực" name="kd_scope_page">
              <field name="scope" readonly="state != 'draft' or (id and not can_prepare)"/>
            </page>
            <page string="Nguồn / xác minh" name="kd_source_page">
              <group>
                <field name="source_note" readonly="state != 'draft' or (id and not can_prepare)"/>
              </group>
            </page>
            <page string="Lịch sử lần trình" name="kd_history_page">
              <group>
                <field name="last_reason"/>
              </group>
              <field name="event_ids" readonly="1" widget="tp_kd_relation">
                <list create="false" delete="false" limit="20">
                  <field name="actor_id"/>
                  <field name="acted_at" widget="tp_kd_datetime"/>
                  <field name="action"/>
                  <field name="state_before" widget="tp_kd_badge"/>
                  <field name="state_after" widget="tp_kd_badge"/>
                  <field name="version"/>
                  <field name="reason"/>
                  <field name="fix_summary"/>
                </list>
              <form string="Lịch sử lần trình" create="false" edit="false" delete="false" class="tp_kd_form"><sheet><group><field name="actor_id" readonly="1" options="{'no_open': True}"/><field name="acted_at" readonly="1" widget="tp_kd_datetime"/><field name="action" readonly="1"/><field name="state_before" readonly="1" widget="tp_kd_text_badge"/><field name="state_after" readonly="1" widget="tp_kd_text_badge"/><field name="version" readonly="1"/><field name="reason" readonly="1"/><field name="fix_summary" readonly="1"/><field name="version_before" readonly="1"/><field name="snapshot_before" readonly="1" groups="base.group_no_one"/><field name="snapshot" readonly="1" groups="base.group_no_one"/></group></sheet></form></field>
            </page>
          </notebook>
          <p class="text-muted">Dữ liệu tổng hợp để quản trị hồ sơ; không phải chứng chỉ được phát hành hoặc đã xác minh. Không dùng hồ sơ này làm căn cứ pháp lý.</p>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_credentials" model="ir.actions.act_window">
    <field name="name">Năng lực và chứng chỉ</field>
    <field name="res_model">tp.credential</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="credential_search"/>
  </record>
  <menuitem id="menu_credentials" name="Năng lực và chứng chỉ" parent="menu_group_payment" action="action_credentials" sequence="20"/>
  <record id="project_credential_button" model="ir.ui.view">
    <field name="name">kd.project.credential</field>
    <field name="model">project.project</field>
    <field name="inherit_id" ref="project_form"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@name='button_box']" position="inside">
        <button name="action_kd_credentials" type="object" class="oe_stat_button" icon="fa-sitemap">
          <span>Năng lực và chứng chỉ</span>
        </button>
      </xpath>
    </field>
  </record>
  <record id="overview_credential" model="ir.ui.view">
    <field name="name">kd.overview.credential</field>
    <field name="model">tp.kd.overview</field>
    <field name="inherit_id" ref="overview_form"/>
    <field name="arch" type="xml">
      <xpath expr="//group[@name='sources']" position="inside">
        <button name="action_credentials" type="object" string="Năng lực và chứng chỉ"/>
      </xpath>
    </field>
  </record>
  <record id="opportunity_credentials" model="ir.ui.view">
    <field name="name">kd.opportunity.credentials</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="opportunity_form"/>
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page string="Năng lực sử dụng" name="kd_credentials_page">
          <div class="tp_kd_bp_page">
            <p class="tp_kd_bp_hint">Chọn hồ sơ năng lực đã có quyền xem trong dự án. Hồ sơ riêng tư được bảo toàn.</p>
            <field name="kd_credential_ids" widget="many2many_tags" domain="[('project_id','=',tp_project_id)]" options="{'no_create': True}"/>
          </div>
        </page>
      </xpath>
    </field>
  </record>
</odoo>