<?xml version='1.0' encoding='utf-8'?>
<odoo>
<record id="plan_list" model="ir.ui.view"><field name="name">kd.plan.list</field><field name="model">tp.periodic.plan</field><field name="arch" type="xml"><list js_class="tp_kd_list" class="tp_kd_table" limit="20"><field name="code" class="tp_kd_wrap" width="[100,140]"/><field name="name" class="tp_kd_wrap tp_kd_strong" width="[190,360]"/><field name="project_id" class="tp_kd_wrap" width="[160,280]"/><field name="period_kind" width="[100,140]"/><field name="period_from" width="[90,120]" widget="tp_kd_date"/><field name="period_to" width="[90,120]" widget="tp_kd_date"/><field name="state" widget="tp_kd_badge" width="[120,160]"/><field name="date_due" width="[100,130]" optional="hide" widget="tp_kd_date" options="{'numeric': True, 'warning': 'past'}"/><field name="owner_id" class="tp_kd_wrap" width="[130,200]" optional="hide"/></list></field></record>
<record id="plan_search" model="ir.ui.view"><field name="name">kd.plan.search</field><field name="model">tp.periodic.plan</field><field name="arch" type="xml"><search><field name="code"/><field name="name"/><field name="project_id"/><field name="owner_id"/><filter name="draft" string="Nháp" domain="[('state','=','draft')]"/><filter name="returned" string="Bị trả lại" domain="[('state','=','returned')]"/><filter name="review" string="Chờ tôi rà soát" domain="[('state','=','in_review'),('reviewer_id','=',uid)]"/><filter name="by_project" string="Dự án" context="{'group_by':'project_id'}"/><filter name="by_state" string="Trạng thái" context="{'group_by':'state'}"/></search></field></record>
<record id="plan_form" model="ir.ui.view"><field name="name">kd.plan.form</field><field name="model">tp.periodic.plan</field><field name="arch" type="xml"><form string="Kế hoạch định kỳ" js_class="tp_kd_review_form" class="tp_kd_dossier tp_kd_form"><header>
<button name="action_document_remove" type="object" string="Gỡ tài liệu nháp" invisible="state != 'draft' or not can_manage"/><button name="action_document_add" type="object" string="Thêm tài liệu nháp" invisible="state != 'draft' or not can_manage"/><button name="action_documents" type="object" string="Tài liệu"/><button name="action_submit" type="object" string="Gửi rà soát" class="btn-primary" invisible="state != 'draft' or not can_submit" context="{'kd_expected_version': version}"/>
<button name="action_return" type="object" string="Trả lại" invisible="state != 'in_review' or not can_review" context="{'kd_expected_version': version}" class="btn-warning"/>
<button name="action_rework" type="object" string="Mở bản sửa" invisible="state != 'returned' or not can_prepare" context="{'kd_expected_version': version}"/>
<field name="can_manage" invisible="1"/><field name="can_take_review" invisible="1"/>
<button name="action_assign" type="object" string="Phân công" invisible="not can_manage or state not in ('draft','returned')"/>
<button name="action_take_review" type="object" string="Nhận rà soát" invisible="not can_take_review"/>
<field name="state" widget="statusbar"/></header><sheet><div class="oe_button_box" name="button_box"><button name="action_project" type="object" class="oe_stat_button" icon="fa-folder-open"><span>Hồ sơ dự án</span></button></div>
<field name="can_prepare" invisible="1"/><field name="can_submit" invisible="1"/><field name="can_review" invisible="1"/><field name="can_read_money" invisible="1"/><field name="eligible_reviewer_ids" invisible="1"/>
<div class="oe_title"><h1><field name="name" readonly="state != 'draft' or (id and not can_prepare)"/></h1></div>
<group><group string="Căn cứ và dự án"><field name="code" readonly="state != 'draft' or (id and not can_prepare)"/><field name="project_id" readonly="id" domain="[('tp_managed','=',True),('company_id','in',context.get('allowed_company_ids', []))]" context="{'form_view_ref': 'tp_kd_workspace.project_governance_form', 'tp_kd_leaf': 'tp_kd_workspace.menu_projects'}" options="{'no_create': True}"/><field name="company_id" invisible="1"/><field name="department_id" options="{'no_open': True, 'no_create': True}"/><field name="contract_id" domain="[('project_id','=',project_id)]" readonly="state != 'draft' or (id and not can_prepare)" context="{'form_view_ref': 'tp_contract.view_contract_form', 'tp_kd_leaf': 'tp_kd_workspace.menu_contracts'}" options="{'no_create': True}"/><field name="task_id" domain="[('project_id','=',project_id)]" readonly="state != 'draft' or (id and not can_prepare)" context="{'form_view_ref': 'tp_kd_workspace.kd_task_form', 'tp_kd_leaf': 'tp_kd_workspace.menu_tasks'}" options="{'no_create': True}"/></group><group string="Phụ trách và hạn"><field name="owner_id" readonly="id" options="{'no_open': True, 'no_create': True}"/><field name="reviewer_id" domain="[('id','in',eligible_reviewer_ids)]" readonly="state != 'draft' or (id and not can_prepare)" options="{'no_open': True, 'no_create': True}"/><field name="date" readonly="state != 'draft' or (id and not can_prepare)" widget="tp_kd_date"/><field name="date_due" readonly="state != 'draft' or (id and not can_prepare)" widget="tp_kd_date" options="{'numeric': True, 'warning': 'past'}"/><field name="version" string="Phiên bản" readonly="1" force_save="1"/></group></group>
<group name="kd_business"><group string="Kỳ kế hoạch"><field name="period_kind" readonly="state != 'draft' or (id and not can_prepare)"/><field name="period_from" required="1" readonly="state != 'draft' or (id and not can_prepare)" widget="tp_kd_date"/><field name="period_to" required="1" readonly="state != 'draft' or (id and not can_prepare)" widget="tp_kd_date"/><button name="action_source_productions" type="object" string="Đối chiếu nguồn sản lượng trong kỳ"/></group></group>
<group invisible="not can_manage or state != 'draft'"><field name="intervention_reason" placeholder="Nhập lý do khi sửa nháp của người khác"/></group><notebook><page string="Phạm vi" name="kd_scope_page"><field name="scope" readonly="state != 'draft' or (id and not can_prepare)"/></page>
<page string="Chỉ tiêu và đối chiếu nguồn" invisible="not can_read_money" name="kd_money_page"><p>Chưa xác nhận khác số 0 đã xác nhận. Giá trị hồ sơ chưa phải chi phí ghi sổ hoặc tiền đã trả.</p><field name="amount_ids" readonly="state != 'draft' or (id and not can_prepare)" widget="tp_kd_relation"><list editable="bottom" limit="20"><field name="measure"/><field name="amount_state" widget="tp_kd_selection"/><field name="value" invisible="amount_state == 'unconfirmed'"/><field name="currency_id" options="{'no_open': True, 'no_create': True}"/><field name="tax_basis"/><field name="source_status" widget="tp_kd_selection"/><field name="source_value" invisible="source_status != 'comparable'"/></list></field></page>
<page string="Lịch sử lần trình" name="kd_history_page"><group><field name="last_reason"/></group><field name="event_ids" readonly="1" widget="tp_kd_relation"><list create="false" delete="false" limit="20"><field name="actor_id"/><field name="acted_at" widget="tp_kd_datetime"/><field name="action"/><field name="state_before" widget="tp_kd_badge"/><field name="state_after" widget="tp_kd_badge"/><field name="version"/><field name="reason"/><field name="fix_summary"/></list><form string="Lịch sử lần trình" create="false" edit="false" delete="false" class="tp_kd_form"><sheet><group><field name="actor_id" readonly="1" options="{'no_open': True}"/><field name="acted_at" readonly="1" widget="tp_kd_datetime"/><field name="action" readonly="1"/><field name="state_before" readonly="1" widget="tp_kd_text_badge"/><field name="state_after" readonly="1" widget="tp_kd_text_badge"/><field name="version" readonly="1"/><field name="reason" readonly="1"/><field name="fix_summary" readonly="1"/><field name="version_before" readonly="1"/><field name="snapshot_before" readonly="1" groups="base.group_no_one"/><field name="snapshot" readonly="1" groups="base.group_no_one"/></group><field name="amount_ids" readonly="1" widget="tp_kd_relation" invisible="not parent.can_read_money" string="Giá trị tại lần trình"><list create="false" edit="false" delete="false" limit="20"><field name="snapshot_side"/><field name="measure"/><field name="amount_state" widget="tp_kd_selection"/><field name="value" invisible="amount_state == 'unconfirmed'"/><field name="currency_id"/><field name="tax_basis"/></list></field></sheet></form></field></page>
</notebook>
<p class="text-muted">Kế hoạch không phải doanh thu kế toán. Không cộng tháng/quý/năm chung; đối chiếu chỉ các hồ sơ nguồn cùng kỳ/tiền tệ/cơ sở. Chưa có chứng từ ghi sổ liên kết được kiểm chứng cho doanh thu thực hiện.</p>
</sheet></form></field></record>
<record id="action_plans" model="ir.actions.act_window"><field name="name">Kế hoạch định kỳ</field><field name="res_model">tp.periodic.plan</field><field name="view_mode">list,form</field><field name="search_view_id" ref="plan_search"/></record>
<menuitem id="menu_plans" name="Kế hoạch định kỳ" parent="menu_group_output" action="action_plans" sequence="30"/>
<record id="project_plan_button" model="ir.ui.view"><field name="name">kd.project.plan</field><field name="model">project.project</field><field name="inherit_id" ref="project_form"/><field name="arch" type="xml"><xpath expr="//div[@name='button_box']" position="inside"><button name="action_kd_plans" type="object" class="oe_stat_button" icon="fa-sitemap"><span>Kế hoạch định kỳ</span></button></xpath></field></record>
<record id="overview_plan" model="ir.ui.view"><field name="name">kd.overview.plan</field><field name="model">tp.kd.overview</field><field name="inherit_id" ref="overview_form"/><field name="arch" type="xml"><xpath expr="//group[@name='sources']" position="inside"><button name="action_plans" type="object" string="Kế hoạch định kỳ"/></xpath></field></record>
</odoo>