<?xml version='1.0' encoding='utf-8'?>
<odoo>
<record id="obligation_list" model="ir.ui.view"><field name="name">kd.obligation.list</field><field name="model">tp.obligation</field><field name="arch" type="xml"><list js_class="tp_kd_list" class="tp_kd_table" limit="20"><field name="code" class="tp_kd_wrap" width="[100,140]"/><field name="name" class="tp_kd_wrap tp_kd_strong" width="[190,360]"/><field name="project_id" class="tp_kd_wrap" width="[160,280]"/><field name="obligation_kind" class="tp_kd_wrap" width="[120,200]"/><field name="checklist_status" class="tp_kd_wrap" width="[110,200]" widget="tp_kd_badge"/><field name="state" widget="tp_kd_badge" width="[120,160]"/><field name="date_due" width="[100,130]" widget="tp_kd_date" options="{'numeric': True, 'warning': 'past'}"/><field name="contract_id" class="tp_kd_wrap" width="[160,260]" optional="hide"/><field name="period_from" width="[90,120]" optional="hide" widget="tp_kd_date"/><field name="period_to" width="[90,120]" optional="hide" widget="tp_kd_date"/><field name="owner_id" class="tp_kd_wrap" width="[130,200]" optional="hide"/></list></field></record>
<record id="obligation_search" model="ir.ui.view"><field name="name">kd.obligation.search</field><field name="model">tp.obligation</field><field name="arch" type="xml"><search><field name="code"/><field name="name"/><field name="project_id"/><field name="owner_id"/><filter name="draft" string="Nháp" domain="[('state','=','draft')]"/><filter name="returned" string="Bị trả lại" domain="[('state','=','returned')]"/><filter name="review" string="Chờ tôi rà soát" domain="[('state','=','in_review'),('reviewer_id','=',uid)]"/><filter name="by_project" string="Dự án" context="{'group_by':'project_id'}"/><filter name="by_state" string="Trạng thái" context="{'group_by':'state'}"/></search></field></record>
<record id="obligation_form" model="ir.ui.view"><field name="name">kd.obligation.form</field><field name="model">tp.obligation</field><field name="arch" type="xml"><form string="Nghĩa vụ và hồ sơ còn thiếu" js_class="tp_kd_review_form" class="tp_kd_dossier tp_kd_form"><header>
<button name="action_document_remove" type="object" string="Gỡ tài liệu nháp" invisible="state != 'draft' or not can_manage"/><button name="action_document_add" type="object" string="Thêm tài liệu nháp" invisible="state != 'draft' or not can_manage"/><button name="action_documents" type="object" string="Tài liệu"/><button name="action_submit" type="object" string="Gửi rà soát" class="btn-primary" invisible="state != 'draft' or not can_submit" context="{'kd_expected_version': version}"/>
<button name="action_return" type="object" string="Trả lại" invisible="state != 'in_review' or not can_review" context="{'kd_expected_version': version}" class="btn-warning"/>
<button name="action_rework" type="object" string="Mở bản sửa" invisible="state != 'returned' or not can_prepare" context="{'kd_expected_version': version}"/>
<field name="can_manage" invisible="1"/><field name="can_take_review" invisible="1"/>
<button name="action_assign" type="object" string="Phân công" invisible="not can_manage or state not in ('draft','returned')"/>
<button name="action_take_review" type="object" string="Nhận rà soát" invisible="not can_take_review"/>
<field name="state" widget="statusbar"/></header><sheet><div class="oe_button_box" name="button_box"><button name="action_project" type="object" class="oe_stat_button" icon="fa-folder-open"><span>Hồ sơ dự án</span></button></div>
<field name="can_prepare" invisible="1"/><field name="can_submit" invisible="1"/><field name="can_review" invisible="1"/><field name="can_read_money" invisible="1"/><field name="eligible_reviewer_ids" invisible="1"/>
<div class="oe_title"><h1><field name="name" readonly="state != 'draft' or (id and not can_prepare)"/></h1></div>
<group><group string="Căn cứ và dự án"><field name="code" readonly="state != 'draft' or (id and not can_prepare)"/><field name="project_id" readonly="id" domain="[('tp_managed','=',True),('company_id','in',context.get('allowed_company_ids', []))]"/><field name="company_id" invisible="1"/><field name="department_id"/><field name="contract_id" domain="[('project_id','=',project_id)]" readonly="state != 'draft' or (id and not can_prepare)"/><field name="task_id" domain="[('project_id','=',project_id)]" readonly="state != 'draft' or (id and not can_prepare)"/></group><group string="Phụ trách và hạn"><field name="owner_id" readonly="id"/><field name="reviewer_id" domain="[('id','in',eligible_reviewer_ids)]" readonly="state != 'draft' or (id and not can_prepare)"/><field name="date" readonly="state != 'draft' or (id and not can_prepare)" widget="tp_kd_date"/><field name="date_due" readonly="state != 'draft' or (id and not can_prepare)" widget="tp_kd_date" options="{'numeric': True, 'warning': 'past'}"/><field name="version" string="Phiên bản" readonly="1" force_save="1"/></group></group>
<group name="kd_business"><group string="Loại và tình trạng"><field name="obligation_kind" readonly="state != 'draft' or (id and not can_prepare)"/><field name="checklist_status" readonly="state != 'draft' or (id and not can_prepare)"/></group></group>
<group invisible="not can_manage or state != 'draft'"><field name="intervention_reason" placeholder="Nhập lý do khi sửa nháp của người khác"/></group><notebook><page string="Yêu cầu / phạm vi" name="kd_scope_page"><field name="scope" readonly="state != 'draft' or (id and not can_prepare)"/></page>
<page string="Danh mục hồ sơ" name="kd_checklist_page"><group><field name="document_checklist" readonly="state != 'draft' or (id and not can_prepare)"/><field name="checklist_update_reason" readonly="state != 'draft' or (id and not can_prepare)"/></group></page>
<page string="Lịch sử lần trình" name="kd_history_page"><group><field name="last_reason"/></group><field name="event_ids" readonly="1" widget="tp_kd_relation"><list create="false" delete="false" limit="20"><field name="actor_id"/><field name="acted_at" widget="tp_kd_datetime"/><field name="action"/><field name="state_before" widget="tp_kd_badge"/><field name="state_after" widget="tp_kd_badge"/><field name="version"/><field name="reason"/><field name="fix_summary"/></list><form string="Lịch sử lần trình" create="false" edit="false" delete="false" class="tp_kd_form"><sheet><group><field name="actor_id" readonly="1"/><field name="acted_at" readonly="1" widget="tp_kd_datetime"/><field name="action" readonly="1"/><field name="state_before" readonly="1" widget="tp_kd_text_badge"/><field name="state_after" readonly="1" widget="tp_kd_text_badge"/><field name="version" readonly="1"/><field name="reason" readonly="1"/><field name="fix_summary" readonly="1"/><field name="version_before" readonly="1"/><field name="snapshot_before" readonly="1"/><field name="snapshot" readonly="1"/></group></sheet></form></field></page>
</notebook>
<p class="text-muted">Checklist nội bộ không xác nhận thanh lý pháp lý hoặc hết công nợ/bảo hành/giữ lại. Thiếu căn cứ phải giữ chưa xác nhận, không tự tính tiền.</p>
</sheet></form></field></record>
<record id="action_obligations" model="ir.actions.act_window"><field name="name">Nghĩa vụ và hồ sơ còn thiếu</field><field name="res_model">tp.obligation</field><field name="view_mode">list,form</field><field name="search_view_id" ref="obligation_search"/></record>
<menuitem id="menu_obligations" name="Nghĩa vụ và hồ sơ còn thiếu" parent="menu_group_payment" action="action_obligations" sequence="30"/>
<record id="project_obligation_button" model="ir.ui.view"><field name="name">kd.project.obligation</field><field name="model">project.project</field><field name="inherit_id" ref="project_form"/><field name="arch" type="xml"><xpath expr="//div[@name='button_box']" position="inside"><button name="action_kd_obligations" type="object" class="oe_stat_button" icon="fa-sitemap"><span>Nghĩa vụ và hồ sơ còn thiếu</span></button></xpath></field></record>
<record id="overview_obligation" model="ir.ui.view"><field name="name">kd.overview.obligation</field><field name="model">tp.kd.overview</field><field name="inherit_id" ref="overview_form"/><field name="arch" type="xml"><xpath expr="//group[@name='sources']" position="inside"><button name="action_obligations" type="object" string="Nghĩa vụ và hồ sơ còn thiếu"/></xpath></field></record>
</odoo>