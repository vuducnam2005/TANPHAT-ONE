<?xml version='1.0' encoding='utf-8'?>
<odoo><record id="kd_task_list" model="ir.ui.view"><field name="name">kd.task.list</field><field name="model">project.task</field><field name="arch" type="xml"><list js_class="tp_kd_list" class="tp_kd_table" limit="20"><field name="name" class="tp_kd_wrap tp_kd_strong" width="[240,360]"/><field name="project_id" class="tp_kd_wrap" width="[220,300]"/><field name="parent_id" string="Nhiệm vụ cha" class="tp_kd_wrap" width="[200,280]" optional="hide"/><field name="kd_responsible_id" class="tp_kd_wrap" width="[190,220]"/><field name="date_deadline" width="[130,170]" widget="tp_kd_datetime" options="{'numeric': True, 'warning': 'past'}"/><field name="kd_deliverable" class="tp_kd_wrap" width="[220,320]" optional="hide"/><field name="state" widget="tp_kd_badge" width="[130,170]"/></list></field></record>
<record id="kd_task_form" model="ir.ui.view"><field name="name">kd.task.form</field><field name="model">project.task</field><field name="arch" type="xml"><form string="Kế hoạch và công việc" js_class="tp_kd_review_form" class="tp_kd_form"><sheet><div class="oe_button_box" name="button_box"><button type="object" name="action_kd_subtasks" class="oe_stat_button" icon="fa-tasks"><span>Công việc con</span></button></div><field name="kd_task_can_write" invisible="1"/><field name="kd_assignee_ids" invisible="1"/><div class="oe_title"><h1><field name="name" readonly="id and not kd_task_can_write"/></h1><div class="tp_kd_title_meta"><span>Trạng thái</span><field name="state" readonly="1" widget="tp_kd_badge"/></div></div><group><group string="Công việc và dự án"><field name="project_id" required="1" domain="[('tp_managed','=',True)]" readonly="id and not kd_task_can_write"/><field name="company_id" invisible="1"/><field name="parent_id" domain="[('project_id','=',project_id)]" readonly="id and not kd_task_can_write"/><field name="kd_contract_id" domain="[('project_id','=',project_id)]" readonly="id and not kd_task_can_write"/></group><group string="Phân công và hạn"><field name="kd_responsible_id" domain="[('id','in',kd_assignee_ids)]" required="1" readonly="id and not kd_task_can_write"/><field name="user_ids" widget="many2many_tags" domain="[('id','in',kd_assignee_ids)]" readonly="id and not kd_task_can_write"/><field name="date_deadline" readonly="id and not kd_task_can_write" widget="tp_kd_datetime" options="{'numeric': True, 'warning': 'past'}"/></group></group><group string="Đầu ra bàn giao"><field name="kd_deliverable" required="1" readonly="id and not kd_task_can_write"/><field name="description" placeholder="Mô tả nội dung công việc, phạm vi và yêu cầu kỹ thuật…" readonly="id and not kd_task_can_write"/></group></sheet></form></field></record>
<record id="action_tasks" model="ir.actions.act_window"><field name="path">khkd-cong-viec</field><field name="view_id" ref="kd_task_list"/><field name="context">{'form_view_ref':'tp_kd_workspace.kd_task_form','tp_filter_profile':'kd_tasks'}</field><field name="help" type="html"><p class="o_view_nocontent_smiling_face">Chưa có công việc nào trong phạm vi hiển thị</p><p>Bấm Mới để giao công việc gắn với dự án quản lý và người phụ trách.</p></field></record></odoo>
