                </td>
                <td>
                  <button type="object" name="action_inbox" class="btn btn-outline-secondary" context="{'kd_source':'tp.allocation','kd_query':'overdue'}">
                    <field name="allocation_overdue_count" nolabel="1"/>
                  </button>
                </td>
                <td>
                  <button type="object" name="action_inbox" class="btn btn-outline-secondary" context="{'kd_source':'tp.allocation','kd_query':'due'}">
                    <field name="allocation_due_count" nolabel="1"/>
                  </button>
                </td>
              </tr>
              <tr>
                <th>Sản lượng tự khai</th>
