                <th>Tất cả</th>
                <th>Chờ tôi rà soát</th>
                <th>Trả lại cho tôi</th>
                <th>Quá hạn</th>
                <th>Đến hạn trong 3 ngày</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th>Giao khoán</th>
                <td>
                  <button type="object" name="action_inbox" class="btn btn-outline-secondary" context="{'kd_source':'tp.allocation','kd_query':'all'}">
                    <field name="allocation_all_count" nolabel="1"/>
                  </button>
                </td>
                <td>
                  <button type="object" name="action_inbox" class="btn btn-outline-secondary" context="{'kd_source':'tp.allocation','kd_query':'review'}">
                    <field name="allocation_review_count" nolabel="1"/>
                  </button>
                </td>
                <td>
                  <button type="object" name="action_inbox" class="btn btn-outline-secondary" context="{'kd_source':'tp.allocation','kd_query':'returned'}">
                    <field name="allocation_returned_count" nolabel="1"/>
