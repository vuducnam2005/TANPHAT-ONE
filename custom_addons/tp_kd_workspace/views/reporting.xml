  <record id="report_center_view" model="ir.ui.view">
    <field name="name">tp.kd.report.center.form</field>
    <field name="model">tp.kd.report.center</field>
    <field name="arch" type="xml">
      <form string="Báo cáo KH-KD" js_class="tp_kd_report_center" create="0" edit="0" delete="0">
        <sheet/>
      </form>
    </field>
  </record>

  <record id="action_reports" model="ir.actions.act_window">
    <field name="name">Báo cáo KH-KD</field>
    <field name="res_model">tp.kd.report.center</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="report_center_view"/>
    <field name="target">main</field>
  </record>

  <menuitem id="menu_reports" name="Báo cáo KH-KD" parent="menu_group_admin" action="action_reports" sequence="10"/>
</odoo>
