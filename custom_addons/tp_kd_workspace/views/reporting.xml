                  <button type="object" name="action_inbox" class="btn btn-outline-secondary" context="{'kd_source':'tp.production','kd_query':'all'}">
                    <field name="production_all_count" nolabel="1"/>
                  </button>
                </td>
                <td>
                  <button type="object" name="action_inbox" class="btn btn-outline-secondary" context="{'kd_source':'tp.production','kd_query':'review'}">
