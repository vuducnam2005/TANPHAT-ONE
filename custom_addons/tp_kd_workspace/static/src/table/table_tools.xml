<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- KD-UI-003: density + reset columns, before the pager (CSS order). Only KH-KD list controllers use it. -->
    <t t-name="tp_kd_workspace.TableTools">
        <div class="o_tp_kd_list_tools d-flex align-items-center gap-1 d-print-none" role="group" aria-label="Hiển thị bảng">
            <button t-if="this.state.headCreate" class="btn btn-primary" t-on-click="() => this.createHeadProject()">Tạo dự án KH-KD</button>
            <label class="tp_kd_page_size"><span>Hiển thị</span>
                <select aria-label="Số dòng mỗi trang" t-att-disabled="this.blocked or this.state.busy"
                        t-on-change="(ev) => this.changeSize(ev)">
                    <option t-foreach="this.pageSizes" t-as="n" t-key="n" t-att-value="n"
                            t-att-selected="n === this.controller.model.root.limit" t-out="n"/>
                </select>
                <span t-out="this.controller.model.root.isGrouped ? 'nhóm mỗi trang' : 'dòng mỗi trang'"/>
            </label>
            <details class="tp_kd_display_options"><summary>Tùy chọn bảng</summary>
            <div class="btn-group o_tp_kd_density" role="group" aria-label="Mật độ dòng">
                <button type="button" class="btn btn-secondary" t-att-class="{ active: !this.compact }"
                        t-att-aria-pressed="this.compact ? 'false' : 'true'" title="Dòng thoáng (44–52px)"
                        t-on-click="() => this.setDensity('comfortable')">Thoáng</button>
                <button type="button" class="btn btn-secondary" t-att-class="{ active: this.compact }"
                        t-att-aria-pressed="this.compact ? 'true' : 'false'" title="Dòng gọn (36–40px)"
                        t-on-click="() => this.setDensity('compact')">Gọn</button>
            </div>
            <button t-if="this.optionalColumns.length" type="button" class="btn btn-secondary o_tp_kd_reset_columns"
                    title="Khôi phục cột mặc định của bảng này" aria-label="Khôi phục cột mặc định"
                    t-on-click="() => this.resetColumns()">
                <i class="oi" data-icon="refresh" aria-hidden="true"/><span class="d-none d-xl-inline ms-1">Khôi phục cột</span>
            </button>
            </details>
        </div>
    </t>

    <t t-name="tp_kd_workspace.QuickFilters">
        <div class="tp_kd_filter_bar" t-att-class="{'is-open': this.state.open}" role="search" aria-label="Bộ lọc bảng">
            <div class="tp_kd_quick_states">
                <button type="button" class="btn tp_kd_filter_label" t-att-aria-expanded="this.state.open or !this.controller.uiService.isSmall ? 'true' : 'false'"
                        t-on-click="() => this.state.open = !this.state.open"><i class="fa fa-filter" aria-hidden="true"/> Bộ lọc</button>
                <button class="btn btn-outline-secondary tp_kd_clear" t-att-disabled="this.blocked" t-on-click="() => this.clearFilters()">Tất cả trong quyền</button>
                <button t-foreach="this.filters" t-as="item" t-key="item.id" class="btn btn-outline-secondary tp_kd_quick_filter"
                        t-att-class="{active: item.isActive}" t-att-aria-pressed="item.isActive ? 'true' : 'false'"
                        t-att-disabled="this.blocked" t-on-click="() => this.toggleFilter(item)" t-out="item.description"/>
            </div>
            <div class="tp_kd_field_filters">
                <t t-if="this.selectedField">
                    <select aria-label="Trường lọc" t-att-disabled="this.blocked" t-on-change="(ev) => { this.state.field = ev.target.value; this.state.value = ''; }">
                        <option t-foreach="this.filterFields" t-as="field" t-key="field.name" t-att-value="field.name"
                                t-att-selected="field.name === this.selectedField.name" t-out="field.string"/>
                    </select>
                    <select t-if="this.selectedField.type === 'selection'" aria-label="Giá trị lọc" t-att-disabled="this.blocked"
                            t-att-value="this.state.value" t-on-change="(ev) => { this.state.value = ev.target.value; this.addFilter(); }">
                        <option value="">Chọn giá trị…</option>
                        <option t-foreach="this.selectedField.selection" t-as="option" t-key="option[0]" t-att-value="option[0]" t-out="option[1]"/>
                    </select>
                    <input t-else="" aria-label="Giá trị lọc" placeholder="Nhập rồi nhấn Enter…" t-att-disabled="this.blocked"
                           t-att-type="['date', 'datetime'].includes(this.selectedField.type) ? 'date' : 'text'"
                           t-att-value="this.state.value" t-on-input="(ev) => this.state.value = ev.target.value"
                           t-on-keydown="(ev) => this.onFilterKey(ev)"/>
                    <button type="button" class="btn btn-primary" t-att-disabled="this.blocked or !this.state.value" t-on-click="() => this.addFilter()">Áp dụng</button>
                </t>
                <button type="button" class="btn btn-outline-primary tp_kd_advanced" t-att-disabled="this.blocked" t-on-click="() => this.advanced()">Bộ lọc nâng cao</button>
                <button type="button" class="btn btn-link tp_kd_clear_filters" t-att-disabled="this.blocked" t-on-click="() => this.clearFilters()">Xóa bộ lọc</button>
                <span t-if="this.blocked" class="text-muted">Lưu thay đổi để lọc</span>
            </div>
        </div>
    </t>

    <t t-name="tp_kd_workspace.SearchBar" t-inherit="web.SearchBar" t-inherit-mode="primary">
        <xpath expr="//div[@t-if='this.visibilityState.showSearchBar']" position="attributes">
            <attribute name="t-if">this.env.services.menu?.getCurrentApp()?.xmlid === 'tp_kd_workspace.menu_kd' or this.visibilityState.showSearchBar</attribute>
        </xpath>
    </t>

    <t t-name="tp_kd_workspace.ListView" t-inherit="web.ListView" t-inherit-mode="primary">
        <xpath expr="//t[@t-set-slot='control-panel-navigation-additional']/t[@t-if='!this.hasSelectedRecords']" position="attributes">
            <attribute name="t-if">!this.hasSelectedRecords and !this.kdEnabled</attribute>
        </xpath>
        <xpath expr="//t[@t-set-slot='control-panel-navigation-additional']" position="inside">
            <KdTableTools t-if="this.kdEnabled and !this.hasSelectedRecords" controller="this"/>
        </xpath>
        <xpath expr="//t[@t-set-slot='control-panel-actions']" position="inside">
            <KdQuickFilters t-if="this.kdEnabled" controller="this"/>
        </xpath>
    </t>
</templates>
