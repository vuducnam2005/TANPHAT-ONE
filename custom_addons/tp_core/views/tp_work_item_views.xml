<odoo>
    <record id="view_work_item_list" model="ir.ui.view">
        <field name="name">tp.work.item.list</field>
        <field name="model">tp.work.item</field>
        <field name="arch" type="xml">
            <list><field name="code"/><field name="name"/><field name="company_id"/><field name="active"/></list>
        </field>
    </record>
    <record id="view_work_item_form" model="ir.ui.view">
        <field name="name">tp.work.item.form</field>
        <field name="model">tp.work.item</field>
        <field name="arch" type="xml">
            <form><sheet><group><field name="code"/><field name="name"/><field name="company_id"/><field name="active"/></group></sheet></form>
        </field>
    </record>
    <record id="action_work_items" model="ir.actions.act_window">
        <field name="name">Work Item Catalog</field>
        <field name="res_model">tp.work.item</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_platform" name="TANPHAT ONE" sequence="20" groups="tp_core.group_user"/>
    <menuitem id="menu_work_items" name="Work Item Catalog" parent="menu_platform" action="action_work_items" sequence="90"/>
</odoo>
