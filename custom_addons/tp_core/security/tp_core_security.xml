<odoo>
    <record id="privilege_platform" model="res.groups.privilege">
        <field name="name">TANPHAT ONE</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>
    <record id="group_user" model="res.groups">
        <field name="name">Project Reader</field>
        <field name="privilege_id" ref="privilege_platform"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_manager" model="res.groups">
        <field name="name">Platform Manager</field>
        <field name="privilege_id" ref="privilege_platform"/>
        <field name="implied_ids" eval="[(4, ref('group_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
