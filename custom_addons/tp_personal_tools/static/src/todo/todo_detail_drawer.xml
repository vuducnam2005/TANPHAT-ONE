<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="tp_personal_tools.TodoDetailDrawer">
        <div class="tp-todo-drawer-backdrop" t-on-click="() => this.requestClose()"/>
        <aside class="tp-todo-drawer tp-pt-scope"
               t-att-class="{ 'is-expanded': this.state.expanded }"
               role="dialog"
               aria-modal="true"
               t-att-aria-label="this.props.isNew ? 'Thêm công việc cá nhân' : 'Chi tiết công việc cá nhân'"
               t-ref="this.drawerRef">

            <!-- Drawer Header -->
            <header class="tp-todo-drawer-header">
                <div class="d-flex align-items-center gap-2 min-w-0">
                    <span class="tp-todo-drawer-badge">
                        <t t-out="this.props.isNew ? 'Thêm việc mới' : (this.state.active ? 'Chi tiết công việc' : 'Đang lưu trữ')"/>
                    </span>
                    <span t-if="this.state.dirty" class="badge rounded-pill text-bg-warning">Chưa lưu</span>
                </div>
                <div class="d-flex align-items-center gap-1">
                    <button t-if="!this.props.isNew and this.state.id and !this.state.loadError"
                            type="button"
                            class="tp-pt-btn tp-pt-btn-sm d-none d-md-inline-flex"
                            t-on-click="() => (this.state.expanded = !this.state.expanded)"
                            t-att-aria-label="this.state.expanded ? 'Thu gọn khung chi tiết' : 'Mở rộng khung chi tiết'">
                        <i class="oi" t-att-data-icon="this.state.expanded ? 'close_fullscreen' : 'open_in_full'" aria-hidden="true"/>
                        <span t-out="this.state.expanded ? 'Thu gọn' : 'Mở rộng'"/>
                    </button>
                    <button type="button"
                            class="tp-pt-icon-btn"
                            aria-label="Đóng chi tiết công việc"
                            title="Đóng (Esc)"
                            t-on-click="() => this.requestClose()">
                        <i class="oi" data-icon="close" aria-hidden="true"/>
                    </button>
                </div>
            </header>

            <!-- Unsaved changes prompt -->
            <div t-if="this.state.confirmClosePrompt" class="tp-todo-unsaved-bar" role="alert">
                <div class="small fw-semibold">Bạn có thay đổi chưa lưu. Bạn muốn lưu lại trước khi đóng không?</div>
                <div class="d-flex gap-2 flex-wrap mt-2">
                    <button type="button" class="tp-pt-btn tp-pt-btn-sm tp-pt-btn-primary" t-on-click="() => this.onSave()">
                        Lưu thay đổi
                    </button>
                    <button type="button" class="tp-pt-btn tp-pt-btn-sm tp-pt-btn-danger" t-on-click="() => this.discardAndClose()">
                        Bỏ thay đổi
                    </button>
                    <button type="button" class="tp-pt-btn tp-pt-btn-sm" t-on-click="() => (this.state.confirmClosePrompt = false)">
                        Tiếp tục chỉnh sửa
                    </button>
                </div>
            </div>

            <!-- Loading / Access Error States -->
            <div t-if="this.state.loading" class="tp-todo-drawer-body d-flex align-items-center justify-content-center text-muted">
                <span>Đang tải chi tiết công việc…</span>
            </div>

            <div t-elif="this.state.loadError" class="tp-todo-drawer-body">
                <InlineErrors errors="[]" server="this.state.loadError"/>
                <div class="mt-2">
                    <button type="button" class="tp-pt-btn" t-on-click="() => this.discardAndClose()">Đóng</button>
                </div>
            </div>

            <!-- Main Ordered Form Content (Sections 1 -> 9) -->
            <div t-else="" class="tp-todo-drawer-body">
                <InlineErrors errors="this.fieldErrors" server="this.state.serverError" attempt="this.state.attempt"/>

                <!-- Source & Project Context Banner -->
                <div t-if="!this.props.isNew and (this.state.project or this.state.sourceKind !== 'self')" class="p-2 px-3 rounded-3 border bg-light small">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <span class="fw-semibold text-primary">
                            Nguồn: <t t-out="this.state.project ? ('Dự án · ' + this.state.project.name) : this.state.sourceLabel"/>
                        </span>
                        <span class="badge rounded-pill text-bg-secondary" t-out="this.state.execReportLabel"/>
                    </div>
                    <div t-if="this.state.assigner and this.state.sourceKind !== 'self'" class="text-muted mt-1">
                        Người giao: <strong class="text-dark" t-out="this.state.assigner.name"/>
                        <span t-if="this.state.verifier"> · Xác nhận bởi: <strong class="text-dark" t-out="this.state.verifier.name"/></span>
                    </div>
                    <div t-if="this.state.sourceMessageInfo?.channel_url" class="mt-1">
                        <a t-att-href="this.state.sourceMessageInfo.channel_url" class="fw-semibold text-decoration-none">
                            ↗ Mở tin nhắn gốc trong <t t-out="this.state.sourceMessageInfo.channel_name"/>
                        </a>
                    </div>
                </div>

                <!-- 1. Tiêu đề -->
                <div class="tp-pt-field">
                    <label class="tp-pt-label" for="tp_todo_drawer_name">
                        Tiêu đề công việc <span class="tp-pt-req">*</span>
                    </label>
                    <input id="tp_todo_drawer_name"
                           type="text"
                           class="tp-pt-input tp-todo-title-input"
                           t-att-class="{ 'is-invalid': this.fieldErrors.length > 0 }"
                           placeholder="Ví dụ: Rà soát hồ sơ thiết kế cầu vượt"
                           t-model.proxy="this.state.name"
                           t-on-input="() => this.markDirty()"
                           t-att-readonly="!this.state.canWrite"/>
                </div>

                <!-- 2. Hoàn thành / Ưu tiên / Giai đoạn cá nhân -->
                <div class="row g-2 align-items-end">
                    <div class="col-12 col-sm-4 tp-pt-field">
                        <label class="tp-pt-label">Trạng thái</label>
                        <button t-if="!this.state.requiresVerification"
                                type="button"
                                class="tp-pt-btn w-100 justify-content-start"
                                t-att-class="{ 'tp-todo-status-done': this.state.isDone }"
                                t-att-disabled="!this.state.canWrite"
                                t-on-click="() => (this.state.isDone = !this.state.isDone, this.markDirty())">
                            <i class="oi" t-att-data-icon="this.state.isDone ? 'check_circle' : 'radio_button_unchecked'" aria-hidden="true"/>
                            <span t-out="this.state.isDone ? 'Đã hoàn thành' : 'Đang thực hiện'"/>
                        </button>
                        <div t-else="" class="tp-pt-input d-flex align-items-center fw-semibold bg-light" t-out="this.state.execReportLabel"/>
                    </div>
                    <div class="col-6 col-sm-4 tp-pt-field">
                        <label class="tp-pt-label" for="tp_todo_drawer_priority">Mức ưu tiên</label>
                        <select id="tp_todo_drawer_priority"
                                class="tp-pt-select"
                                t-model.proxy="this.state.priority"
                                t-on-change="() => this.markDirty()"
                                t-att-disabled="!this.state.canWrite">
                            <option value="0">Bình thường</option>
                            <option value="1">Trung bình</option>
                            <option value="2">Cao</option>
                            <option value="3">Khẩn cấp</option>
                        </select>
                    </div>
                    <div class="col-6 col-sm-4 tp-pt-field">
                        <label class="tp-pt-label" for="tp_todo_drawer_stage">Giai đoạn cá nhân</label>
                        <select id="tp_todo_drawer_stage"
                                class="tp-pt-select"
                                t-model.proxy="this.state.stageId"
                                t-on-change="(ev) => this.onStageChangeForReadonlyTask(ev)">
                            <option t-foreach="this.state.stages"
                                    t-as="st"
                                    t-key="st.id"
                                    t-att-value="st.id"
                                    t-out="st.name"/>
                        </select>
                    </div>
                </div>

                <!-- 3. Hạn hoàn thành & Liên thông Lịch -->
                <div class="tp-todo-section-box">
                    <div class="row g-2 align-items-end">
                        <div class="col-12 col-sm-7 tp-pt-field">
                            <label class="tp-pt-label" for="tp_todo_drawer_deadline">Hạn hoàn thành (24h)</label>
                            <div class="d-flex gap-1 align-items-center">
                                <div class="flex-grow-1 min-w-0">
                                    <TpDateTime24Field id="'tp_todo_drawer_deadline'"
                                                       value="this.state.deadlineIso"
                                                       invalid="false"
                                                       disabled="!this.state.canWrite"
                                                       onChange="(val) => (this.state.deadlineIso = val, this.markDirty())"/>
                                </div>
                                <button t-if="this.state.deadlineIso and this.state.canWrite"
                                        type="button"
                                        class="tp-pt-btn tp-pt-btn-sm"
                                        title="Bỏ đặt hạn"
                                        aria-label="Xóa hạn hoàn thành"
                                        t-on-click="() => (this.state.deadlineIso = '', this.markDirty())">
                                    Xóa hạn
                                </button>
                            </div>
                        </div>
                        <div class="col-12 col-sm-5" t-if="!this.props.isNew and this.state.id">
                            <button type="button"
                                    class="tp-pt-btn w-100"
                                    style="border-color: #99f6e4; color: var(--tp-pt-cal-accent); background: var(--tp-pt-cal-soft);"
                                    t-on-click="() => this.openScheduleDialog()">
                                <i class="oi" data-icon="event" aria-hidden="true"/>
                                <span>Đưa vào lịch</span>
                            </button>
                        </div>
                    </div>
                    <div t-if="this.state.linkedEvents.length" class="mt-2 pt-2 border-top d-flex flex-column gap-1">
                        <div class="small fw-semibold text-muted">Lịch làm việc đã liên kết:</div>
                        <a t-foreach="this.state.linkedEvents"
                           t-as="ev"
                           t-key="ev.id"
                           t-att-href="ev.url"
                           class="tp-todo-linked-event-chip">
                            <i class="oi" data-icon="calendar_today" aria-hidden="true"/>
                            <strong t-out="ev.name"/>
                            <span class="text-muted ms-auto" t-out="ev.when_label"/>
                        </a>
                    </div>
                </div>

                <!-- 4. Người liên quan -->
                <div class="tp-pt-field">
                    <label class="tp-pt-label">Người liên quan (chia sẻ công việc)</label>
                    <TpColleaguePicker selected="this.state.assignees"
                                       keyField="'user_id'"
                                       lockedId="this.selfUserId"
                                       disabled="!this.state.canWrite"
                                       placeholder="'Mặc định riêng tư — tìm đồng nghiệp để chia sẻ…'"
                                       onChange="(list) => this.onAssigneesChange(list)"/>
                </div>

                <!-- 5. Nhãn -->
                <div class="tp-pt-field">
                    <label class="tp-pt-label">Nhãn phân loại</label>
                    <div class="d-flex flex-wrap gap-1 mb-1" t-if="this.state.allTags.length">
                        <button t-foreach="this.state.allTags"
                                t-as="tg"
                                t-key="tg.id"
                                type="button"
                                class="tp-todo-tag-pill"
                                t-att-class="{ 'is-selected': this.isTagSelected(tg.id) }"
                                t-att-aria-pressed="this.isTagSelected(tg.id) ? 'true' : 'false'"
                                t-on-click="() => this.toggleTag(tg.id)">
                            <span t-out="tg.name"/>
                        </button>
                    </div>
                    <div t-if="this.state.canWrite" class="d-flex gap-2">
                        <input type="text"
                               class="tp-pt-input"
                               placeholder="Tạo nhãn mới (ví dụ: Hồ sơ, Họp tuần)…"
                               t-model.proxy="this.state.newTagName"
                               t-on-keydown="(ev) => this.onNewTagKeydown(ev)"/>
                        <button type="button"
                                class="tp-pt-btn tp-pt-btn-sm"
                                t-att-disabled="!this.state.newTagName.trim()"
                                t-on-click="() => this.createQuickTag()">
                            + Thêm nhãn
                        </button>
                    </div>
                </div>

                <!-- 6. Đầu ra cần đạt & Nội dung -->
                <div class="tp-pt-field">
                    <label class="tp-pt-label" for="tp_todo_drawer_deliverable">Đầu ra cần đạt</label>
                    <input id="tp_todo_drawer_deliverable"
                           type="text"
                           class="tp-pt-input"
                           placeholder="Ví dụ: Bản vẽ hiệu chỉnh PDF, Biên bản đối chiếu khối lượng…"
                           t-model.proxy="this.state.deliverable"
                           t-on-input="() => this.markDirty()"
                           t-att-readonly="!this.state.canWrite"/>
                </div>

                <!-- Two-step Execution Report & Verification Box (for assigned / project tasks) -->
                <div t-if="!this.props.isNew and this.state.id and this.state.requiresVerification" class="tp-todo-section-box">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <label class="tp-pt-label mb-0">Báo cáo kết quả &amp; Xác nhận</label>
                        <span class="badge rounded-pill text-bg-light border text-dark" t-out="this.state.execReportLabel"/>
                    </div>
                    <textarea class="tp-pt-textarea mb-2"
                              rows="2"
                              placeholder="Ghi kết quả đã hoàn thành, số liệu hoặc đường dẫn tài liệu minh chứng…"
                              t-model.proxy="this.state.reportedResult"
                              t-att-readonly="!(this.state.canReportDone or this.state.canVerify)"/>
                    <div class="d-flex flex-wrap gap-2">
                        <button t-if="this.state.canReportDone and this.state.execReportState !== 'verified'"
                                type="button"
                                class="tp-pt-btn tp-pt-btn-sm tp-pt-btn-primary"
                                t-att-disabled="this.state.reportingBusy"
                                t-on-click="() => this.onReportOrVerify('report_done')">
                            <span t-out="this.state.execReportState === 'reported_done' ? 'Cập nhật báo xong' : 'Báo hoàn thành'"/>
                        </button>
                        <button t-if="this.state.canVerify and this.state.execReportState !== 'verified'"
                                type="button"
                                class="tp-pt-btn tp-pt-btn-sm tp-pt-btn-teal"
                                t-att-disabled="this.state.reportingBusy"
                                t-on-click="() => this.onReportOrVerify('verify')">
                            Xác nhận kết quả đạt
                        </button>
                        <button t-if="(this.state.canVerify or this.state.canReportDone) and this.state.execReportState !== 'in_progress'"
                                type="button"
                                class="tp-pt-btn tp-pt-btn-sm"
                                t-att-disabled="this.state.reportingBusy"
                                t-on-click="() => this.onReportOrVerify('reopen')">
                            Mở lại thực hiện
                        </button>
                    </div>
                </div>

                <div class="tp-pt-field">
                    <label class="tp-pt-label" for="tp_todo_drawer_note">Nội dung chi tiết</label>
                    <textarea id="tp_todo_drawer_note"
                              class="tp-pt-textarea"
                              rows="4"
                              placeholder="Ghi chú nội dung, tài liệu tham chiếu hoặc yêu cầu cần lưu ý…"
                              t-model.proxy="this.state.noteText"
                              t-on-input="() => this.markDirty()"
                              t-att-readonly="!this.state.canWrite"/>
                </div>

                <!-- 7. Danh sách kiểm tra công việc -->
                <div class="tp-todo-section-box">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <label class="tp-pt-label">Danh sách kiểm tra</label>
                        <span t-if="this.state.checklist.length" class="small text-muted">
                            <t t-out="this.state.checklist.filter((c) => c.checked).length"/>/<t t-out="this.state.checklist.length"/> hoàn thành
                        </span>
                    </div>
                    <div t-if="this.state.checklist.length" class="d-flex flex-column gap-1 mb-2">
                        <div t-foreach="this.state.checklist"
                             t-as="chk"
                             t-key="chk.key"
                             class="tp-todo-check-row"
                             t-att-class="{ 'is-checked': chk.checked }">
                            <input type="checkbox"
                                   class="form-check-input mt-0 cursor-pointer"
                                   t-att-checked="chk.checked"
                                   t-att-disabled="!this.state.canWrite"
                                   t-on-change="() => this.toggleChecklistItem(chk)"/>
                            <input type="text"
                                   class="tp-todo-check-text"
                                   t-model.proxy="chk.text"
                                   t-on-input="() => this.markDirty()"
                                   t-att-readonly="!this.state.canWrite"/>
                            <button t-if="this.state.canWrite"
                                    type="button"
                                    class="tp-pt-icon-btn"
                                    style="width: 28px; height: 28px;"
                                    aria-label="Xóa mục kiểm tra"
                                    t-on-click="() => this.removeChecklistItem(chk.key)">
                                <i class="oi" data-icon="close_small" aria-hidden="true"/>
                            </button>
                        </div>
                    </div>
                    <div t-if="this.state.canWrite" class="d-flex gap-2">
                        <input type="text"
                               class="tp-pt-input"
                               placeholder="Nhập mục cần kiểm tra rồi nhấn Enter…"
                               t-model.proxy="this.state.newCheckText"
                               t-on-keydown="(ev) => this.onChecklistKeydown(ev)"/>
                        <button type="button"
                                class="tp-pt-btn tp-pt-btn-sm"
                                t-att-disabled="!this.state.newCheckText.trim()"
                                t-on-click="() => this.addChecklistItem()">
                            Thêm mục
                        </button>
                    </div>
                </div>

                <!-- 8. Tệp đính kèm -->
                <div t-if="!this.props.isNew and this.state.id" class="tp-todo-section-box">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <label class="tp-pt-label">Tệp đính kèm / Minh chứng (<t t-out="this.state.attachments.length"/>)</label>
                        <div t-if="this.state.canUploadEvidence">
                            <input type="file"
                                   multiple="multiple"
                                   class="d-none"
                                   t-ref="this.fileInputRef"
                                   t-on-change="(ev) => this.onFileSelected(ev)"/>
                            <button type="button"
                                    class="tp-pt-btn tp-pt-btn-sm"
                                    t-att-disabled="this.state.uploading"
                                    t-on-click="() => this.fileInputRef()?.click()">
                                <i class="oi" data-icon="attach_file" aria-hidden="true"/>
                                <span t-out="this.state.uploading ? 'Đang tải lên…' : 'Đính kèm tệp'"/>
                            </button>
                        </div>
                    </div>
                    <div t-if="!this.state.attachments.length" class="small text-muted">
                        Chưa có tệp đính kèm.
                    </div>
                    <div t-else="" class="d-flex flex-column gap-2">
                        <div t-foreach="this.state.attachments"
                             t-as="att"
                             t-key="att.id"
                             class="tp-todo-attachment-row">
                            <img t-if="att.is_image" t-att-src="att.preview_url" class="tp-todo-att-thumb" alt=""/>
                            <i t-else="" class="oi fs-5 text-muted" data-icon="description" aria-hidden="true"/>
                            <div class="min-w-0 flex-grow-1">
                                <a t-att-href="att.preview_url" target="_blank" rel="noopener" class="fw-semibold small text-truncate d-block" t-out="att.name"/>
                                <span class="text-muted" style="font-size: 11.5px;" t-out="this.formatBytes(att.file_size)"/>
                            </div>
                            <a t-att-href="att.download_url"
                               class="tp-pt-icon-btn"
                               title="Tải xuống"
                               aria-label="Tải tệp xuống">
                                <i class="oi" data-icon="download" aria-hidden="true"/>
                            </a>
                            <button t-if="att.can_delete"
                                    type="button"
                                    class="tp-pt-icon-btn text-danger"
                                    title="Xóa tệp"
                                    aria-label="Xóa tệp đính kèm"
                                    t-on-click="() => this.removeAttachment(att)">
                                <i class="oi" data-icon="delete" aria-hidden="true"/>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- 9. Trao đổi / lịch sử -->
                <div t-if="!this.props.isNew and this.state.id" class="tp-todo-section-box">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <label class="tp-pt-label">Trao đổi &amp; Lịch sử</label>
                        <button type="button"
                                class="tp-pt-btn tp-pt-btn-sm"
                                t-on-click="() => this.openShareDialog()">
                            <i class="oi" data-icon="share" aria-hidden="true"/>
                            <span>Chia sẻ qua Trao đổi</span>
                        </button>
                    </div>
                    <div class="d-flex gap-2 mb-3">
                        <input type="text"
                               class="tp-pt-input"
                               placeholder="Viết ghi chú hoặc phản hồi trên công việc này…"
                               t-model.proxy="this.state.commentDraft"
                               t-att-disabled="this.state.postingComment"
                               t-on-keydown="(ev) => this.onCommentKeydown(ev)"/>
                        <button type="button"
                                class="tp-pt-btn tp-pt-btn-primary tp-pt-btn-sm"
                                t-att-disabled="this.state.postingComment or !this.state.commentDraft.trim()"
                                t-on-click="() => this.postComment()">
                            <span t-out="this.state.postingComment ? 'Đang gửi…' : 'Gửi'"/>
                        </button>
                    </div>
                    <div t-if="!this.state.messages.length" class="small text-muted">
                        Chưa có ghi chú trao đổi nào.
                    </div>
                    <div t-else="" class="d-flex flex-column gap-2">
                        <div t-foreach="this.state.messages"
                             t-as="msg"
                             t-key="msg.id"
                             class="tp-todo-msg-item">
                            <img t-if="msg.author_avatar" t-att-src="msg.author_avatar" class="tp-todo-msg-avatar" alt=""/>
                            <div class="min-w-0 flex-grow-1">
                                <div class="d-flex align-items-baseline justify-content-between gap-2">
                                    <strong class="small" t-out="msg.author_name"/>
                                    <span class="text-muted" style="font-size: 11.5px;" t-out="msg.date_label"/>
                                </div>
                                <div class="small mt-1 text-break" style="white-space: pre-line;" t-out="msg.body_text"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Drawer Footer Actions -->
            <footer t-if="!this.state.loading and !this.state.loadError" class="tp-todo-drawer-footer">
                <div t-if="!this.props.isNew and this.state.id and this.state.canWrite" class="d-flex gap-2">
                    <button type="button"
                            class="tp-pt-btn tp-pt-btn-sm"
                            t-att-disabled="this.state.saving"
                            t-on-click="() => this.toggleArchive()">
                        <i class="oi" t-att-data-icon="this.state.active ? 'archive' : 'unarchive'" aria-hidden="true"/>
                        <span t-out="this.state.active ? 'Lưu trữ' : 'Khôi phục'"/>
                    </button>
                    <button type="button"
                            class="tp-pt-btn tp-pt-btn-sm tp-pt-btn-danger"
                            t-att-disabled="this.state.saving"
                            t-on-click="() => this.confirmDelete()">
                        <i class="oi" data-icon="delete" aria-hidden="true"/>
                        <span>Xóa</span>
                    </button>
                </div>
                <div class="d-flex gap-2 ms-auto">
                    <button type="button" class="tp-pt-btn" t-on-click="() => this.requestClose()" t-att-disabled="this.state.saving">
                        Đóng
                    </button>
                    <button t-if="this.state.canWrite"
                            type="button"
                            class="tp-pt-btn tp-pt-btn-primary"
                            t-on-click="() => this.onSave()"
                            t-att-disabled="this.state.saving">
                        <span t-if="this.state.saving">Đang lưu…</span>
                        <span t-elif="this.props.isNew">Tạo công việc</span>
                        <span t-else="">Lưu thay đổi</span>
                    </button>
                </div>
            </footer>
        </aside>
    </t>
</templates>
