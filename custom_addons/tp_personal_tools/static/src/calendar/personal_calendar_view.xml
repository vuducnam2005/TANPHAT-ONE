<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="tp_personal_tools.PersonalCalendarController">
        <div t-att-class="'tp-pt-scope o_tp_personal_calendar h-100 d-flex flex-column ' + (this.className || '')">
            <!-- 1. Top Toolbar -->
            <header class="tp-cal-topbar">
                <div class="tp-cal-topbar-left">
                    <button type="button"
                        class="tp-pt-icon-btn tp-cal-sidebar-toggle"
                        aria-label="Đóng/mở thanh bên lịch"
                        title="Đóng/mở thanh bên lịch"
                        t-on-click="() => this.toggleSidebarButton()">
                        ☰
                    </button>
                    <div class="tp-cal-brand-title">
                        <span class="tp-cal-brand-dot" aria-hidden="true"/>
                        <h1 class="tp-cal-page-heading">Lịch làm việc</h1>
                    </div>
                </div>

                <div class="tp-cal-topbar-nav">
                    <button type="button"
                        class="tp-pt-btn tp-pt-btn-sm"
                        t-on-click="() => this.navigatePeriod('today')">
                        Hôm nay
                    </button>
                    <div class="tp-cal-arrow-group" role="group" aria-label="Điều hướng khoảng thời gian">
                        <button type="button"
                            class="tp-pt-icon-btn"
                            aria-label="Khoảng trước"
                            title="Khoảng trước"
                            t-on-click="() => this.navigatePeriod('previous')">
                            ‹
                        </button>
                        <button type="button"
                            class="tp-pt-icon-btn"
                            aria-label="Khoảng tiếp theo"
                            title="Khoảng tiếp theo"
                            t-on-click="() => this.navigatePeriod('next')">
                            ›
                        </button>
                    </div>
                    <span class="tp-cal-period-label" t-out="this.activePeriodLabel"/>
                </div>

                <div class="tp-cal-topbar-right">
                    <div class="tp-cal-search-wrap">
                        <input type="search"
                            class="tp-pt-input tp-cal-search-input"
                            placeholder="Tìm lịch, địa điểm…"
                            aria-label="Tìm kiếm lịch làm việc"
                            t-att-value="this.tpState.searchQuery"
                            t-on-input="(ev) => this.onSearchInput(ev)"/>
                        <button t-if="this.tpState.searchQuery"
                            type="button"
                            class="tp-cal-search-clear"
                            aria-label="Xóa từ khóa tìm kiếm"
                            t-on-click="() => this.clearSearch()">
                            ✕
                        </button>
                    </div>

                    <div class="tp-cal-mode-switcher" role="tablist" aria-label="Chế độ xem lịch">
                        <button type="button"
                            role="tab"
                            t-att-aria-selected="this.tpState.viewMode === 'day'"
                            t-att-class="'tp-cal-mode-btn ' + (this.tpState.viewMode === 'day' ? 'is-active' : '')"
                            t-on-click="() => this.switchViewMode('day')">
                            Ngày
                        </button>
                        <button type="button"
                            role="tab"
                            t-att-aria-selected="this.tpState.viewMode === 'week'"
                            t-att-class="'tp-cal-mode-btn ' + (this.tpState.viewMode === 'week' ? 'is-active' : '')"
                            t-on-click="() => this.switchViewMode('week')">
                            Tuần
                        </button>
                        <button type="button"
                            role="tab"
                            t-att-aria-selected="this.tpState.viewMode === 'month'"
                            t-att-class="'tp-cal-mode-btn ' + (this.tpState.viewMode === 'month' ? 'is-active' : '')"
                            t-on-click="() => this.switchViewMode('month')">
                            Tháng
                        </button>
                        <button type="button"
                            role="tab"
                            t-att-aria-selected="this.tpState.viewMode === 'agenda'"
                            t-att-class="'tp-cal-mode-btn ' + (this.tpState.viewMode === 'agenda' ? 'is-active' : '')"
                            t-on-click="() => this.switchViewMode('agenda')">
                            Danh sách
                        </button>
                    </div>

                    <button type="button"
                        class="tp-pt-btn tp-pt-btn-teal tp-cal-create-btn"
                        t-on-click="() => this.onClickAddButton()">
                        + Tạo lịch
                    </button>
                </div>
            </header>

            <!-- 2. Workspace Body (Single Left Sidebar + Main Calendar/Agenda) -->
            <div class="tp-cal-body flex-grow-1 d-flex overflow-hidden position-relative">
                <!-- Mobile Backdrop -->
                <div t-if="this.tpState.sidebarOpenMobile"
                    class="tp-cal-mobile-backdrop"
                    t-on-click="() => (this.tpState.sidebarOpenMobile = false)"/>

                <!-- Single Left Sidebar -->
                <aside t-att-class="'tp-cal-sidebar ' + (this.tpState.sidebarOpenDesktop ? 'is-open-desktop ' : 'is-collapsed-desktop ') + (this.tpState.sidebarOpenMobile ? 'is-open-mobile' : '')"
                    aria-label="Điều hướng và bộ lọc Lịch làm việc">
                    <!-- Mini Month Calendar -->
                    <section class="tp-cal-mini">
                        <div class="tp-cal-mini-head">
                            <span class="tp-cal-mini-title" t-out="this.miniCalendarTitle"/>
                            <div class="d-flex gap-1">
                                <button type="button" class="tp-pt-icon-btn tp-cal-mini-nav" aria-label="Tháng trước" t-on-click="() => this.moveMiniMonth(-1)">‹</button>
                                <button type="button" class="tp-pt-icon-btn tp-cal-mini-nav" aria-label="Tháng sau" t-on-click="() => this.moveMiniMonth(1)">›</button>
                            </div>
                        </div>
                        <div class="tp-cal-mini-weekdays">
                            <span t-foreach="this.MINI_WEEKDAYS" t-as="wd" t-key="wd" t-out="wd"/>
                        </div>
                        <div class="tp-cal-mini-grid">
                            <t t-foreach="this.miniCalendarWeeks" t-as="wk" t-key="wk.key">
                                <button t-foreach="wk.days" t-as="d" t-key="d.iso"
                                    type="button"
                                    t-att-class="'tp-cal-mini-day ' + (!d.inMonth ? 'is-outside ' : '') + (d.isToday ? 'is-today ' : '') + (d.isSelected ? 'is-selected' : '')"
                                    t-on-click="() => this.onSelectMiniDate(d.iso)"
                                    t-out="d.dayNum"/>
                            </t>
                        </div>
                    </section>

                    <!-- My Calendars -->
                    <section class="tp-cal-side-section">
                        <div class="tp-cal-side-heading">
                            <span>Lịch của tôi</span>
                            <button type="button"
                                class="tp-cal-link-btn"
                                t-on-click="() => (this.tpState.showNewCalForm = !this.tpState.showNewCalForm)">
                                <t t-if="this.tpState.showNewCalForm">Đóng</t>
                                <t t-else="">+ Thêm lịch</t>
                            </button>
                        </div>

                        <div t-if="this.tpState.showNewCalForm" class="tp-cal-new-cal-box mb-2">
                            <input type="text"
                                class="tp-pt-input mb-2"
                                placeholder="Tên lịch mới (VD: Lịch khảo sát)…"
                                t-model.proxy="this.tpState.newCalName"/>
                            <div class="d-flex gap-1 mb-2">
                                <button t-foreach="this.CALENDAR_COLOR_PALETTE" t-as="cp" t-key="cp.id"
                                    type="button"
                                    t-att-class="'tp-cal-color-swatch ' + (this.tpState.newCalColor === cp.id ? 'is-picked' : '')"
                                    t-att-style="'background:' + cp.hex"
                                    t-att-aria-label="cp.label"
                                    t-on-click="() => (this.tpState.newCalColor = cp.id)"/>
                            </div>
                            <select class="tp-pt-select mb-2" t-model.proxy="this.tpState.newCalPrivacy">
                                <option value="public">Công khai nội bộ</option>
                                <option value="members_only">Chỉ người được chia sẻ</option>
                                <option value="private">Riêng tư (chỉ hiện Bận)</option>
                            </select>
                            <TpColleaguePicker
                                selected="this.tpState.newCalShareUsers"
                                keyField="'user_id'"
                                includeSelf="false"
                                placeholder="'Chia sẻ lịch cho đồng nghiệp…'"
                                onChange="(list) => (this.tpState.newCalShareUsers = list)"
                            />
                            <div class="d-flex justify-content-end gap-1 mt-2">
                                <button type="button"
                                    class="tp-pt-btn tp-pt-btn-sm tp-pt-btn-teal"
                                    t-att-disabled="!this.tpState.newCalName.trim() or this.tpState.creatingCal"
                                    t-on-click="() => this.onCreateNewCalendar()">
                                    Lưu lịch
                                </button>
                            </div>
                        </div>

                        <div class="tp-cal-filter-list">
                            <label t-foreach="this.tpState.myCalendars" t-as="cal" t-key="cal.calendar_user_id" class="tp-cal-filter-item">
                                <input type="checkbox"
                                    t-att-checked="cal.checked"
                                    t-on-change="(ev) => this.onToggleCalendarItem(cal, ev)"/>
                                <span t-attf-class="tp-cal-color-dot o_calendar_color_{{cal.color}}"/>
                                <span class="tp-cal-filter-name text-truncate" t-out="cal.name"/>
                                <span t-if="cal.is_primary" class="tp-cal-role-tag">Mặc định</span>
                            </label>
                        </div>
                    </section>

                    <!-- Shared Calendars -->
                    <section t-if="this.tpState.sharedCalendars.length" class="tp-cal-side-section">
                        <div class="tp-cal-side-heading">
                            <span>Lịch được chia sẻ</span>
                        </div>
                        <div class="tp-cal-filter-list">
                            <label t-foreach="this.tpState.sharedCalendars" t-as="scal" t-key="scal.calendar_user_id" class="tp-cal-filter-item">
                                <input type="checkbox"
                                    t-att-checked="scal.checked"
                                    t-on-change="(ev) => this.onToggleCalendarItem(scal, ev)"/>
                                <span t-attf-class="tp-cal-color-dot o_calendar_color_{{scal.color}}"/>
                                <span class="tp-cal-filter-name text-truncate" t-out="scal.name"/>
                                <span class="tp-cal-role-tag" t-out="scal.can_write ? 'Được sửa' : 'Chỉ xem'"/>
                            </label>
                        </div>
                    </section>

                    <!-- Colleague Schedule Overlay Filter -->
                    <section class="tp-cal-side-section">
                        <div class="tp-cal-side-heading">
                            <span>Xem cùng đồng nghiệp</span>
                        </div>
                        <div class="mb-2">
                            <TpColleaguePicker
                                selected="[]"
                                multiple="false"
                                keyField="'partner_id'"
                                includeSelf="false"
                                placeholder="'Thêm đồng nghiệp để đối chiếu…'"
                                onChange="(items) => this.onAddColleagueFilter(items)"
                            />
                        </div>
                        <div t-if="this.tpState.colleagueFilters.length" class="tp-cal-filter-list">
                            <div t-foreach="this.tpState.colleagueFilters" t-as="cf" t-key="cf.filter_id" class="tp-cal-filter-item">
                                <input type="checkbox"
                                    t-att-checked="cf.active"
                                    t-on-change="(ev) => this.onToggleColleagueFilter(cf, ev)"/>
                                <img class="tp-cal-avatar-xs" t-att-src="cf.avatar_url" alt=""/>
                                <span class="tp-cal-filter-name text-truncate" t-out="cf.name"/>
                                <button type="button"
                                    class="tp-cal-remove-filter"
                                    aria-label="Bỏ đồng nghiệp khỏi bộ lọc"
                                    t-on-click="() => this.onRemoveColleagueFilter(cf)">
                                    ✕
                                </button>
                            </div>
                        </div>
                    </section>

                    <!-- Color & Status Legend -->
                    <section class="tp-cal-side-section tp-cal-legend">
                        <div class="tp-cal-side-heading">
                            <span>Chú giải hiển thị</span>
                        </div>
                        <div class="tp-cal-legend-items">
                            <div class="tp-cal-legend-row"><span class="tp-cal-legend-swatch is-accepted"/> Đã chấp nhận tham gia</div>
                            <div class="tp-cal-legend-row"><span class="tp-cal-legend-swatch is-pending"/> Chờ phản hồi / Chưa chắc</div>
                            <div class="tp-cal-legend-row"><span class="tp-cal-legend-swatch is-private"/> Lịch riêng tư (hiện Bận)</div>
                            <div class="tp-cal-legend-row"><span class="tp-cal-legend-swatch is-workhours"/> Khung giờ hành chính 08:30–17:00</div>
                        </div>
                    </section>
                </aside>

                <!-- Main Calendar / Agenda Stage -->
                <main class="tp-cal-main flex-grow-1 d-flex flex-column overflow-hidden min-w-0">
                    <div t-if="this.tpState.bannerError" class="px-3 pt-2 d-flex align-items-start gap-2">
                        <div class="flex-grow-1">
                            <InlineErrors errors="[]" server="this.tpState.bannerError"/>
                        </div>
                        <button type="button" class="tp-pt-btn tp-pt-btn-sm" t-on-click="() => (this.tpState.bannerError = null)">
                            Ẩn thông báo
                        </button>
                    </div>

                    <!-- A. Native FullCalendar Views (Day / Week / Month) -->
                    <div t-if="this.tpState.viewMode !== 'agenda'" class="tp-cal-fc-stage flex-grow-1 overflow-hidden">
                        <t t-component="this.props.Renderer" t-props="this.rendererProps"/>
                    </div>

                    <!-- B. Danh sách (Agenda) View -->
                    <div t-else="" class="tp-cal-agenda-stage flex-grow-1 d-flex flex-column overflow-hidden">
                        <!-- Agenda Filter Bar (DEC-044) -->
                        <div class="tp-cal-agenda-toolbar">
                            <div class="d-flex flex-wrap align-items-end gap-2">
                                <div class="tp-cal-filter-field">
                                    <label class="tp-cal-mini-label">Từ ngày</label>
                                    <input type="date" class="tp-pt-input tp-pt-input-compact"
                                        t-model.proxy="this.tpState.agendaDateFrom"
                                        t-on-change="() => (this.tpState.agendaPage = 1, this.loadAgenda())"/>
                                </div>
                                <div class="tp-cal-filter-field">
                                    <label class="tp-cal-mini-label">Đến ngày</label>
                                    <input type="date" class="tp-pt-input tp-pt-input-compact"
                                        t-model.proxy="this.tpState.agendaDateTo"
                                        t-on-change="() => (this.tpState.agendaPage = 1, this.loadAgenda())"/>
                                </div>
                                <div class="tp-cal-filter-field">
                                    <label class="tp-cal-mini-label">Loại lịch</label>
                                    <select class="tp-pt-select tp-pt-input-compact"
                                        t-model.proxy="this.tpState.agendaEventKind"
                                        t-on-change="() => (this.tpState.agendaPage = 1, this.loadAgenda())">
                                        <option value="">Tất cả loại lịch</option>
                                        <option value="personal">Cá nhân</option>
                                        <option value="meeting">Họp</option>
                                        <option value="field_trip">Công tác / Hiện trường</option>
                                        <option value="department">Lịch phòng / Công ty</option>
                                    </select>
                                </div>
                                <div class="tp-cal-filter-field" t-if="this.tpState.rooms.length">
                                    <label class="tp-cal-mini-label">Phòng họp</label>
                                    <select class="tp-pt-select tp-pt-input-compact"
                                        aria-label="Lọc theo phòng họp"
                                        t-model.proxy="this.tpState.agendaRoomId"
                                        t-on-change="() => (this.tpState.agendaPage = 1, this.loadAgenda())">
                                        <option value="0">Tất cả phòng họp</option>
                                        <option t-foreach="this.tpState.rooms" t-as="rm" t-key="rm.id" t-att-value="rm.id" t-out="rm.name"/>
                                    </select>
                                </div>
                                <div class="tp-cal-filter-field">
                                    <label class="tp-cal-mini-label">Phản hồi của tôi</label>
                                    <select class="tp-pt-select tp-pt-input-compact"
                                        t-model.proxy="this.tpState.agendaResponseState"
                                        t-on-change="() => (this.tpState.agendaPage = 1, this.loadAgenda())">
                                        <option value="">Tất cả trạng thái</option>
                                        <option value="needsAction">Chờ phản hồi</option>
                                        <option value="accepted">Đã chấp nhận</option>
                                        <option value="tentative">Chưa chắc chắn</option>
                                        <option value="declined">Đã từ chối</option>
                                    </select>
                                </div>
                                <div class="tp-cal-filter-field">
                                    <label class="tp-cal-mini-label">Mức riêng tư</label>
                                    <select class="tp-pt-select tp-pt-input-compact"
                                        t-model.proxy="this.tpState.agendaPrivacy"
                                        t-on-change="() => (this.tpState.agendaPage = 1, this.loadAgenda())">
                                        <option value="">Tất cả mức hiển thị</option>
                                        <option value="public">Công khai nội bộ</option>
                                        <option value="confidential">Chỉ nội bộ công ty</option>
                                        <option value="members_only">Chỉ thành viên lịch</option>
                                        <option value="private">Riêng tư</option>
                                    </select>
                                </div>
                                <button type="button"
                                    class="tp-pt-btn tp-pt-btn-sm"
                                    t-on-click="() => (this.tpState.agendaFiltersOpen = !this.tpState.agendaFiltersOpen)">
                                    Lọc theo chủ trì
                                </button>
                                <button t-if="this.activeAgendaFilterChips.length"
                                    type="button"
                                    class="tp-pt-btn tp-pt-btn-sm"
                                    t-on-click="() => this.resetAgendaFilters()">
                                    Xóa bộ lọc
                                </button>
                            </div>

                            <div t-if="this.tpState.agendaFiltersOpen" class="mt-2" style="max-width: 340px;">
                                <TpColleaguePicker
                                    selected="this.tpState.agendaOrganizer"
                                    multiple="false"
                                    keyField="'user_id'"
                                    includeSelf="true"
                                    placeholder="'Chọn người chủ trì cuộc họp…'"
                                    onChange="(list) => (this.tpState.agendaOrganizer = list, this.tpState.agendaPage = 1, this.loadAgenda())"
                                />
                            </div>

                            <div t-if="this.activeAgendaFilterChips.length" class="tp-cal-active-chips mt-2">
                                <span t-foreach="this.activeAgendaFilterChips" t-as="chip" t-key="chip.key" class="tp-cal-filter-chip">
                                    <span t-out="chip.label"/>
                                    <button type="button" aria-label="Gỡ điều kiện lọc" t-on-click="() => this.removeAgendaChip(chip)">✕</button>
                                </span>
                            </div>
                        </div>

                        <!-- Agenda Content -->
                        <div class="tp-cal-agenda-scroll flex-grow-1 overflow-auto">
                            <div t-if="this.tpState.agendaLoading" class="tp-cal-empty-state">
                                <p class="text-muted mb-0">Đang tải danh sách lịch làm việc…</p>
                            </div>

                            <div t-elif="!this.tpState.agendaGroups.length" class="tp-cal-empty-state">
                                <t t-if="this.activeAgendaFilterChips.length">
                                    <h4 class="tp-cal-empty-title">Không có sự kiện khớp điều kiện lọc</h4>
                                    <p class="tp-cal-empty-sub">Thử mở rộng khoảng ngày hoặc xóa bớt bộ lọc để xem các lịch khác.</p>
                                    <button type="button" class="tp-pt-btn" t-on-click="() => this.resetAgendaFilters()">
                                        Xóa bộ lọc
                                    </button>
                                </t>
                                <t t-else="">
                                    <h4 class="tp-cal-empty-title">Chưa có lịch trong khoảng thời gian này</h4>
                                    <p class="tp-cal-empty-sub">Tạo lịch họp, khảo sát hoặc công việc để chủ động sắp xếp thời gian.</p>
                                    <button type="button" class="tp-pt-btn tp-pt-btn-teal" t-on-click="() => this.onClickAddButton()">
                                        + Tạo lịch
                                    </button>
                                </t>
                            </div>

                            <div t-else="" class="tp-cal-agenda-groups">
                                <section t-foreach="this.tpState.agendaGroups" t-as="grp" t-key="grp.day_key" class="tp-cal-day-group">
                                    <div t-att-class="'tp-cal-day-banner ' + (grp.is_today ? 'is-today' : '')">
                                        <span t-out="grp.day_label"/>
                                        <span class="tp-cal-day-count"><t t-out="grp.events.length"/> sự kiện</span>
                                    </div>

                                    <div class="tp-cal-day-cards">
                                        <article t-foreach="grp.events" t-as="evCard" t-key="evCard.id"
                                            t-att-class="'tp-cal-agenda-row ' + (evCard.is_masked_private ? 'is-private' : '')"
                                            t-on-click="() => this.openEventDialog(evCard.id)">
                                            <div class="tp-cal-ag-time">
                                                <span class="tp-cal-ag-clock" t-out="evCard.short_time"/>
                                                <span t-if="evCard.calendar_name" class="tp-cal-ag-cal" t-out="evCard.calendar_name"/>
                                            </div>

                                            <div class="tp-cal-ag-main min-w-0 flex-grow-1">
                                                <div class="d-flex flex-wrap align-items-center gap-2">
                                                    <h5 class="tp-cal-ag-title mb-0" t-out="evCard.name"/>
                                                    <span t-if="!evCard.is_masked_private and evCard.event_kind_label" class="tp-cal-mini-badge" t-out="evCard.event_kind_label"/>
                                                    <span t-if="!evCard.is_masked_private and evCard.room?.name and evCard.room_booking_state === 'confirmed'" class="tp-cal-mini-badge" t-out="'🏢 ' + evCard.room.name"/>
                                                    <span t-if="!evCard.is_masked_private and evCard.project?.name" class="tp-cal-mini-badge" t-out="'📁 ' + evCard.project.name"/>
                                                    <span t-if="evCard.recurrency" class="tp-cal-mini-badge">Lặp lại</span>
                                                    <span t-if="evCard.is_masked_private or evCard.effective_privacy === 'private'" class="tp-cal-mini-badge is-priv">Riêng tư</span>
                                                    <span t-if="evCard.my_status_label and evCard.is_attendee"
                                                        t-attf-class="tp-cal-att-badge is-{{evCard.my_status}}"
                                                        t-out="evCard.my_status_label"/>
                                                </div>

                                                <div t-if="!evCard.is_masked_private" class="tp-cal-ag-meta">
                                                    <span t-if="evCard.organizer?.name">
                                                        Chủ trì: <strong t-out="evCard.organizer.name"/>
                                                    </span>
                                                    <span t-if="evCard.attendees?.length > 1">
                                                        · <t t-out="evCard.attendees.length"/> người tham gia
                                                    </span>
                                                    <span t-if="evCard.location">
                                                        · 📍 <t t-out="evCard.location"/>
                                                    </span>
                                                    <span t-if="evCard.linked_task">
                                                        · ☑ <t t-out="evCard.linked_task.name"/>
                                                    </span>
                                                </div>
                                            </div>

                                            <div class="tp-cal-ag-actions" t-on-click.stop="">
                                                <t t-if="evCard.is_attendee and evCard.my_status === 'needsAction'">
                                                    <button type="button"
                                                        class="tp-pt-btn tp-pt-btn-sm tp-pt-btn-teal"
                                                        t-on-click="() => this.onQuickAgendaRsvp(evCard, 'accepted')">
                                                        Chấp nhận
                                                    </button>
                                                    <button type="button"
                                                        class="tp-pt-btn tp-pt-btn-sm"
                                                        t-on-click="() => this.onQuickAgendaRsvp(evCard, 'declined')">
                                                        Từ chối
                                                    </button>
                                                </t>
                                                <a t-if="evCard.videocall_location and !evCard.is_masked_private"
                                                    class="tp-pt-btn tp-pt-btn-sm"
                                                    t-att-href="evCard.videocall_location"
                                                    target="_blank"
                                                    rel="noopener">
                                                    Họp online
                                                </a>
                                                <button t-if="!evCard.is_masked_private"
                                                    type="button"
                                                    class="tp-pt-btn tp-pt-btn-sm"
                                                    t-on-click="() => this.onShareAgendaCard(evCard)">
                                                    Chia sẻ
                                                </button>
                                                <button type="button"
                                                    class="tp-pt-btn tp-pt-btn-sm"
                                                    t-on-click="() => this.openEventDialog(evCard.id)">
                                                    <t t-if="evCard.user_can_edit">Sửa</t>
                                                    <t t-else="">Xem</t>
                                                </button>
                                            </div>
                                        </article>
                                    </div>
                                </section>
                            </div>
                        </div>

                        <!-- Agenda Pagination Footer -->
                        <footer class="tp-cal-agenda-footer">
                            <div class="d-flex align-items-center gap-2 text-muted small">
                                <span>Tổng <strong t-out="this.tpState.agendaTotal"/> sự kiện</span>
                                <span>·</span>
                                <label class="d-inline-flex align-items-center gap-1 mb-0">
                                    <span>Hiển thị</span>
                                    <select class="tp-cal-page-select"
                                        t-att-value="this.tpState.agendaPageSize"
                                        t-on-change="(ev) => this.changeAgendaPageSize(ev)">
                                        <option t-foreach="this.AGENDA_PAGE_SIZES" t-as="ps" t-key="ps" t-att-value="ps" t-out="ps"/>
                                    </select>
                                    <span>dòng</span>
                                </label>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <button type="button"
                                    class="tp-pt-btn tp-pt-btn-sm"
                                    t-att-disabled="this.tpState.agendaPage &lt;= 1"
                                    t-on-click="() => this.changeAgendaPage(this.tpState.agendaPage - 1)">
                                    ‹ Trước
                                </button>
                                <span class="small fw-semibold">
                                    Trang <t t-out="this.tpState.agendaPage"/> / <t t-out="this.agendaTotalPages"/>
                                </span>
                                <button type="button"
                                    class="tp-pt-btn tp-pt-btn-sm"
                                    t-att-disabled="this.tpState.agendaPage &gt;= this.agendaTotalPages"
                                    t-on-click="() => this.changeAgendaPage(this.tpState.agendaPage + 1)">
                                    Sau ›
                                </button>
                            </div>
                        </footer>
                    </div>
                </main>
            </div>
        </div>
    </t>
</templates>
