<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. VIỆC CÁ NHÂN: Client Action & Menu (core menu/action labels translated via tp_i18n_vi/i18n/vi.po) -->
    <record id="action_personal_todo" model="ir.actions.client">
        <field name="name">Việc cá nhân</field>
        <field name="tag">tp_personal_tools.todo_workspace</field>
        <field name="path">cong-viec-ca-nhan</field>
    </record>

    <record id="project_todo.menu_todo_todos" model="ir.ui.menu">
        <field name="action" ref="tp_personal_tools.action_personal_todo"/>
    </record>

    <!-- Preserve DEC-053 admin bypass + KH-KD project task isolation while allowing
         KH-KD scoped staff to read their own / shared personal tasks (`project_id = False`). -->
    <record id="tp_kd_workspace.scoped_staff_task" model="ir.access">
        <field name="domain">['|', '&amp;', ('project_id', '=', False), '|', ('user_ids', 'in', [user.id]), ('message_partner_ids', 'in', [user.partner_id.id]), '&amp;', ('project_id', '!=', False), ('project_id', 'access', 'read')] if (user.has_group('tp_kd_workspace.group_scoped_staff') and not user.has_group('base.group_system')) else []</field>
    </record>

    <!-- 2. LỊCH LÀM VIỆC: Menu, Action & Custom Calendar View Class -->
    <record id="calendar.mail_menu_calendar" model="ir.ui.menu">
        <field name="action" ref="calendar.action_calendar_event"/>
    </record>

    <record id="calendar.action_calendar_event" model="ir.actions.act_window">
        <field name="context">{'default_mode': 'week'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa có lịch trong khoảng thời gian này
            </p>
            <p>
                Bấm nút "Tạo lịch" hoặc kéo chọn khung giờ trên lịch để sắp xếp cuộc họp, công việc và gửi lời mời cho đồng nghiệp.
            </p>
        </field>
    </record>

    <record id="view_calendar_event_personal_inherit" model="ir.ui.view">
        <field name="name">calendar.event.calendar.tp.personal</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_calendar"/>
        <field name="priority" eval="20"/>
        <field name="arch" type="xml">
            <xpath expr="//calendar" position="attributes">
                <attribute name="js_class">tp_personal_calendar</attribute>
                <attribute name="string">Lịch làm việc</attribute>
            </xpath>
        </field>
    </record>
</odoo>
