<!-- BRAND-WHITELABEL-002 (CHG-20261117-002): branded hrefs and labels of
     native webclient templates. Only attributes/texts change; behaviour,
     click handlers and structure stay native. -->
<templates xml:space="preserve">

    <t t-inherit="web.NavBar.AppsMenu" t-inherit-mode="extension">
        <xpath expr="//a[hasclass('o_menu_toggle')]" position="attributes">
            <attribute name="href">/app</attribute>
        </xpath>
    </t>

    <t t-inherit="web.NavBar.AppsMenu.Sidebar" t-inherit-mode="extension">
        <xpath expr="//a[@href='/odoo'][hasclass('btn-primary')]" position="attributes">
            <attribute name="href">/app</attribute>
        </xpath>
    </t>

    <t t-inherit="web.SessionExpiredDialog" t-inherit-mode="extension">
        <xpath expr="//Dialog" position="attributes">
            <attribute name="title.translate">Phiên làm việc đã hết hạn</attribute>
        </xpath>
        <xpath expr="//div[@role='alert']/p" position="replace">
            <p class="text-prewrap">Phiên làm việc của bạn đã hết hạn. Trang hiện tại sẽ được tải lại.</p>
        </xpath>
    </t>

    <t t-inherit="web.CheckIdentityFormPassword" t-inherit-mode="extension">
        <xpath expr="//a[@href='/web/reset_password']" position="attributes">
            <attribute name="href">/quen-mat-khau</attribute>
        </xpath>
    </t>

    <t t-name="tp_branding.NotFound">
        <main class="tp-not-found-shell" role="alert">
            <section class="tp-not-found-card">
                <div class="tp-not-found-badge">TANPHAT ONE · 404</div>
                <div class="tp-not-found-icon" aria-hidden="true">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="8" x2="12" y2="12"/>
                        <line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                </div>
                <h1 class="tp-not-found-title">Không tìm thấy trang hoặc hồ sơ yêu cầu</h1>
                <p class="tp-not-found-desc" t-out="this.reasonText"/>
                <div t-if="this.requestedPath" class="tp-not-found-path" t-out="this.requestedPath"/>
                <div class="tp-not-found-actions">
                    <button type="button" class="tp-not-found-btn" t-on-click="this.goBack">
                        ← Quay lại trang trước
                    </button>
                    <button type="button" class="tp-not-found-btn is-primary" t-on-click="this.goHome">
                        Về Trang chủ TANPHAT ONE
                    </button>
                </div>
            </section>
        </main>
    </t>

</templates>
