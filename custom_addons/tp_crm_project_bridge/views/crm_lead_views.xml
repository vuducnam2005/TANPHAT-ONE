<odoo>
    <record id="crm_lead_form_project_link" model="ir.ui.view">
        <field name="name">crm.lead.form.tp.project.link</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="tp_project_id" options="{'no_create': True, 'no_create_edit': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
