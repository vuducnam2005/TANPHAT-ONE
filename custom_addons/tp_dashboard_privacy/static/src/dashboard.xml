<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="tp_dashboard_privacy.DashboardExtension" t-inherit="spreadsheet_dashboard.DashboardAction" t-inherit-mode="extension">
        <xpath expr="//div[@t-name='spreadsheet_dashboard.DashboardAction']" position="attributes">
            <attribute name="t-att-class">{'tp_dashboard_scope': this.tpKind()}</attribute>
        </xpath>
        <xpath expr="//SpreadsheetShareButton" position="attributes">
            <attribute name="t-if">!this.tpInternal()</attribute>
        </xpath>
        <xpath expr="//SpreadsheetShareButton" position="after">
            <span t-if="this.tpInternal()" class="tp_internal_badge" title="Chia sẻ công khai đã bị chặn ở máy chủ.">
                <i class="oi me-1" data-icon="lock" aria-hidden="true"/>Chỉ truy cập nội bộ
            </span>
        </xpath>
        <xpath expr="//MobileFigureContainer" position="before">
            <TpConnectedDashboard t-if="this.tpKind()" t-key="dashboard.data.id" dashboardId="dashboard.data.id" kind="this.tpKind()"/>
        </xpath>
        <xpath expr="//MobileFigureContainer" position="attributes">
            <attribute name="t-if">!this.tpKind() and this.uiService.isSmall</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_renderer')]" position="attributes">
            <attribute name="t-else"/>
            <attribute name="t-elif">!this.tpKind()</attribute>
        </xpath>
    </t>
    <t t-name="tp_dashboard_privacy.Sidebar" t-inherit="spreadsheet_dashboard.DashboardAction.Expanded" t-inherit-mode="extension">
        <xpath expr="//button" position="attributes">
            <attribute name="t-att-title">this.tpKind() ? 'Thu gọn danh sách' : 'Close sidebar'</attribute>
            <attribute name="t-att-aria-label">this.tpKind() ? 'Thu gọn danh sách' : 'Close sidebar'</attribute>
        </xpath>
        <xpath expr="//li" position="attributes">
            <attribute name="t-att-tabindex">this.tpKind() ? 0 : undefined</attribute>
            <attribute name="t-att-role">this.tpKind() ? 'button' : undefined</attribute>
            <attribute name="t-on-keydown">(ev) => this.tpSidebarKey(ev, dashboard.data.id)</attribute>
        </xpath>
    </t>
    <t t-name="tp_dashboard_privacy.CollapsedSidebar" t-inherit="spreadsheet_dashboard.DashboardAction.Collapsed" t-inherit-mode="extension">
        <xpath expr="//button" position="attributes">
            <attribute name="t-att-title">this.tpKind() ? 'Mở danh sách bảng tổng hợp' : 'Open sidebar'</attribute>
            <attribute name="t-att-aria-label">this.tpKind() ? 'Mở danh sách bảng tổng hợp' : 'Open sidebar'</attribute>
        </xpath>
    </t>
    <!-- MOBILE-001: native phone picker (portal to body) gets labels, keyboard and full-screen layout for TANPHAT dashboards only. -->
    <t t-name="tp_dashboard_privacy.MobileSearchPanel" t-inherit="spreadsheet_dashboard.DashboardMobileSearchPanel" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_mobile_search')]" position="attributes">
            <attribute name="t-att-class">{'tp_mobile_dashboard_panel': this.tpPanel()}</attribute>
            <attribute name="t-att-role">this.tpPanel() ? 'dialog' : undefined</attribute>
            <attribute name="t-att-aria-modal">this.tpPanel() ? 'true' : undefined</attribute>
            <attribute name="t-att-aria-label">this.tpPanel() ? 'Chọn bảng tổng hợp' : undefined</attribute>
        </xpath>
        <xpath expr="//button[hasclass('o_mobile_search_button')]" position="attributes">
            <attribute name="t-on-click">() => this.tpClose()</attribute>
        </xpath>
        <xpath expr="//button[hasclass('o_mobile_search_button')]/strong" position="attributes">
            <attribute name="t-out">this.tpPanel() ? 'Quay lại' : 'BACK'</attribute>
        </xpath>
        <xpath expr="//li[hasclass('o_search_panel_category_value')]" position="attributes">
            <attribute name="t-att-tabindex">this.tpPanel() ? 0 : undefined</attribute>
            <attribute name="t-att-role">this.tpPanel() ? 'button' : undefined</attribute>
            <attribute name="t-att-aria-current">this.tpPanel() and dashboard.data.id === this.props.activeDashboard.data.id ? 'page' : undefined</attribute>
            <attribute name="t-on-keydown">(ev) => this.tpKey(ev, () => this.onDashboardSelected(dashboard.data.id))</attribute>
        </xpath>
        <xpath expr="//button[hasclass('o_toggle_fold')]" position="attributes">
            <attribute name="t-att-tabindex">this.tpPanel() ? -1 : undefined</attribute>
            <attribute name="t-att-aria-hidden">this.tpPanel() ? 'true' : undefined</attribute>
        </xpath>
        <xpath expr="//div[@t-elif='this.props.groups.length']" position="attributes">
            <attribute name="t-att-class">{'tp_mobile_dashboard_toggle': this.tpPanel()}</attribute>
            <attribute name="t-att-role">this.tpPanel() ? 'button' : undefined</attribute>
            <attribute name="t-att-tabindex">this.tpPanel() ? 0 : undefined</attribute>
            <attribute name="t-att-aria-haspopup">this.tpPanel() ? 'dialog' : undefined</attribute>
            <attribute name="t-att-aria-label">this.tpPanel() ? 'Đang xem: ' + this.searchBarText + '. Chọn bảng tổng hợp khác' : undefined</attribute>
            <attribute name="t-on-keydown">(ev) => this.tpKey(ev, () => this.openDashboardSelection())</attribute>
        </xpath>
    </t>
    <t t-name="tp_dashboard_privacy.ConnectedDashboard">
        <main class="tp_connected_dashboard" t-att-aria-busy="this.state.loading ? 'true' : 'false'">
            <header class="tp_report_header">
                <div>
                    <div class="tp_title_line"><h1 t-out="this.props.kind === 'finance' ? 'Tổng quan hóa đơn và chi phí' : 'Điều phối dự án'"/><span class="tp_sample_badge">Dữ liệu giả lập</span></div>
                    <p t-out="this.props.kind === 'finance' ? 'Theo dõi hóa đơn nháp và đề nghị chi phí' : 'Theo dõi công việc và giờ làm đã ghi nhận'"/>
                    <p class="tp_caveat" t-out="this.props.kind === 'finance' ? 'Chưa phản ánh doanh thu hoặc thu/chi thực tế' : 'Hoàn tất công việc chưa đồng nghĩa nghiệm thu hoặc thanh toán'"/>
                </div>
                <button class="btn btn-primary tp_refresh" t-on-click="this.refresh" t-att-disabled="this.state.loading"><i class="oi me-2" data-icon="autorenew" aria-hidden="true"/>Làm mới</button>
            </header>
            <div class="tp_filter_bar">
                <button type="button" class="btn btn-secondary tp_filter_toggle" t-att-aria-expanded="this.state.filtersOpen ? 'true' : 'false'"
                    t-att-aria-controls="'tp_filters_' + this.props.dashboardId" t-on-click="this.toggleFilters">
                    <i class="oi me-2" data-icon="filter_alt" aria-hidden="true"/>Bộ lọc<span t-if="this.filterCount" class="tp_filter_count" t-out="this.filterCount"
                        t-att-aria-label="this.filterCount + ' bộ lọc đang áp dụng'"/>
                    <i class="oi ms-2" t-att-data-icon="this.state.filtersOpen ? 'expand_less' : 'expand_more'" aria-hidden="true"/>
                </button>
                <button t-if="this.filterCount" type="button" class="btn btn-link tp_filter_clear" t-on-click="this.reset">Xóa lọc</button>
                <p class="tp_filter_summary" t-out="this.filterSummary"/>
            </div>
            <form t-att-id="'tp_filters_' + this.props.dashboardId" class="tp_filters" t-att-class="{'tp_filters_open': this.state.filtersOpen}" t-on-submit="this.submit">
                <label>Dự án<select class="form-select" aria-label="Dự án" t-att-value="this.state.project" t-on-change="(ev) => this.change('project', ev)">
                    <option value="" t-att-selected="!this.state.project">Tất cả dự án được phép</option>
                    <option t-if="this.unlistedProject" t-att-value="this.state.project" selected="selected">Dự án đã chọn</option>
                    <option t-foreach="this.state.projects" t-as="project" t-key="project.id" t-att-value="project.id" t-att-selected="project.id === +this.state.project" t-out="project.code + ' — ' + project.name"/>
                </select></label>
                <label>Từ ngày<input class="form-control" type="date" t-att-value="this.state.from" t-on-change="(ev) => this.change('from', ev)"/></label>
                <label>Đến ngày<input class="form-control" type="date" t-att-value="this.state.to" t-on-change="(ev) => this.change('to', ev)"/></label>
                <button class="btn btn-link" type="button" t-on-click="this.reset">Xóa bộ lọc</button>
                <div class="tp_filter_basis"><strong t-if="!this.state.from and !this.state.to">Toàn bộ thời gian. </strong>
                    <t t-if="this.props.kind === 'finance'">Hóa đơn: ngày hóa đơn; chi phí: ngày chi phí.</t>
                    <t t-else="">Công việc: ngày tạo (múi giờ tài khoản); giờ làm: ngày ghi nhận.</t>
                </div>
            </form>
            <div t-if="this.state.loading" class="tp_message" role="status"><i class="oi oi-spin me-2" data-icon="progress_activity" aria-hidden="true"/>Đang tải số liệu…</div>
            <div t-elif="this.state.error" class="tp_message tp_error" role="alert">
                <h2 t-out="this.state.forbidden ? 'Không đủ quyền' : 'Lỗi tải số liệu'"/>
                <p t-out="this.state.error"/><button class="btn btn-primary" t-on-click="this.refresh">Thử lại</button>
            </div>
            <t t-elif="this.state.data">
                <div class="tp_data_meta"><span t-out="this.state.data.company"/><span t-out="'Lấy dữ liệu lúc ' + this.state.data.fetched_at"/></div>
                <div t-if="this.state.data.empty" class="tp_empty" role="status">Không có dữ liệu theo bộ lọc. Thử chọn dự án hoặc khoảng ngày khác.</div>
                <section class="tp_metrics" aria-label="Chỉ số chính">
                    <t t-foreach="this.state.data.metrics" t-as="metric" t-key="metric.label">
                        <button class="tp_metric" t-on-click="() => this.open(metric.source)" t-att-disabled="!metric.source" t-att-title="metric.source ? 'Mở chứng từ nguồn trong phạm vi đang xem' : ''">
                            <span class="tp_metric_label" t-out="metric.label"/>
                            <strong t-out="metric.display"/><span class="tp_metric_unit" t-out="metric.unit"/>
                            <small t-if="metric.detail" t-out="metric.detail"/>
                        </button>
                    </t>
                </section>
                <section class="tp_charts" aria-label="Biểu đồ">
                    <TpReportChart t-foreach="this.state.data.charts" t-as="chart" t-key="chart.title"
                        chart="chart" donut="this.props.kind === 'finance' and chart_index === 1"
                        total="this.props.kind === 'finance' ? this.state.data.metrics[3].display : ''"
                        chartId="'tp_chart_' + this.props.dashboardId + '_' + chart_index"
                        openSource="(source, project, state) => this.open(source, project, state)"/>
                </section>
                <section class="tp_details" aria-labelledby="tp_details_heading">
                    <div class="tp_chart_heading"><h2 id="tp_details_heading">Chi tiết theo dự án</h2><span t-if="this.props.kind === 'finance'">Đồng (VND)</span></div>
                    <p class="tp_table_hint" t-att-id="'tp_table_hint_' + this.props.dashboardId"><i class="oi me-1" data-icon="swap_horiz" aria-hidden="true"/>Vuốt ngang trong bảng để xem thêm cột; cột dự án luôn giữ bên trái.</p>
                    <div class="tp_table_scroll" tabindex="0" role="region" aria-label="Bảng chi tiết, có thể cuộn ngang" t-att-aria-describedby="'tp_table_hint_' + this.props.dashboardId">
                        <table><thead><tr><th scope="col">Mã và tên dự án</th><th t-foreach="this.state.data.headers" t-as="head" t-key="head" scope="col" t-out="head"/></tr></thead>
                            <tbody><tr t-foreach="this.state.data.rows" t-as="row" t-key="row.id"><th scope="row"><small t-out="row.code"/><span t-out="row.name"/></th>
                                <td t-foreach="row.cells" t-as="cell" t-key="cell_index"><button t-on-click="() => this.open(cell.source, row.id, cell.state)" t-out="cell.display"/></td>
                            </tr></tbody>
                        </table>
                    </div>
                </section>
                <details class="tp_explanation"><summary>Giải thích số liệu</summary>
                    <t t-if="this.props.kind === 'finance'">
                        <p>Chỉ lấy hóa đơn khách hàng nháp và đề nghị chi phí ở ba trạng thái đang soạn, chờ duyệt, đã duyệt thuộc bộ dữ liệu mẫu liên thông. Phạm vi công ty và quyền đọc nguồn được kiểm tra mỗi lần lấy dữ liệu.</p>
                        <p>Giá trị hóa đơn gồm thuế lấy từ dòng hóa đơn, nhân tỷ lệ phân bổ analytic của dự án. Chi phí lấy tổng theo tiền tệ công ty, nhân cùng tỷ lệ phân bổ. Làm tròn theo tiền tệ Odoo. Mỗi hóa đơn/đề nghị chỉ đếm một lần ở chỉ số tổng; chứng từ chia nhiều dự án có thể xuất hiện ở nhiều hàng.</p>
                        <p>Chỉ tính phần phân bổ vào các dự án được phép đang chọn. Danh sách nguồn mở chứng từ đầy đủ nên có thể hiển thị tổng chứng từ lớn hơn phần được phân bổ; không cộng tổng danh sách thay cho giá trị phân bổ trên bảng. Không suy quan hệ bằng tên hay tham chiếu hóa đơn.</p>
                        <p>Không có quy đổi hóa đơn khác tiền tệ công ty. Không tính lợi nhuận từ hai nguồn này. Đã duyệt chưa đồng nghĩa đã thanh toán. Khi lọc ngày, hóa đơn chưa có ngày hóa đơn không thuộc khoảng ngày đã chọn.</p>
                    </t>
                    <t t-else=""><p>Công việc lấy từ Project theo dự án và ngày tạo. Hoàn tất là trạng thái native 1_done. Giờ làm là tổng giờ Timesheets theo ngày ghi nhận. Hai nguồn cùng phạm vi dự án, công ty và quyền người xem. Không suy tỷ lệ tiến độ hoặc quá hạn.</p></t>
                    <p>Làm mới truy vấn lại nguồn Odoo và giữ bộ lọc. Thời điểm phía trên là lúc máy chủ lấy dữ liệu; không phải thời điểm chứng từ cuối cùng thay đổi. Số 0 chỉ hiển thị sau truy vấn thành công; lỗi tải/quyền không được thay bằng số 0.</p>
                </details>
            </t>
        </main>
    </t>
    <t t-name="tp_dashboard_privacy.ChartTooltip">
        <div class="tp_chart_tooltip" t-att-id="this.props.id" t-on-pointerenter="this.props.keep" t-on-pointerleave="this.props.leave">
            <small t-if="this.props.item.code" t-out="this.props.item.code"/>
            <span t-out="this.props.item.label"/>
            <strong t-out="this.props.item.exact"/>
            <span t-if="this.props.percentage" t-out="this.props.percentage + ' tổng đề nghị chi phí đang xem'"/>
            <small>Nhấn biểu đồ để mở chứng từ nguồn</small>
        </div>
    </t>
    <t t-name="tp_dashboard_privacy.ReportChart">
        <article class="tp_chart" t-att-class="{'tp_has_active': this.state.active !== null, 'tp_donut_chart': this.props.donut}">
            <div class="tp_chart_heading"><h2 t-out="this.props.chart.title"/><span t-out="this.props.donut ? 'Tỷ trọng' : this.props.chart.unit"/></div>
            <div t-if="this.props.donut" class="tp_donut_layout">
                <div class="tp_donut_visual">
                    <svg viewBox="0 0 220 220" class="tp_donut" role="img" aria-label="Cơ cấu giá trị đề nghị chi phí; chi tiết trong chú giải bên cạnh">
                        <circle class="tp_donut_base" cx="110" cy="110" r="84"/>
                        <circle t-foreach="this.slices" t-as="item" t-key="item.state" cx="110" cy="110" r="84" pathLength="100"
                            t-attf-class="tp_donut_slice tp_state_{{item.state}}" t-att-class="{'tp_active': this.state.active === item_index}"
                            t-att-stroke-dasharray="Math.max(0, item.share - (item.share === 100 ? 0 : 0.7)) + ' ' + (100 - Math.max(0, item.share - (item.share === 100 ? 0 : 0.7)))"
                            t-att-stroke-dashoffset="-item.offset" t-on-pointerenter="(ev) => this.show(item_index, ev)" t-on-pointerleave="this.leave"
                            t-on-click="() => this.open(item_index)" aria-hidden="true"/>
                    </svg>
                    <div class="tp_donut_center" aria-hidden="true"><span t-out="this.activeItem ? this.activeItem.label : 'Tổng chi phí'"/><strong t-out="this.activeItem ? this.activeItem.exact : this.props.total"/><small t-out="this.activeItem ? this.activeItem.percentage : 'Trong phạm vi đang xem'"/></div>
                </div>
                <div class="tp_donut_legend">
                    <button t-foreach="this.slices" t-as="item" t-key="item.state" t-attf-class="tp_legend_row tp_state_{{item.state}}" t-att-class="{'tp_active': this.state.active === item_index}"
                        t-on-pointerenter="(ev) => this.show(item_index, ev)" t-on-pointerleave="this.leave" t-on-focus="(ev) => this.show(item_index, ev)" t-on-blur="this.leave"
                        t-att-aria-describedby="this.state.active === item_index ? this.tooltipId : undefined" t-on-click="() => this.open(item_index)">
                        <span class="tp_legend_dot"/><span><span class="tp_legend_label" t-out="item.label"/><strong t-out="item.exact"/></span><span class="tp_share" t-out="item.percentage"/>
                    </button>
                </div>
            </div>
            <div t-else="" class="tp_bar_plot">
                <div class="tp_axis" aria-hidden="true"><span t-foreach="this.ticks" t-as="tick" t-key="tick_index" t-out="tick"/></div>
                <button t-foreach="this.props.chart.items" t-as="item" t-key="item_index" class="tp_bar_row" t-att-class="{'tp_active': this.state.active === item_index}"
                    t-on-pointerenter="(ev) => this.show(item_index, ev)" t-on-pointerleave="this.leave" t-on-focus="(ev) => this.show(item_index, ev)" t-on-blur="this.leave"
                    t-att-aria-describedby="this.state.active === item_index ? this.tooltipId : undefined" t-on-click="() => this.open(item_index)">
                    <span class="tp_bar_caption"><span><small t-if="item.code" t-out="item.code"/><span t-out="item.label"/></span><strong t-out="item.exact"/></span>
                    <span class="tp_bar_track"><span class="tp_bar_fill" t-att-style="'width: ' + item.width + '%'"/><span t-if="item.value === 0" class="tp_zero_mark"/></span>
                </button>
            </div>
            <p class="tp_chart_hint"><span class="tp_hint_pointer"><i class="oi me-1" data-icon="info" aria-hidden="true"/>Di chuột hoặc dùng Tab để xem chi tiết; nhấn để mở nguồn.</span><span class="tp_hint_touch"><i class="oi me-1" data-icon="info" aria-hidden="true"/>Số liệu chính xác ghi ngay trên từng dòng; chạm vào dòng để mở chứng từ nguồn.</span></p>
            <p t-if="this.props.chart.note" class="tp_chart_note" t-out="this.props.chart.note"/>
        </article>
    </t>
</templates>
