<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="login_layout" inherit_id="web.login_layout" name="TANPHAT ONE authentication shell">
        <xpath expr="//t[@t-set='head']" position="before">
            <t t-set="tp_auth_page" t-value="request.httprequest.path in ('/web/login', '/web/login/totp', '/web/signup', '/web/reset_password')"/>
        </xpath>
        <xpath expr="//t[@t-set='head']" position="inside">
            <t t-if="tp_auth_page" t-call-assets="tp_web_login.assets_login" t-js="false"/>
        </xpath>
        <xpath expr="//div[hasclass('container')]" position="attributes">
            <attribute name="t-attf-class">#{'tp-native-login' if tp_auth_page else 'container py-5'}</attribute>
            <attribute name="class"/>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class, 'o_database_list')]" position="before">
            <aside t-if="tp_auth_page" class="tp-auth-identity">
                <div class="tp-native-wordmark" aria-label="TANPHAT ONE" t-translation="off">
                    <svg viewBox="0 0 40 40" fill="none" aria-hidden="true"><path d="M4 29h32M8 29V10m24 19V10M8 13c7 13 17 13 24 0M14 21v8m6-5v5m6-8v8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    <strong>TANPHAT ONE</strong>
                </div>
                <div class="tp-auth-intro" t-translation="off">
                    <h2>Không gian<br class="tp-auth-desktop-break"/> làm việc chung</h2>
                    <p>Kết nối công việc.<br/>Vững bước cùng Tấn Phát.</p>
                </div>
                <svg class="tp-auth-bridge" viewBox="0 0 600 310" fill="none" aria-hidden="true">
                    <g stroke="currentColor" stroke-width="1.4"><path d="M-30 240H630M-30 250H630M110 250V50h12v200m356 0V50h12v200M116 68C200 265 400 265 484 68M116 68C70 153 20 192-30 196m514-128c46 85 96 124 146 128M146 121v119m30-75v75m30-44v44m30-29v29m30-20v20m34-17v17m34-20v20m30-29v29m30-44v44m30-75v75m30-119v119M-30 278c110-16 190 16 300 0s230 16 360 0"/><path d="M-30 212H630M95 250v32m42-32v32m326-32v32m42-32v32" opacity=".4"/></g>
                </svg>
                <span class="tp-auth-signature" t-translation="off">Cùng dựng xây, cùng phát triển.</span>
            </aside>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class, 'o_database_list')]" position="attributes">
            <attribute name="t-att-style">None if tp_auth_page else 'max-width: 300px;'</attribute>
            <attribute name="style"/>
            <attribute name="t-attf-class">#{'tp-auth-panel' if tp_auth_page else 'card border-0 mx-auto bg-100'} #{login_card_classes} o_database_list</attribute>
        </xpath>
        <xpath expr="//div[hasclass('card-body')]" position="attributes">
            <attribute name="t-attf-class">card-body #{'tp-auth-content' if tp_auth_page else ''}</attribute>
            <attribute name="class"/>
        </xpath>
        <xpath expr="//div[@t-if='not res_company.uses_default_logo']" position="attributes"><attribute name="t-if">not tp_auth_page and not res_company.uses_default_logo</attribute></xpath>
        <xpath expr="//a[starts-with(@href, 'https://www.odoo.com')]" position="replace">
            <span t-if="tp_auth_page" class="tp-auth-footer" t-translation="off">TANPHAT ONE</span>
            <a t-else="" href="https://www.odoo.com?utm_source=db&amp;utm_medium=auth" target="_blank">Powered by Odoo</a>
        </xpath>
    </template>
    <template id="login_form" inherit_id="web.login" name="TANPHAT ONE password form">
        <xpath expr="//h1" position="replace"/>
        <xpath expr="//form/input[@name='csrf_token']" position="before"><div class="tp-auth-heading" t-translation="off"><h1>Đăng nhập</h1><p>Sử dụng tài khoản được cấp để tiếp tục.</p></div></xpath>
        <xpath expr="//label[@for='login']" position="replace"><label for="login" class="form-label d-flex justify-content-between" t-translation="off">Tên đăng nhập</label></xpath>
        <xpath expr="//input[@name='login']" position="attributes"><attribute name="placeholder">Nhập tên đăng nhập</attribute></xpath>
        <xpath expr="//label[@for='password']" position="replace"><label for="password" class="form-label" t-translation="off">Mật khẩu</label></xpath>
        <xpath expr="//input[@name='password']" position="attributes"><attribute name="placeholder">Nhập mật khẩu</attribute></xpath>
        <xpath expr="//button[hasclass('o_show_password')]" position="attributes"><attribute name="aria-label">Hiện mật khẩu</attribute><attribute name="aria-pressed">false</attribute></xpath>
        <xpath expr="//button[hasclass('btn-primary')]" position="replace"><button type="submit" class="btn btn-primary" t-translation="off">Đăng nhập</button></xpath>
        <xpath expr="//p[@t-if='error']/t" position="replace">
            <t t-if="str(error) in ('Wrong login/password', 'Sai tên đăng nhập/mật khẩu', 'Sai tên đăng nhập/mật khẩu.')" t-translation="off">Tên đăng nhập hoặc mật khẩu chưa đúng. Vui lòng thử lại.</t><t t-else="" t-out="error"/>
        </xpath>
        <xpath expr="//p[@t-if='error']" position="after">
            <details t-if="error and str(error) == 'Tài khoản đã bị khóa. Vui lòng gửi phản hồi.'" class="tp-auth-feedback" t-translation="off">
                <summary>Gửi phản hồi</summary>
                <p role="status">Tính năng gửi phản hồi đang phát triển.</p>
            </details>
        </xpath>
    </template>
    <template id="auth_totp_form" inherit_id="auth_totp.auth_totp_form" name="TANPHAT ONE verification code">
        <xpath expr="//h5" position="replace"><div class="tp-auth-heading" t-translation="off"><h1>Nhập mã xác thực</h1><p>Mở ứng dụng xác thực để xem mã gồm 6 chữ số.</p></div></xpath>
        <xpath expr="//form[@action='']/div[1]" position="replace"><label for="totp_token" class="form-label" t-translation="off">Mã xác thực</label></xpath>
        <xpath expr="//input[@name='totp_token']" position="attributes"><attribute name="placeholder">Mã 6 chữ số</attribute><attribute name="aria-label">Mã 6 chữ số</attribute></xpath>
        <xpath expr="//p[@t-if='error']" position="replace"><p class="alert alert-danger" t-if="error" role="alert"><t t-if="str(error) in ('Invalid authentication code format.', 'Access Denied', 'Invalid authentication code.')" t-translation="off">Chưa xác thực được mã. Vui lòng nhập mã mới nhất trên ứng dụng xác thực; nếu đã thử nhiều lần, chờ ít phút rồi thử lại.</t><t t-else="" t-out="error"/></p></xpath>
        <xpath expr="//label[@for='switch-remember']" position="replace"><label for="switch-remember" t-translation="off">Không hỏi lại trên thiết bị này</label></xpath>
        <xpath expr="//button[hasclass('btn-primary')]" position="replace"><button type="submit" class="btn btn-primary" t-translation="off">Xác nhận</button></xpath>
        <xpath expr="//form[@action='/web/session/logout']/input" position="after"><input type="hidden" name="redirect" value="/web/login"/></xpath>
        <xpath expr="//form[@action='/web/session/logout']//button" position="replace"><button type="submit" class="btn btn-link btn-sm mb-2" t-translation="off">Hủy và quay lại</button></xpath>
    </template>
    <template id="self_service_links" inherit_id="auth_signup.login" name="TANPHAT ONE native self service labels">
        <xpath expr="//a[@t-if='signup_enabled']" position="replace"><a t-if="signup_enabled" class="btn btn-link btn-sm mt-2" t-attf-href="/web/signup?{{ keep_query() }}" t-translation="off">Tạo tài khoản</a></xpath>
        <xpath expr="//a[@t-if='reset_password_enabled']" position="replace"><a t-if="reset_password_enabled" class="btn btn-link btn-sm" t-attf-href="/web/reset_password?{{ keep_query() }}" t-translation="off">Quên mật khẩu?</a></xpath>
    </template>
    <template id="signup_heading" inherit_id="auth_signup.signup" name="TANPHAT ONE signup">
        <xpath expr="//form/input[@name='csrf_token']" position="before"><div class="tp-auth-heading" t-translation="off"><h1>Tạo tài khoản</h1><p>Hoàn tất thông tin tài khoản của bạn.</p></div></xpath>
        <xpath expr="//label[@for='name']" position="replace"><label for="name" class="form-label" t-translation="off">Họ và tên</label></xpath>
        <xpath expr="//button[@type='submit']" position="replace"><button type="submit" class="btn btn-primary mb-1" t-translation="off">Tạo tài khoản</button></xpath>
        <xpath expr="//a[@role='button']" position="replace"><a t-attf-href="/web/login?{{ keep_query() }}" class="btn btn-link btn-sm mt-2" t-translation="off">Đã có tài khoản? Đăng nhập</a></xpath>
    </template>
    <template id="self_service_password_fields" inherit_id="auth_signup.fields" name="TANPHAT ONE password labels">
        <xpath expr="//label[@for='password']" position="replace"><label for="password" class="form-label" t-translation="off">Mật khẩu</label></xpath>
        <xpath expr="//label[@for='confirm_password']" position="replace"><label for="confirm_password" class="form-label" t-translation="off">Nhập lại mật khẩu</label></xpath>
        <xpath expr="//button[hasclass('o_show_password')]" position="attributes"><attribute name="aria-label">Hiện mật khẩu</attribute><attribute name="aria-pressed">false</attribute></xpath>
    </template>
    <template id="reset_heading" inherit_id="auth_signup.reset_password" name="TANPHAT ONE password reset">
        <xpath expr="//form/input[@name='csrf_token']" position="before"><div class="tp-auth-heading" t-translation="off"><h1>Đặt lại mật khẩu</h1><p>Nhập tài khoản để nhận hướng dẫn.</p></div></xpath>
        <xpath expr="//label[@for='login']" position="replace"><label for="login" class="form-label" t-translation="off">Tên đăng nhập</label></xpath>
        <xpath expr="//button[@type='submit']" position="replace"><button type="submit" class="btn btn-primary" t-translation="off">Đặt lại mật khẩu</button></xpath>
        <xpath expr="//a[contains(@href, '/web/login') or contains(@t-attf-href, '/web/login')]" position="replace"><a href="/web/login" class="btn btn-link btn-sm" t-translation="off">Quay lại đăng nhập</a></xpath>
    </template>
</odoo>
