<odoo>
    <record id="employee_scoped_account_buttons" model="ir.ui.view">
        <field name="name">tp.employee.delegated.account.buttons</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="tp_hr_workspace.employee_form"/>
        <field name="priority">115</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='page_account']" position="inside"><field name="tp_can_manage_account" invisible="1"/></xpath>
            <xpath expr="//button[@name='action_open_account_dialog']" position="attributes">
                <attribute name="groups"/>
                <attribute name="invisible">not tp_can_manage_account</attribute>
            </xpath>
            <xpath expr="//div[hasclass('o_tp_hr_account_empty')]/button[@name='action_open_account_dialog']" position="attributes">
                <attribute name="groups"/>
                <attribute name="invisible">not tp_can_manage_account</attribute>
            </xpath>
            <xpath expr="//page[@name='page_account']//div[hasclass('o_tp_hr_account_actions')]" position="after">
                <div class="d-flex flex-wrap gap-2" groups="!base.group_system" invisible="not user_id or not tp_can_manage_account">
                    <button name="action_open_account_dialog" type="object" string="Khóa / mở tài khoản" class="btn btn-outline-secondary"/>
                    <button name="action_reset_user_password" type="object" string="Đặt lại mật khẩu" class="btn btn-outline-secondary"/>
                </div>
            </xpath>
        </field>
    </record>
    <record id="delegated_account_wizard_buttons" model="ir.ui.view">
        <field name="name">tp.account.wizard.delegated.buttons</field>
        <field name="model">tp.hr.account.wizard</field>
        <field name="inherit_id" ref="tp_hr_workspace.view_tp_hr_account_wizard_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_prepare_credentials']" position="attributes"><attribute name="groups"/><attribute name="invisible">not is_admin</attribute></xpath>
            <xpath expr="//div[@groups='base.group_system']" position="attributes"><attribute name="groups"/><attribute name="invisible">not is_linked or not is_admin</attribute></xpath>
        </field>
    </record>
</odoo>
