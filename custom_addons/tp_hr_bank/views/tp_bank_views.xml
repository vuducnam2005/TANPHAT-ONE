<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tp_bank_list" model="ir.ui.view">
        <field name="name">tp.bank.list</field>
        <field name="model">tp.bank</field>
        <field name="arch" type="xml">
            <list string="Danh mục ngân hàng">
                <field name="sequence" widget="handle"/>
                <field name="badge" widget="tp_bank_badge"/>
                <field name="short_name"/>
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="bin"/>
                <field name="swift" optional="hide"/>
                <field name="kind"/>
                <field name="napas_transfer" optional="hide"/>
                <field name="account_count" optional="show"/>
                <field name="color" column_invisible="1"/>
                <field name="text_color" column_invisible="1"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_tp_bank_form" model="ir.ui.view">
        <field name="name">tp.bank.form</field>
        <field name="model">tp.bank</field>
        <field name="arch" type="xml">
            <form string="Ngân hàng">
                <sheet>
                    <widget name="web_ribbon" title="Ngừng dùng" bg_color="text-bg-secondary" invisible="active"/>
                    <div class="oe_title d-flex align-items-center gap-3">
                        <field name="badge" widget="tp_bank_badge" readonly="1" nolabel="1"/>
                        <h1 class="mb-0"><field name="short_name" placeholder="VD: Vietcombank"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="bin"/>
                            <field name="swift"/>
                        </group>
                        <group>
                            <field name="kind"/>
                            <field name="badge" string="Chữ trên biểu tượng"/>
                            <field name="color" widget="color"/>
                            <field name="text_color" invisible="1"/>
                            <field name="napas_transfer"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="account_count"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tp_bank_search" model="ir.ui.view">
        <field name="name">tp.bank.search</field>
        <field name="model">tp.bank</field>
        <field name="arch" type="xml">
            <search string="Tìm ngân hàng">
                <field name="short_name" string="Ngân hàng" filter_domain="['|', '|', '|', ('short_name', 'ilike', self), ('name', 'ilike', self), ('code', 'ilike', self), ('bin', 'ilike', self)]"/>
                <filter name="filter_bank" string="Ngân hàng" domain="[('kind', '=', 'bank')]"/>
                <filter name="filter_wallet" string="Ví điện tử / Tài chính" domain="[('kind', '!=', 'bank')]"/>
                <separator/>
                <filter name="filter_archived" string="Ngừng dùng" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_tp_bank" model="ir.actions.act_window">
        <field name="name">Danh mục ngân hàng</field>
        <field name="res_model">tp.bank</field>
        <field name="path">danh-muc-ngan-hang</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_tp_bank_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Chưa có ngân hàng trong danh mục</p>
            <p>Danh mục theo danh sách NAPAS/VietQR. Ngân hàng đang dùng sẽ hiện trong ô chọn ngân hàng ở Thông tin cá nhân.</p>
        </field>
    </record>

    <menuitem id="menu_tp_bank" name="Danh mục ngân hàng" parent="tp_hr_workspace.menu_group_organization"
              action="action_tp_bank" sequence="60" groups="hr.group_hr_manager"/>
</odoo>
