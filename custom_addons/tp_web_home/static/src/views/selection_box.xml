<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- HR-CORRECTION-008: Vietnamese word order for the selection counter ("Đã chọn 1 hồ sơ").
         Translating "selected" alone would read "1 đã chọn", and the text node trails the count, so the
         counter blocks are replaced whole. Classes, handlers and conditions are kept from web. -->
    <t t-inherit="web.SelectionBox" t-inherit-mode="extension">
        <xpath expr="//span[@t-if='this.isDomainSelected']" position="replace">
            <span t-if="this.isDomainSelected" class="o_tp_selection_count">Đã chọn tất cả <b><t t-out="this.nbTotal"/><t t-if="this.hasLimitedCount">+</t></b> hồ sơ</span>
        </xpath>
        <xpath expr="//t[@t-else]" position="replace">
            <t t-else="">
                <span class="o_tp_selection_count">Đã chọn <b t-out="this.nbSelected"/> hồ sơ</span>
                <button t-if="!this.uiService.isSmall and this.isPageSelected and (!this.isRecordCountTrustable or this.nbTotal > this.nbSelected)"
                    class="o_select_domain btn btn-sm btn-info p-1 ms-2 me-n2 border-0 fw-normal"
                    title="Chọn tất cả hồ sơ khớp với tìm kiếm"
                    t-on-click="this.onSelectDomain">
                    <i class="oi oi-fw" data-icon="arrow_forward"/>
                    Chọn tất cả <span t-if="this.isRecordCountTrustable"><t t-out="this.nbTotal"/><t t-if="this.hasLimitedCount">+</t></span>
                </button>
            </t>
        </xpath>
    </t>

    <t t-inherit="web.MultiSelectionButtons" t-inherit-mode="extension">
        <xpath expr="//span[hasclass('list-group-item')]" position="replace">
            <span class="list-group-item active d-flex align-items-center pe-0 py-0 rounded-1 gap-1 flex-grow-1">
                <span class="o_tp_selection_count">Đã chọn <b t-out="this.props.reactive.nbSelected"/></span>
                <button data-tooltip="Bỏ chọn tất cả" class="o_unselect_all btn btn-link ms-auto border-0" t-on-click="() => this.props.reactive.onCancel()">
                    <i class="oi" data-icon="close_small"/>
                </button>
            </span>
        </xpath>
    </t>

</templates>
