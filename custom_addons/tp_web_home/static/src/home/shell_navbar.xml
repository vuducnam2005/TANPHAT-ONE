<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="web.SwitchCompanyMenu" t-inherit-mode="extension">
        <xpath expr="//span[hasclass('oe_topbar_name')]" position="attributes">
            <attribute name="class">oe_topbar_name d-none</attribute>
        </xpath>
        <xpath expr="//i[@data-icon='business']" position="attributes">
            <attribute name="class">oi</attribute>
        </xpath>
        <xpath expr="//button[hasclass('o_switch_company_menu')]" position="attributes">
            <attribute name="aria-label">Công ty đang hoạt động</attribute>
        </xpath>
    </t>
    <t t-inherit="web.NavBar" t-inherit-mode="extension">
        <xpath expr="//nav[hasclass('o_main_navbar')]" position="attributes">
            <attribute name="class" add="tp-shell-navbar" separator=" "/>
        </xpath>
        <xpath expr="//t[@t-call='web.NavBar.AppsMenu']" position="after">
            <div class="tp-shell-brand" title="TANPHAT ONE">
                <span class="tp-shell-logo" aria-hidden="true"><img src="/tp_web_home/static/img/brand/tp_logo_mark.png" alt="" width="24" height="24" draggable="false"/></span>
                <span class="tp-shell-wordmark">TANPHAT ONE</span>
                <span class="tp-shell-shortmark">TP ONE</span>
            </div>
            <span t-if="this.ui.isSmall" class="tp-shell-mobile-context" t-att-title="this.tpCurrentAppLabel" t-out="this.tpCurrentAppLabel"/>
        </xpath>
        <xpath expr="//DropdownItem[contains(@class, 'o_menu_brand')]" position="attributes">
            <attribute name="t-out">this.tpCurrentAppLabel</attribute>
            <attribute name="attrs">{ href: this.getMenuItemHref(this.currentApp), title: this.tpCurrentAppLabel, 'data-menu-xmlid': this.currentApp.xmlid, 'data-section': this.currentApp.id }</attribute>
        </xpath>
        <xpath expr="//header[hasclass('o_navbar')]" position="inside">
            <TpAppSwitcher
                open="this.tpAppsOpen()"
                panelId="'tp_app_switcher_panel'"
                anchorMode="this.ui.isSmall ? 'mobile' : 'navbar'"
                currentAppSections="this.ui.isSmall ? this.currentAppSections : []"
                onClose="(opts) => this.closeTpAppsSwitcher(opts)"
                onSelectSubMenu="(sec) => this.onTpSubMenuSelected(sec)"
            />
        </xpath>
    </t>
    <t t-inherit="web.NavBar.AppsMenu" t-inherit-mode="extension">
        <xpath expr="//a[hasclass('o_menu_toggle')]" position="attributes">
            <attribute name="title">Mở ứng dụng</attribute>
            <attribute name="aria-label">Mở ứng dụng</attribute>
            <attribute name="aria-haspopup">dialog</attribute>
            <attribute name="t-att-aria-expanded">this.tpAppsOpen() ? 'true' : 'false'</attribute>
            <attribute name="t-on-click.prevent">this.toggleTpAppsSwitcher</attribute>
        </xpath>
        <xpath expr="//a[hasclass('o_menu_toggle')]/t[@t-call='web.NavBar.AppsMenu.Sidebar']" position="replace">
            <i class="oi" data-icon="apps" aria-hidden="true"/>
        </xpath>
        <xpath expr="//div[hasclass('o_navbar_apps_menu')]/Dropdown" position="replace">
            <button type="button"
                    class="tp-apps-trigger-btn"
                    data-hotkey="h"
                    title="Mở ứng dụng"
                    aria-label="Mở ứng dụng"
                    aria-haspopup="dialog"
                    t-att-aria-expanded="this.tpAppsOpen() ? 'true' : 'false'"
                    aria-controls="tp_app_switcher_panel"
                    data-available-offline=""
                    t-ref="this.tpAppsDesktopBtn"
                    t-on-click="this.toggleTpAppsSwitcher">
                <i class="oi" data-icon="apps" aria-hidden="true"/>
            </button>
        </xpath>
    </t>
    <t t-inherit="web.UserMenu" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o_user_menu')]" position="attributes">
            <attribute name="t-att-title">this.userName</attribute>
            <attribute name="t-att-aria-label">this.userName</attribute>
            <attribute name="t-on-error.capture">() => this.onAvatarImageError()</attribute>
            <attribute name="t-att-class">{ 'tp-avatar-broken': this.tpIdentity?.avatarFailed or !this.tpIdentity?.partnerId }</attribute>
        </xpath>
        <xpath expr="//button[hasclass('o_user_menu')]" position="inside">
            <TpIdentityAvatar t-if="this.tpIdentity?.avatarFailed or !this.tpIdentity?.partnerId" size="26"/>
            <span class="tp-shell-user-name" t-out="this.userName"/>
            <i class="oi tp-shell-user-chevron" data-icon="expand_more" aria-hidden="true"/>
        </xpath>
        <xpath expr="//DropdownItem" position="attributes">
            <attribute name="class">element.id === 'logout' ? 'tp-shell-user-item tp-logout-menu-item' : 'tp-shell-user-item tp-profile-menu-item'</attribute>
        </xpath>
        <xpath expr="//t[@t-out='element.description']" position="replace">
            <svg t-if="element.id === 'personal_profile'" class="tp-profile-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M20 21a8 8 0 0 0-16 0"/></svg>
            <svg t-elif="element.id === 'account_security'" class="tp-profile-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 3 7v5c0 5 9 9 9 9s9-4 9-9V7z"/></svg>
            <svg t-elif="element.id === 'logout'" class="tp-logout-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>
            <span t-out="element.description"/>
        </xpath>
    </t>
    <t t-inherit="web.BurgerUserMenu" t-inherit-mode="extension">
        <xpath expr="//a[@t-out='element.description']" position="replace">
            <a t-if="element.type == 'item'"
               class="d-flex align-items-center gap-2 py-2 tp-burger-logout-item"
               t-att-class="{ 'tp-burger-profile-item': element.id === 'personal_profile' || element.id === 'account_security', 'text-body': element.id !== 'logout' }"
               t-att-data-menu="element.id"
               t-att-href="element.href or ''"
               t-on-click.stop.prevent="this._onItemClicked(element.callback)">
                <svg t-if="element.id === 'personal_profile'" class="tp-profile-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M20 21a8 8 0 0 0-16 0"/></svg>
                <svg t-elif="element.id === 'account_security'" class="tp-profile-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 3 7v5c0 5 9 9 9 9s9-4 9-9V7z"/></svg>
                <svg t-elif="element.id === 'logout'" class="tp-logout-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>
                <span t-out="element.description"/>
            </a>
        </xpath>
    </t>
</templates>
