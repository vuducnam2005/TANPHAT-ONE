<templates xml:space="preserve">
    <t t-name="tp_web_home.InlineErrors">
        <t t-set="errors" t-value="this.props.errors"/>
        <t t-set="server" t-value="this.props.server"/>
        <section t-if="errors.length or server" class="tp_validation_summary" role="alert" t-ref="this.section"
            t-att-data-attempt="this.props.attempt">
            <t t-call="tp_web_home.ValidationSummaryBody"/>
        </section>
    </t>
</templates>
