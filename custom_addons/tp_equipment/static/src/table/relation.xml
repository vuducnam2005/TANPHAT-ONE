<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="tp_equipment.RelationField" t-inherit="web.X2ManyField" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_x2m_control_panel')]" position="inside">
            <div t-if="this.enabled" class="d-flex flex-wrap align-items-center gap-2 p-2 w-100">
                <button type="button" class="btn btn-outline-primary" t-att-disabled="this.blocked or !this.relationDomain" t-on-click="() => this.filterAll()">Tìm / lọc toàn bộ bảng</button>
                <label class="d-flex align-items-center gap-1 text-nowrap flex-nowrap">Hiển thị <select class="form-select" aria-label="Số dòng bảng con" t-att-disabled="this.blocked" t-on-change="(ev) => this.changeSize(ev)">
                    <option t-foreach="this.pageSizes" t-as="n" t-key="n" t-att-value="n" t-att-selected="n === this.list.limit" t-out="n"/>
                </select> dòng mỗi trang</label>
                <span t-if="this.blocked" class="text-muted">Lưu hoặc hủy thay đổi để lọc bảng này</span>
                <span t-elif="!this.relationDomain" class="text-muted">Chưa có đủ ID đã lưu để mở bộ lọc</span>
                <span t-else="" class="text-muted" t-out="this.list.count + ' bản ghi liên quan'"/>
            </div>
        </xpath>
    </t>
    <t t-name="tp_equipment.RelationDialog">
        <Dialog title="this.props.title" size="'xl'" bodyClass="'tp_eq_relation_dialog'">
            <View t-props="this.props.viewProps"/>
            <t t-set-slot="footer"><button type="button" class="btn btn-secondary" t-on-click="this.props.close">Đóng</button></t>
        </Dialog>
    </t>
</templates>
