<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="tp_equipment.CompactFilterBar">
        <div t-ref="this.rootRef" class="tp_filter_bar tp_eq_compact_filter tp_eq_drawer_anchor" role="search"
             aria-label="Thanh công cụ lọc bảng" t-on-keydown="(ev) => this.onBarKeyDown(ev)">
            <!-- Single-row compact toolbar -->
            <div class="tp_eq_cf_row">
                <!-- 2 context-relevant quick filters -->
                <t t-foreach="this.inlineCriteria" t-as="crit" t-key="crit.key">
                    <div class="tp_eq_cf_quick_item">
                        <span class="tp_eq_cf_quick_lbl"><t t-out="crit.label"/></span>

                        <div t-if="crit.type === 'many2one'" class="tp_filter_m2o_wrap tp_eq_cf_ctrl">
                            <AutoComplete
                                id="'eq_cf_q_' + crit.key"
                                value="this.state.m2oInputs[crit.key] || ''"
                                placeholder="'Tất cả'"
                                sources="this.m2oSources(crit)"
                                onInput="(args) => this.onM2oInput(args, crit)"
                                autoSelect="true"
                                resetOnSelect="false"
                                dropdownClass="'tp_filter_m2o_menu'"/>
                            <button t-if="this.state.pending[crit.key] or this.state.m2oInputs[crit.key]"
                                    type="button" class="tp_filter_m2o_clear" title="Xóa chọn"
                                    t-on-click="() => this.clearM2o(crit)">×</button>
                        </div>

                        <select t-elif="crit.type === 'boolean'"
                                class="form-select form-select-sm tp_eq_cf_ctrl"
                                t-att-disabled="this.blocked"
                                t-att-value="this.state.pending[crit.key] || 'all'"
                                t-on-change="(ev) => this.setSingleValue(crit, ev.target.value)">
                            <option value="all">Tất cả</option>
                            <option value="yes">Có</option>
                            <option value="no">Không</option>
                        </select>

                        <select t-elif="(crit.type === 'selection' or crit.type === 'preset') and crit.multi === false"
                                class="form-select form-select-sm tp_eq_cf_ctrl"
                                t-att-disabled="this.blocked"
                                t-att-value="this.state.pending[crit.key] || ''"
                                t-on-change="(ev) => this.setSingleValue(crit, ev.target.value)">
                            <option value="">Tất cả</option>
                            <t t-if="crit.type === 'preset'">
                                <option t-foreach="crit.options" t-as="opt" t-key="opt.key"
                                        t-att-value="opt.key" t-out="opt.label"/>
                            </t>
                            <t t-else="">
                                <option t-foreach="crit.options" t-as="opt" t-key="opt[0]"
                                        t-att-value="opt[0]" t-out="opt[1]"/>
                            </t>
                        </select>

                        <div t-elif="crit.type === 'selection' or crit.type === 'preset'" class="tp_filter_multi_wrap tp_eq_cf_ctrl">
                            <button type="button" class="tp_filter_multi_btn tp_eq_cf_multi_btn"
                                    t-att-class="{ 'has-selection': (this.state.pending[crit.key] || []).length > 0 }"
                                    aria-haspopup="listbox"
                                    t-att-aria-expanded="this.state.openPopoverKey === crit.key ? 'true' : 'false'"
                                    t-att-disabled="this.blocked"
                                    t-on-click="() => this.togglePopover(crit.key)">
                                <span class="tp_filter_multi_text" t-out="this.multiSummaryLabel(crit)"/>
                                <span class="tp_filter_caret" aria-hidden="true">▾</span>
                            </button>
                            <div t-if="this.state.openPopoverKey === crit.key" class="tp_filter_popover" role="listbox">
                                <label t-if="crit.allowEmpty" class="tp_filter_opt">
                                    <input type="checkbox"
                                           t-att-checked="this.isOptionSelected(crit.key, '__false__')"
                                           t-on-change="() => this.toggleMultiOption(crit, '__false__')"/>
                                    <span>Chưa khai báo</span>
                                </label>
                                <t t-if="crit.type === 'preset'">
                                    <label t-foreach="crit.options" t-as="opt" t-key="opt.key" class="tp_filter_opt">
                                        <input type="checkbox"
                                               t-att-checked="this.isOptionSelected(crit.key, opt.key)"
                                               t-on-change="() => this.toggleMultiOption(crit, opt.key)"/>
                                        <span t-out="opt.label"/>
                                    </label>
                                </t>
                                <t t-else="">
                                    <label t-foreach="crit.options" t-as="opt" t-key="opt[0]" class="tp_filter_opt">
                                        <input type="checkbox"
                                               t-att-checked="this.isOptionSelected(crit.key, opt[0])"
                                               t-on-change="() => this.toggleMultiOption(crit, opt[0])"/>
                                        <span t-out="opt[1]"/>
                                    </label>
                                </t>
                            </div>
                        </div>
                    </div>
                </t>

                <!-- Quick Printer + Copier Toggle (equipment_main only) -->
                <button t-if="this.printerFilterItem"
                        type="button"
                        class="btn btn-sm tp_eq_cf_quick_toggle"
                        t-att-class="{ 'is-active': this.printerFilterActive }"
                        t-att-aria-pressed="this.printerFilterActive ? 'true' : 'false'"
                        t-att-disabled="this.blocked"
                        title="Lọc nhanh Máy in và Máy photocopy / đa năng"
                        t-on-click="() => this.togglePrinterFilter()">
                    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                        <path fill="currentColor" d="M4 1.5h8V4H4V1.5ZM2.5 5A1.5 1.5 0 0 0 1 6.5v4A1.5 1.5 0 0 0 2.5 12H4v2.5h8V12h1.5A1.5 1.5 0 0 0 15 10.5v-4A1.5 1.5 0 0 0 13.5 5h-11ZM5.5 13V9.5h5V13h-5Zm6.25-6a.75.75 0 1 1 0 1.5.75.75 0 0 1 0-1.5Z"/>
                    </svg>
                    <span>Máy in</span>
                </button>

                <!-- Filter Drawer Trigger -->
                <button t-if="this.drawerCriteria.length or this.quickFilters.length"
                        type="button"
                        class="btn btn-sm tp_eq_cf_drawer_btn"
                        t-att-class="{ 'is-open': this.ui.drawerOpen, 'has-active': this.drawerBadgeCount > 0 }"
                        t-att-aria-expanded="this.ui.drawerOpen ? 'true' : 'false'"
                        t-att-disabled="this.blocked"
                        t-on-click="() => this.toggleDrawer()">
                    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                        <path fill="currentColor" d="M1.5 3h13v1.5l-4.75 4.75v4.25l-3.5-1.75v-2.5L1.5 4.5V3z"/>
                    </svg>
                    <span t-out="this.drawerButtonLabel"/>
                </button>

                <!-- Primary Toolbar Actions -->
                <div class="tp_eq_cf_actions">
                    <button type="button" class="btn btn-sm tp_eq_cf_apply"
                            t-att-disabled="this.blocked or this.state.busy or this.validationErrors.length > 0 or !this.hasPendingChanges"
                            t-on-click="() => this.applyFilters()">
                        <span t-if="this.state.busy">Đang lọc…</span>
                        <span t-else="">Áp dụng</span>
                    </button>
                    <button t-if="this.hasAnyValue"
                            type="button" class="btn btn-sm tp_eq_cf_clear"
                            t-att-disabled="this.blocked or this.state.busy"
                            t-on-click="() => this.clearAllFilters()">Xóa lọc</button>
                    <span t-if="this.hasPendingChanges" class="tp_eq_cf_pending" role="status">Chưa áp dụng</span>
                    <span t-if="this.resultCountText" class="tp_eq_cf_count" t-out="this.resultCountText"/>
                </div>
            </div>

            <!-- Collapsible Filter Popover / Drawer for remaining criteria & scopes -->
            <div t-if="this.ui.drawerOpen" class="tp_eq_cf_drawer" role="dialog" aria-label="Bộ lọc chi tiết">
                <div class="tp_eq_cf_drawer_head">
                    <strong>Tiêu chí lọc mở rộng</strong>
                    <button type="button" class="btn-close" aria-label="Đóng" t-on-click="() => this.closeDrawer()"/>
                </div>

                <!-- Preset scopes (Chưa ngừng quản lý, Đang sử dụng, Cần kiểm tra...) -->
                <div t-if="this.quickFilters.length" class="tp_eq_cf_presets">
                    <span class="tp_eq_cf_sec_lbl">Phạm vi nhanh:</span>
                    <div class="tp_eq_cf_preset_list">
                        <button t-foreach="this.quickFilters" t-as="item" t-key="item.id" type="button"
                                class="tp_eq_cf_preset_pill"
                                t-att-class="{ 'is-active': item.isActive }"
                                t-att-aria-pressed="item.isActive ? 'true' : 'false'"
                                t-att-disabled="this.blocked"
                                t-on-click="() => this.toggleQuickFilter(item)"
                                t-out="item.description"/>
                    </div>
                </div>

                <!-- Secondary Criteria Grid -->
                <div t-if="this.drawerCriteria.length" class="tp_eq_cf_drawer_grid">
                    <div t-foreach="this.drawerCriteria" t-as="crit" t-key="crit.key" class="tp_eq_cf_field">
                        <label t-att-for="'eq_cfd_' + crit.key" t-out="crit.label"/>

                        <input t-if="crit.type === 'char'"
                               type="text"
                               t-att-id="'eq_cfd_' + crit.key"
                               class="form-control form-control-sm"
                               t-att-placeholder="crit.placeholder || 'Nhập từ khóa…'"
                               t-att-disabled="this.blocked"
                               t-att-value="this.state.pending[crit.key] || ''"
                               t-on-input="(ev) => this.setSingleValue(crit, ev.target.value)"
                               t-on-keydown="(ev) => this.onTextKeyDown(ev)"/>

                        <select t-elif="crit.type === 'boolean'"
                                t-att-id="'eq_cfd_' + crit.key"
                                class="form-select form-select-sm"
                                t-att-disabled="this.blocked"
                                t-att-value="this.state.pending[crit.key] || 'all'"
                                t-on-change="(ev) => this.setSingleValue(crit, ev.target.value)">
                            <option value="all">Tất cả</option>
                            <option value="yes">Có</option>
                            <option value="no">Không</option>
                        </select>

                        <select t-elif="(crit.type === 'selection' or crit.type === 'preset') and crit.multi === false"
                                t-att-id="'eq_cfd_' + crit.key"
                                class="form-select form-select-sm"
                                t-att-disabled="this.blocked"
                                t-att-value="this.state.pending[crit.key] || ''"
                                t-on-change="(ev) => this.setSingleValue(crit, ev.target.value)">
                            <option value="">Tất cả</option>
                            <t t-if="crit.type === 'preset'">
                                <option t-foreach="crit.options" t-as="opt" t-key="opt.key"
                                        t-att-value="opt.key" t-out="opt.label"/>
                            </t>
                            <t t-else="">
                                <option t-foreach="crit.options" t-as="opt" t-key="opt[0]"
                                        t-att-value="opt[0]" t-out="opt[1]"/>
                            </t>
                        </select>

                        <div t-elif="crit.type === 'selection' or crit.type === 'preset'" class="tp_filter_multi_wrap">
                            <button type="button" class="tp_filter_multi_btn"
                                    t-att-class="{ 'has-selection': (this.state.pending[crit.key] || []).length > 0 }"
                                    aria-haspopup="listbox"
                                    t-att-aria-expanded="this.state.openPopoverKey === crit.key ? 'true' : 'false'"
                                    t-att-disabled="this.blocked"
                                    t-on-click="() => this.togglePopover(crit.key)">
                                <span class="tp_filter_multi_text" t-out="this.multiSummaryLabel(crit)"/>
                                <span class="tp_filter_caret" aria-hidden="true">▾</span>
                            </button>
                            <div t-if="this.state.openPopoverKey === crit.key" class="tp_filter_popover" role="listbox">
                                <label t-if="crit.allowEmpty" class="tp_filter_opt">
                                    <input type="checkbox"
                                           t-att-checked="this.isOptionSelected(crit.key, '__false__')"
                                           t-on-change="() => this.toggleMultiOption(crit, '__false__')"/>
                                    <span>Chưa khai báo</span>
                                </label>
                                <t t-if="crit.type === 'preset'">
                                    <label t-foreach="crit.options" t-as="opt" t-key="opt.key" class="tp_filter_opt">
                                        <input type="checkbox"
                                               t-att-checked="this.isOptionSelected(crit.key, opt.key)"
                                               t-on-change="() => this.toggleMultiOption(crit, opt.key)"/>
                                        <span t-out="opt.label"/>
                                    </label>
                                </t>
                                <t t-else="">
                                    <label t-foreach="crit.options" t-as="opt" t-key="opt[0]" class="tp_filter_opt">
                                        <input type="checkbox"
                                               t-att-checked="this.isOptionSelected(crit.key, opt[0])"
                                               t-on-change="() => this.toggleMultiOption(crit, opt[0])"/>
                                        <span t-out="opt[1]"/>
                                    </label>
                                </t>
                            </div>
                        </div>

                        <div t-elif="crit.type === 'many2one'" class="tp_filter_m2o_wrap">
                            <AutoComplete
                                id="'eq_cfd_' + crit.key"
                                value="this.state.m2oInputs[crit.key] || ''"
                                placeholder="'Tìm &amp; chọn…'"
                                sources="this.m2oSources(crit)"
                                onInput="(args) => this.onM2oInput(args, crit)"
                                autoSelect="true"
                                resetOnSelect="false"
                                dropdownClass="'tp_filter_m2o_menu'"/>
                            <button t-if="this.state.pending[crit.key] or this.state.m2oInputs[crit.key]"
                                    type="button" class="tp_filter_m2o_clear" title="Xóa chọn"
                                    t-on-click="() => this.clearM2o(crit)">×</button>
                        </div>

                        <div t-elif="crit.type === 'date' or crit.type === 'datetime'" class="tp_filter_date_pair">
                            <input type="date" class="form-control form-control-sm"
                                   t-att-disabled="this.blocked"
                                   t-att-value="this.state.pending[crit.key]?.from || ''"
                                   t-on-input="(ev) => this.setDateBound(crit, 'from', ev.target.value)"
                                   t-on-change="(ev) => this.setDateBound(crit, 'from', ev.target.value)"/>
                            <span class="tp_filter_date_sep">→</span>
                            <input type="date" class="form-control form-control-sm"
                                   t-att-disabled="this.blocked"
                                   t-att-value="this.state.pending[crit.key]?.to || ''"
                                   t-on-input="(ev) => this.setDateBound(crit, 'to', ev.target.value)"
                                   t-on-change="(ev) => this.setDateBound(crit, 'to', ev.target.value)"/>
                        </div>
                    </div>
                </div>

                <div class="tp_eq_cf_drawer_foot">
                    <button type="button" class="btn btn-sm btn-link px-0"
                            t-att-disabled="this.blocked"
                            t-on-click="() => this.openAdvanced()">Bộ lọc nâng cao (Odoo)</button>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-sm tp_eq_cf_clear"
                                t-att-disabled="this.blocked or !this.hasAnyValue"
                                t-on-click="() => this.clearAllFilters()">Đặt lại</button>
                        <button type="button" class="btn btn-sm tp_eq_cf_apply"
                                t-att-disabled="this.blocked or this.state.busy or this.validationErrors.length > 0"
                                t-on-click="() => this.applyAndClose()">Áp dụng bộ lọc</button>
                    </div>
                </div>
            </div>

            <!-- Validation / RPC Error Banner -->
            <div t-if="this.validationErrors.length or this.state.error" class="tp_filter_alert mt-2" role="alert">
                <span t-out="this.validationErrors[0] || this.state.error"/>
                <button t-if="this.state.error and !this.validationErrors.length" type="button"
                        class="btn btn-sm btn-link" t-on-click="() => this.applyFilters()">Thử lại</button>
            </div>

            <!-- Active Applied Filter Chips Row (only shown when user applied filters) -->
            <div t-if="this.activeFacets.length" class="tp_filter_chips mt-2" aria-label="Bộ lọc đang áp dụng">
                <span t-foreach="this.activeFacets" t-as="facet" t-key="facet.groupId" class="tp_filter_chip">
                    <strong t-if="facet.title" class="me-1" t-out="facet.title + ':'"/>
                    <span class="tp_filter_chip_txt" t-out="(facet.values and facet.values.length) ? facet.values.join(', ') : (facet.description || 'Đang lọc')"/>
                    <button type="button" class="tp_filter_chip_remove" title="Bỏ bộ lọc này"
                            t-att-disabled="this.blocked" t-on-click="() => this.removeFacet(facet)">×</button>
                </span>
            </div>
        </div>
    </t>
</templates>
