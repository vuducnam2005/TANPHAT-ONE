<?xml version='1.0' encoding='utf8'?>
<odoo>
    <record id="receipt_list" model="ir.ui.view">
        <field name="name">tp.equipment.receipt.list</field>
        <field name="model">tp.equipment.receipt</field>
        <field name="arch" type="xml">
            <list string="Phiếu nhập thiết bị" js_class="tp_equipment_table" class="tp_eq_table" limit="20" decoration-muted="state == 'cancel'">
                <field name="name" string="Số phiếu" class="tp_eq_strong"/>
                <field name="date" string="Ngày nhập"/>
                <field name="source" string="Nguồn nhập"/>
                <field name="supplier_id" string="Nhà cung cấp / bên giao" optional="show"/>
                <field name="document_ref" string="Số chứng từ" optional="show"/>
                <field name="location_id" string="Vị trí nhập" optional="hide"/>
                <field name="line_count" string="Số TB"/>
                <field name="state" string="Trạng thái" widget="badge" decoration-muted="state in ('draft', 'cancel')" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="receipt_search" model="ir.ui.view">
        <field name="name">tp.equipment.receipt.search</field>
        <field name="model">tp.equipment.receipt</field>
        <field name="arch" type="xml">
            <search string="Tìm phiếu nhập">
                <field name="name" string="Số phiếu"/>
                <field name="document_ref" string="Số chứng từ"/>
                <field name="supplier_id" string="Nhà cung cấp"/>
                <field name="line_ids" string="Thiết bị / serial" filter_domain="['|', ('line_ids.name', 'ilike', self), ('line_ids.serial_no', 'ilike', self)]"/>
                <field name="source"/>
                <field name="state"/>
                <field name="date"/>
                <filter name="q_draft" string="Nháp" domain="[('state', '=', 'draft')]"/>
                <filter name="q_done" string="Đã nhập kho" domain="[('state', '=', 'done')]"/>
                <filter name="q_no_document" string="Chưa có số chứng từ" domain="[('document_ref', '=', False)]"/>
                <filter name="q_rental" string="Thiết bị thuê" domain="[('source', '=', 'rental')]"/>
                <separator/>
                <filter name="cancelled" string="Đã hủy" domain="[('state', '=', 'cancel')]"/>
                <group>
                    <filter name="group_source" string="Nguồn nhập" context="{'group_by': 'source'}"/>
                    <filter name="group_supplier" string="Nhà cung cấp" context="{'group_by': 'supplier_id'}"/>
                    <filter name="group_date" string="Tháng nhập" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="receipt_form" model="ir.ui.view">
        <field name="name">tp.equipment.receipt.form</field>
        <field name="model">tp.equipment.receipt</field>
        <field name="arch" type="xml">
            <form string="Phiếu nhập thiết bị" class="tp_eq_form">
                <header>
                    <button name="action_done" type="object" string="Nhập kho" class="btn-primary" invisible="state != 'draft' or not id" confirm="Tạo hồ sơ và đăng ký từng thiết bị trên phiếu vào kho? Phiếu đã nhập không sửa được."/>
                    <button name="action_cancel" type="object" string="Hủy phiếu" invisible="state != 'draft' or not id"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_equipment" type="object" class="oe_stat_button" icon="widgets" invisible="not equipment_count">
                            <field name="equipment_count" widget="statinfo" string="Thiết bị đã tạo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <div class="o_tp_eq_code" invisible="name == '/' or not name"><field name="name" readonly="1"/></div>
                        <h1>Phiếu nhập thiết bị</h1>
                    </div>
                    <group>
                        <group string="Nguồn">
                            <field name="source" readonly="state != 'draft'"/>
                            <field name="supplier_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="document_ref" readonly="state != 'draft'"/>
                        </group>
                        <group string="Nhập kho">
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="location_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="done_date" invisible="state != 'done'"/>
                            <field name="done_by_id" invisible="state != 'done'"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <p class="o_tp_eq_note">
                        Mỗi dòng là một thiết bị thật (không nhập số lượng gộp). “Tình trạng khi nhận” bắt buộc chọn
                        sau khi kiểm tra; giá trị để trống khi chưa có chứng từ. Không ghi nhận công nợ, thanh toán hay khấu hao.
                    </p>
                    <notebook>
                        <page name="lines" string="Thiết bị nhập">
                            <field name="line_ids" readonly="state != 'draft'" nolabel="1" widget="tp_equipment_relation">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="proposal_line_id" optional="show" options="{'no_create': True}"/>
                                    <field name="category_id" options="{'no_create': True}"/>
                                    <field name="name"/>
                                    <field name="brand" optional="show"/>
                                    <field name="model" optional="show"/>
                                    <field name="serial_no" optional="show"/>
                                    <field name="technical_state"/>
                                    <field name="asset_class" optional="hide"/>
                                    <field name="cpu" optional="hide"/>
                                    <field name="ram" optional="hide"/>
                                    <field name="storage" optional="hide"/>
                                    <field name="config_note" optional="hide"/>
                                    <field name="accessories" optional="hide"/>
                                    <field name="ownership" optional="hide"/>
                                    <field name="owner_partner_id" optional="hide" options="{'no_create': True}"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="purchase_value_known" optional="show"/>
                                    <field name="purchase_value" optional="show" invisible="not purchase_value_known"/>
                                    <field name="warranty_basis" optional="show"/>
                                    <field name="warranty_months" optional="show"/>
                                    <field name="warranty_start" optional="hide"/>
                                    <field name="warranty_date" optional="hide"/>
                                    <field name="warranty_meter_limit" optional="hide"/>
                                    <field name="note" optional="hide"/>
                                    <field name="equipment_id" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page name="note" string="Ghi chú">
                            <field name="note" nolabel="1" placeholder="Ghi chú giao nhận, tình trạng bao bì…"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_receipts" model="ir.actions.act_window">
        <field name="name">Phiếu nhập thiết bị</field>
        <field name="res_model">tp.equipment.receipt</field>
        <field name="path">phieu-nhap-thiet-bi</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="receipt_search"/>
        <field name="context">{'tp_filter_profile': 'receipt', 'tp_eq_leaf': 'tp_equipment.menu_receipts'}</field>
        <field name="group_ids" eval="[Command.set([ref('base.group_system')])]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Chưa có phiếu nhập nào</p>
            <p>Thiết bị mua mới, thuê hoặc nhận về: lập phiếu nhập, mỗi dòng một thiết bị, kiểm tra tình trạng rồi bấm “Nhập kho”.</p>
        </field>
    </record>

    <record id="action_scan" model="ir.actions.client">
        <field name="name">Quét mã thiết bị</field>
        <field name="tag">tp_equipment.scan</field>
        <field name="path">quet-ma-thiet-bi</field>
        <field name="context">{'tp_eq_leaf': 'tp_equipment.menu_scan'}</field>
    </record>
</odoo>
