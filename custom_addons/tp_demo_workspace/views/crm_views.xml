<odoo>
    <!-- Opportunity views limited to fields readable without sales groups
         (crm.tag needs a salesman group and is left out). -->
    <record id="view_demo_lead_kanban" model="ir.ui.view">
        <field name="name">crm.lead.tp_demo.kanban</field>
        <field name="model">crm.lead</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <kanban create="0" edit="0" delete="0" default_group_by="stage_id" records_draggable="0" quick_create="0"
                    group_create="0" group_delete="0" group_edit="0" archivable="0" class="o_tp_demo_native">
                <field name="company_currency"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold"/>
                        <field name="partner_id" class="text-muted small"/>
                        <field name="expected_revenue" widget="monetary" options="{'currency_field': 'company_currency'}"/>
                        <footer class="pt-1">
                            <field name="date_deadline" class="small text-muted"/>
                            <field name="user_id" widget="many2one_avatar_user" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="view_demo_lead_list" model="ir.ui.view">
        <field name="name">crm.lead.tp_demo.list</field>
        <field name="model">crm.lead</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" class="o_tp_demo_native">
                <field name="name" string="Cơ hội"/>
                <field name="partner_id" string="Khách hàng"/>
                <field name="stage_id" string="Giai đoạn"/>
                <field name="user_id" string="Phụ trách" widget="many2one_avatar_user"/>
                <field name="date_deadline" string="Dự kiến chốt"/>
                <field name="company_currency" column_invisible="1"/>
                <field name="expected_revenue" string="Giá trị kỳ vọng" widget="monetary" options="{'currency_field': 'company_currency'}"/>
                <field name="probability" string="Xác suất (%)"/>
            </list>
        </field>
    </record>
    <record id="view_demo_lead_form" model="ir.ui.view">
        <field name="name">crm.lead.tp_demo.form</field>
        <field name="model">crm.lead</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0" duplicate="0" class="o_tp_demo_native">
                <header>
                    <field name="stage_id" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" string="Khách hàng" readonly="1"/>
                            <field name="user_id" string="Phụ trách" readonly="1" widget="many2one_avatar_user"/>
                            <field name="team_id" string="Nhóm kinh doanh" readonly="1"/>
                        </group>
                        <group>
                            <field name="company_currency" invisible="1"/>
                            <field name="expected_revenue" string="Giá trị kỳ vọng" readonly="1" widget="monetary" options="{'currency_field': 'company_currency'}"/>
                            <field name="probability" string="Xác suất (%)" readonly="1"/>
                            <field name="date_deadline" string="Dự kiến chốt" readonly="1"/>
                        </group>
                    </group>
                    <field name="description" readonly="1"/>
                    <p class="text-muted small">Chưa có liên kết dữ liệu cơ hội → gói thầu → hợp đồng; liên hệ với dự án trên dashboard chỉ là minh họa theo cùng khách hàng.</p>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_demo_lead_search" model="ir.ui.view">
        <field name="name">crm.lead.tp_demo.search</field>
        <field name="model">crm.lead</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Cơ hội"/>
                <field name="partner_id" string="Khách hàng"/>
                <group>
                    <filter name="group_stage" string="Giai đoạn" context="{'group_by': 'stage_id'}"/>
                    <filter name="group_partner" string="Khách hàng" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_demo_crm" model="ir.actions.act_window">
        <field name="name">Cơ hội kinh doanh</field>
        <field name="res_model">crm.lead</field>
        <field name="path">tp-demo-crm</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('type', '=', 'opportunity')]</field>
        <field name="context">{'default_type': 'opportunity'}</field>
        <field name="search_view_id" ref="view_demo_lead_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_demo_lead_kanban')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_demo_lead_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_demo_lead_form')})]"/>
    </record>
</odoo>
