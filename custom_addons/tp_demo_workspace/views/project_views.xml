<odoo>
    <record id="view_demo_project_list" model="ir.ui.view">
        <field name="name">project.project.tp_demo.list</field>
        <field name="model">project.project</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" class="o_tp_demo_native">
                <field name="tp_code" string="Mã dự án"/>
                <field name="name" string="Tên dự án"/>
                <field name="partner_id" string="Khách hàng"/>
                <field name="tp_department_id" string="Phòng chủ trì"/>
                <field name="user_id" string="Chủ nhiệm" widget="many2one_avatar_user"/>
                <field name="date_start" string="Bắt đầu"/>
                <field name="date" string="Kết thúc"/>
                <field name="task_count" string="Công việc"/>
            </list>
        </field>
    </record>
    <record id="view_demo_project_kanban" model="ir.ui.view">
        <field name="name">project.project.tp_demo.kanban</field>
        <field name="model">project.project</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <kanban create="0" edit="0" delete="0" class="o_tp_demo_native">
                <field name="tp_code"/>
                <templates>
                    <t t-name="card">
                        <span class="text-muted small"><field name="tp_code"/></span>
                        <field name="name" class="fw-bold fs-5"/>
                        <field name="partner_id" class="text-muted"/>
                        <field name="tp_department_id" class="text-muted small"/>
                        <footer class="pt-1">
                            <span class="small"><field name="task_count"/> công việc</span>
                            <field name="user_id" widget="many2one_avatar_user" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="view_demo_project_form" model="ir.ui.view">
        <field name="name">project.project.tp_demo.form</field>
        <field name="model">project.project</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0" duplicate="0" class="o_tp_demo_native">
                <header>
                    <button name="%(tp_demo_workspace.action_demo_project_overview)d" type="action" string="Mở tổng quan dự án" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="text-muted"><field name="tp_code" readonly="1"/></span>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" string="Khách hàng" readonly="1"/>
                            <field name="tp_department_id" string="Phòng chủ trì" readonly="1"/>
                            <field name="user_id" string="Chủ nhiệm" readonly="1" widget="many2one_avatar_user"/>
                        </group>
                        <group>
                            <field name="date_start" string="Bắt đầu" readonly="1"/>
                            <field name="date" string="Kết thúc" readonly="1"/>
                            <field name="company_id" string="Công ty" readonly="1"/>
                        </group>
                    </group>
                    <field name="description" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_demo_project_search" model="ir.ui.view">
        <field name="name">project.project.tp_demo.search</field>
        <field name="model">project.project</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Dự án" filter_domain="['|', ('name', 'ilike', self), ('tp_code', 'ilike', self)]"/>
                <field name="partner_id" string="Khách hàng"/>
                <field name="tp_department_id" string="Phòng chủ trì"/>
                <group>
                    <filter name="group_department" string="Phòng chủ trì" context="{'group_by': 'tp_department_id'}"/>
                    <filter name="group_partner" string="Khách hàng" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_demo_projects" model="ir.actions.act_window">
        <field name="name">Dự án</field>
        <field name="res_model">project.project</field>
        <field name="path">tp-demo-projects</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('tp_managed', '=', True), ('tp_code', '=like', 'DEMO-%')]</field>
        <field name="search_view_id" ref="view_demo_project_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_demo_project_kanban')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_demo_project_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_demo_project_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">Chưa có dự án DEMO nào bạn được giao.</p>
        </field>
    </record>
</odoo>
