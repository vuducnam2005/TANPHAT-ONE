<odoo>
    <record id="privilege_demo" model="res.groups.privilege">
        <field name="name">TANPHAT ONE – Demo</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>
    <!-- Demo groups only open the workspace menus and the read projection.
         Data scope still comes from tp_core/tp_project/tp_contract rules. -->
    <record id="group_demo_viewer" model="res.groups">
        <field name="name">Demo Viewer</field>
        <field name="privilege_id" ref="privilege_demo"/>
        <field name="implied_ids" eval="[(4, ref('tp_core.group_user'))]"/>
    </record>
    <record id="group_demo_business" model="res.groups">
        <field name="name">Demo Business Viewer</field>
        <field name="privilege_id" ref="privilege_demo"/>
        <field name="implied_ids" eval="[(4, ref('group_demo_viewer'))]"/>
    </record>
</odoo>
