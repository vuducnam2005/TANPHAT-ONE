<odoo>
    <record id="view_tp_project_list" model="ir.ui.view">
        <field name="name">project.project.tanphat.list</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <list><field name="tp_code"/><field name="name"/><field name="company_id"/><field name="tp_department_id"/><field name="partner_id"/></list>
        </field>
    </record>
    <record id="view_tp_project_form" model="ir.ui.view">
        <field name="name">project.project.tanphat.form</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group><field name="tp_managed"/><field name="tp_code" required="tp_managed"/><field name="name"/><field name="company_id" required="tp_managed"/><field name="tp_department_id"/><field name="partner_id"/></group>
                    <notebook><page string="Assignments" groups="tp_core.group_manager"><field name="tp_assignment_ids"><list editable="bottom"><field name="user_id"/><field name="role"/><field name="active"/></list></field></page></notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_tp_projects" model="ir.actions.act_window">
        <field name="name">TP Projects</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_tp_project_list"/>
        <field name="domain">[('tp_managed', '=', True)]</field>
        <field name="context">{'default_tp_managed': True, 'form_view_ref': 'tp_project.view_tp_project_form'}</field>
    </record>
    <menuitem id="menu_tp_projects" name="TP Projects" parent="tp_core.menu_platform" action="action_tp_projects" sequence="10"/>
</odoo>
